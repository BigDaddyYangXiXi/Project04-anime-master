.profile-shell { padding: var(--am-space-6) var(--am-space-4) calc(var(--am-nav-bottom-content) + var(--am-status-action-height) + var(--am-space-6) + env(safe-area-inset-bottom)); }
.section-card { margin-bottom: var(--am-space-3); border: var(--am-border-none); border-radius: var(--am-radius-card); background: var(--am-color-surface); overflow: hidden; }
.profile-hero { padding: var(--am-space-4) var(--am-space-none); background: var(--am-color-canvas); }
.identity-row { display: grid; grid-template-columns: var(--am-avatar-detail-author) minmax(0,1fr); gap: var(--am-space-3); align-items: center; }
.avatar-large { display: flex; width: var(--am-avatar-detail-author); height: var(--am-avatar-detail-author); align-items: center; justify-content: center; border: var(--am-border-none); border-radius: 50%; color: var(--am-color-on-brand); background: var(--am-color-brand); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.avatar-image{display: block}
.identity-copy { min-width: 0; }
.identity-copy > text { display: block; margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.identity-heading { display: flex; align-items: center; gap: 12rpx; }
.identity-heading text:first-child { color: var(--am-color-text); font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-page-title); }.trust-row { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: var(--am-space-1); border-top: 1rpx solid var(--am-color-border); border-bottom: 1rpx solid var(--am-color-border); }
.trust-row view { padding: 14rpx 8rpx; text-align: center; }
.trust-row view + view { border-left: 1rpx solid var(--am-color-border); }
.trust-row text { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 28rpx; }
.trust-row text:first-child { color: var(--am-color-text); font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); line-height: 38rpx; }
.profile-bio { display: block; margin-top: var(--am-space-4); color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); }
.tag-row { display: flex; flex-wrap: wrap; gap: var(--am-space-1); margin-top: var(--am-space-3); }
.tag-row text { padding: var(--am-space-none) var(--am-space-2); border-radius: var(--am-radius-tag); color: var(--am-color-text-secondary); background: var(--am-color-control-surface); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.section-card { padding: var(--am-detail-card-padding);  border: var(--am-work-rule); border-radius: var(--am-radius-control); margin-bottom: var(--am-detail-section-gap);}
.section-title { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); margin-bottom: var(--am-space-4); }
.compact-title{margin-bottom: var(--am-space-1)}
.section-title > view text { display: block; }
.section-title > view text:first-child, .card-title { color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.section-title > view text:last-child, .section-title > text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.schedule-link { min-height: 88rpx; padding: var(--am-space-none) var(--am-space-1); color: var(--am-color-brand); background: transparent; box-shadow: none; font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); }

.work-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: var(--am-space-2); align-items: start; }
.sticky-action { position: fixed; z-index: 20; right: 0; left: 0; bottom: calc(var(--am-nav-bottom-content) + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: var(--am-space-3); padding: var(--am-booking-person-gap) var(--am-space-4); border-top: var(--am-work-rule); background: var(--am-color-canvas); }
.sticky-action > view { display: flex; flex: 1; flex-direction: column; }
.sticky-action text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 28rpx; }
.sticky-action text:last-child { color: var(--am-color-price); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-body); }
.sticky-action button { display: flex; width: 220rpx;  align-items: center; justify-content: center;        }


@import "../../styles/money.wxss";

@import "../../styles/creator-profile.wxss";

@import "../../styles/publication-stage.wxss";

.storefront-cover { display:block; width:100%; border-radius:var(--am-radius-card); margin-bottom:var(--am-space-3); }
.storefront-section-head { display:flex; align-items:center; justify-content:space-between; gap:var(--am-space-3); margin:var(--am-space-4) var(--am-space-none) var(--am-space-2); }
.storefront-section-head > text:first-child { font-size:var(--am-type-section-title); line-height:var(--am-line-section-title); font-weight:var(--am-weight-semibold); }
.storefront-section-head > text:last-child { font-size:var(--am-type-caption); color:var(--am-color-text-secondary); }
.storefront-section-head button { width:auto; margin:var(--am-space-none); }

@import "../../styles/storefront-editor.wxss";
.storefront-result, .storefront-preview { padding-bottom:calc(var(--am-touch-min) + var(--am-space-8) + env(safe-area-inset-bottom)); }
.storefront-result-heading { padding:var(--am-space-8) var(--am-space-none) var(--am-space-6); text-align:center; }
.storefront-result-expression { display:block; width:calc(var(--am-space-6) * 3); height:calc(var(--am-space-6) * 3); margin:var(--am-space-none) auto var(--am-space-4); }
.storefront-result-title { display:block; font-size:var(--am-type-page-title); line-height:var(--am-line-page-title); font-weight:var(--am-weight-semibold); }
.storefront-timeline { margin:var(--am-space-8) var(--am-space-none); }
.storefront-timeline > view { padding:var(--am-space-4) var(--am-space-none) var(--am-space-4) var(--am-space-4); border-left:var(--am-border-control); color:var(--am-color-text-secondary); }
.storefront-timeline text { display:block; font-size:var(--am-type-body); line-height:var(--am-line-body); }
.storefront-timeline text + text { font-size:var(--am-type-caption); line-height:var(--am-line-caption); margin-top:var(--am-space-2); }
.storefront-timeline .current { color:var(--am-color-text); border-color:var(--am-color-brand); }
.storefront-timeline .done { color:var(--am-color-success); }
.storefront-preview-note { display:block; margin-bottom:var(--am-space-6); font-size:var(--am-type-caption); line-height:var(--am-line-caption); color:var(--am-color-text-secondary); }
.storefront-reading { display:block; margin-top:var(--am-space-4); font-size:var(--am-type-label); line-height:var(--am-booking-line-primary); white-space:pre-wrap; }
.storefront-preview .storefront-link { font-size:var(--am-type-label); line-height:var(--am-booking-line-primary); }
.storefront-reading-group { margin-top:var(--am-space-6); }
.storefront-notice-image { width:100%; margin-top:var(--am-space-4); }
.storefront-result .two-actions, .storefront-preview .two-actions { position:fixed; bottom:0; left:0; right:0; padding:var(--am-space-3) var(--am-space-4) calc(var(--am-space-3) + env(safe-area-inset-bottom)); background:var(--am-color-canvas); border-top:var(--am-border-control); z-index:25; }
.storefront-result .two-actions button, .storefront-preview .two-actions button { width:100%; margin:var(--am-space-none); }

.storefront-timeline > view { position:relative; }
.storefront-timeline > view::before { content:""; position:absolute; left:calc(-1 * var(--am-space-1) / 2); top:var(--am-space-4); width:var(--am-space-1); height:var(--am-space-1); border-radius:var(--am-radius-avatar); background:var(--am-color-text-secondary); }
.storefront-timeline > .current::before, .storefront-timeline > .done::before { background:var(--am-color-brand); }
