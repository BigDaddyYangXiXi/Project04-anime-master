@import "../../styles/order-facts.wxss";
.detail-shell { padding: 28rpx 32rpx 72rpx; }
.page-intro { padding: 18rpx 8rpx 28rpx; }
.page-intro text { display: block; }
.page-intro text:first-child { color: #c6536b; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-intro text:nth-child(2) { margin-top: 8rpx; font-size: 48rpx; font-weight: 800; }
.page-intro text:last-child { margin-top: 8rpx; color: #6f625d; font-size: 24rpx; line-height: 1.6; }
.page-intro .where-when { display: grid; grid-template-columns: 76rpx minmax(0,1fr); gap: 14rpx; margin-top: 10rpx; }
.page-intro .where-when > text { margin: 0; color: #c6536b; font-size: 22rpx; font-weight: 700; line-height: 36rpx; }
.page-intro .where-when view text { margin: 0; color: #6f625d; font-size: 22rpx; line-height: 36rpx; }
.content-card, .progress-card { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.cooperation-card .section-title { margin-bottom: 0; }
.card-kicker { display: block; margin-bottom: 8rpx; color: #c6536b; font-size: 20rpx; font-weight: 800; line-height: 30rpx; letter-spacing: 2rpx; }
.primary-block, .secondary-block { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin-bottom: 24rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: 24rpx; font-weight: 700; }
.primary-block { border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); color: #fff; }
.notice-card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 24rpx; background: #fff9df; color: #75500f; font-size: 22rpx; line-height: 1.6; }
.required-summary { display: flex; margin-bottom: 24rpx; padding: 22rpx 24rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid #efb6b8; border-radius: 24rpx; color: #9b3542; background: #fff0f1; font-size: 22rpx; line-height: 34rpx; }.required-heading { display: flex; align-items: center; gap: 10rpx; color: #7b2633; font-weight: 800; }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d83b46; box-shadow: 0 0 0 6rpx rgba(255,255,255,.7); }
.section-title { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; }
.section-title text:first-child { font-size: 30rpx; font-weight: 800; }
.section-title text:last-child { color: #c6536b; font-size: 22rpx; font-weight: 700; }
.progress-card > text { display: block; margin-top: 18rpx; color: #6f625d; font-size: 22rpx; line-height: 1.6; }
.empty-state { padding: 120rpx 32rpx; text-align: center; font-size: 30rpx; font-weight: 800; }
brand-success-card { display: block; margin-bottom: 24rpx; }
