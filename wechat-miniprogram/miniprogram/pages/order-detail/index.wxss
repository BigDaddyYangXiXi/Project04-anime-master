@import "../../styles/order-facts.wxss";
.detail-shell { padding: var(--am-detail-nav-page-padding); }
.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6); }
.page-intro text { display: block; }
.page-intro text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); letter-spacing: 3rpx; }
.page-intro text:nth-child(2) { margin-top: var(--am-space-1); font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); }
.page-intro text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.6; }
.page-intro .where-when { display: grid; grid-template-columns: 76rpx minmax(0,1fr); gap: 14rpx; margin-top: 10rpx; }
.page-intro .where-when > text { margin: var(--am-space-none); color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); }
.page-intro .where-when view text { margin: var(--am-space-none); color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.content-card, .progress-card { margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.cooperation-card .section-title { margin-bottom: var(--am-space-none); }
.card-kicker { display: block; margin-bottom: var(--am-space-1); color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 30rpx; letter-spacing: 2rpx; }
.primary-block, .secondary-block { display: block; width: 100%; min-width: 100%; max-width: 100%;  margin-bottom: var(--am-space-3);     }
.notice-card { margin-bottom: var(--am-space-3); padding: 28rpx; border-radius: 24rpx; background: var(--am-color-warning-surface); color: var(--am-color-warning); font-size: var(--am-type-micro); line-height: 1.6; }
.required-summary { display: flex; margin-bottom: var(--am-space-3); padding: 22rpx 24rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid var(--am-color-border); border-radius: 24rpx; color: var(--am-color-danger); background: var(--am-color-danger-surface); font-size: var(--am-type-micro); line-height: 34rpx; }.required-heading { display: flex; align-items: center; gap: 10rpx; color: var(--am-color-danger); font-weight: var(--am-weight-semibold); }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: var(--am-color-danger); box-shadow: var(--am-shadow-none); }
.section-title { display: flex; justify-content: space-between; gap: 18rpx; margin-bottom: var(--am-space-3); }
.section-title text:first-child { font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.section-title text:last-child { color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); }
.progress-card > text { display: block; margin-top: 18rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 1.6; }
.empty-state { padding: 120rpx 32rpx; text-align: center; font-size: 30rpx; font-weight: var(--am-weight-semibold); }
brand-success-card { display: block; margin-bottom: var(--am-space-3); }

@import "../../styles/money.wxss";
