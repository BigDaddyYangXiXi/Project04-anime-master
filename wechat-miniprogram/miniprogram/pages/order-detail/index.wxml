<app-top-nav class="app-navigation" title="订单详情" show-back="{{true}}"/>
<view wx:if="{{loading}}" class="empty-state"><text>正在读取订单</text><text>请稍候，不会重复执行任何操作。</text></view>
<view class="detail-shell" wx:elif="{{order}}">
  <view wx:if="{{order.paymentStatus === 'PAYMENT_REVIEW'}}" class="notice-card">付款待核对：已收到付款记录，金额或订单状态需要核对，请勿重复付款。本状态不代表已完成退款或结算。</view>
  <view wx:if="{{bookingInProgress}}" class="notice-card">预约沟通、保密签署、合作确认与支付统一在预约状态页完成，避免从详情页绕过必要步骤。<button class="primary-block" bindtap="goBookingStatus">返回预约进度</button></view>
  <block wx:else>
  <view class="page-intro"><text>{{statusLabel}}</text><text>{{order.service}}</text><text>{{providerIdentity.nickname}} · {{providerIdentity.uid}}</text><view class="where-when"><text>{{order.city}}</text><view><text wx:for="{{schedule.lines}}" wx:key="label">{{item.label}} · {{item.text}}</text></view></view></view>
  <view class="content-card cooperation-card">
    <view class="section-title"><text>已经确认的合作信息</text><text>{{order.id}}</text></view>
    <view class="order-fact-stack">
      <view class="order-fact-item"><text class="order-fact-number">1</text><view class="order-fact-copy"><text>地点与时间</text><text>{{order.city}} · {{schedule.mode}}</text><text wx:if="{{order.deliveryText}}">{{order.deliveryText}}</text><view class="order-fact-schedule"><text wx:for="{{schedule.lines}}" wx:key="label">{{item.label}} · {{item.text}}</text></view></view></view>
      <view class="order-fact-item"><text class="order-fact-number">2</text><view class="order-fact-copy"><text>服务内容</text><text>{{order.service}}</text></view></view>
      <view class="order-fact-item"><text class="order-fact-number">3</text><view class="order-fact-copy"><text>保密需求</text><text>{{ndaText}}</text></view></view>
      <view class="order-fact-item"><text class="order-fact-number">4</text><view class="order-fact-copy"><text>合作金额</text><text>合计 ￥{{order.finalPrice}}</text></view></view>
    </view>
  </view>
  <view wx:if="{{order.stage === 'NDA_BUYER_PENDING' && signIssues.length}}" class="required-summary"><view class="required-heading"><view class="required-dot"></view><text>签署前还需完成</text></view><text wx:for="{{signIssues}}" wx:key="*this">{{item}}</text></view>
  <button wx:if="{{canBuyerSign}}" class="primary-block" bindtap="signNda">阅读并签署保密协议</button>
  <view wx:if="{{waitingProvider}}" class="notice-card">你已签署，等待服务方签署保密协议。</view>
  <view wx:if="{{order.stage === 'BUYER_FINAL_CONFIRM' && confirmIssues.length}}" class="required-summary"><view class="required-heading"><view class="required-dot"></view><text>进入执行前还需完成</text></view><text wx:for="{{confirmIssues}}" wx:key="*this">{{item}}</text></view>
  <button wx:if="{{canConfirm}}" class="primary-block" bindtap="confirmExecution">确认合作内容并进入执行</button>
  <block wx:if="{{inProduction}}">
    <view class="progress-card"><text class="card-kicker">当前执行状态</text><view class="section-title"><text>{{order.stage === 'REVISION_REQUESTED' ? '修改处理中' : '执行制作中'}}</text><text>{{order.progress}}%</text></view><progress percent="{{order.progress}}" stroke-width="8" activeColor="#ff6f71" backgroundColor="#f2e7e4"/><text>服务方更新进度后，双方会在同一笔订单中看到最新状态。</text></view>
    <button class="secondary-block" bindtap="goProject">加入或查看所属项目</button>
  </block>
  <brand-success-card
    wx:if="{{completed}}"
    eyebrow="订单已经完成"
    title="这次合作顺利收官"
    copy="合作结果已保存，可以继续评价服务方。"
    action-text="{{order.rating ? '查看已提交评价' : '评价本次服务'}}"
    bind:action="goReview"
  />
  </block>
</view>
<view wx:else class="empty-state"><text>{{loadError || '没有找到订单'}}</text><button wx:if="{{loadError}}" bindtap="retryLoad">重新加载</button></view>
<main-bottom-nav/>
