<app-top-nav class="app-navigation" title="订单详情" show-back="{{true}}"/>
<block wx:if="{{loading && !order}}"></block>
<view class="detail-shell" wx:elif="{{order}}">
  <view wx:if="{{order.paymentStatus === 'PAYMENT_REVIEW'}}" class="notice-card">付款待核对：已收到付款记录，付款信息或订单状态需要核对，请勿重复付款。本状态不代表已完成退款或结算。</view>
  <view wx:if="{{bookingInProgress}}" class="notice-card">本次合作还在预约阶段，请先完成合作确认。<button hover-class="none" class="primary-block am-action am-action-primary am-action-block" bindtap="goBookingStatus">返回预约进度</button></view>
  <block wx:else>
  <view class="page-intro"><text>{{statusLabel}}</text><text>{{order.service}}</text><text class="am-identity-full">{{providerIdentity.nickname}}</text><view class="where-when"><text>{{order.city}}</text><view><text wx:for="{{schedule.lines}}" wx:key="label">{{item.label}} · {{item.text}}</text></view></view></view>
  <order-subscription id="order-subscription" wx:if="{{order.cloudOrder && order.stage !== 'COMPLETED' && order.stage !== 'DECLINED'}}" order-id="{{order.id}}"/>
  <block wx:if="{{inProduction}}">
    <view class="progress-card"><text class="card-kicker">当前执行状态</text><view class="section-title"><text>{{order.stage === 'REVISION_REQUESTED' ? '修改处理中' : '执行制作中'}}</text><text>{{order.progress}}%</text></view><progress percent="{{order.progress}}" stroke-width="8" activeColor="#ff946b" backgroundColor="#332d28"/><text>服务方更新进度后，双方会在同一笔订单中看到最新状态。</text></view>
    <button hover-class="none" class="secondary-block am-action am-action-secondary" bindtap="goProject">加入或查看所属项目</button>
  </block>
  <view class="content-card cooperation-card">
    <view class="section-title order-fact-heading"><text class="order-fact-heading-line">已经确认的合作信息</text><text class="order-fact-heading-line">{{order.id}}</text></view>
    <view class="order-fact-stack">
      <view class="order-fact-item"><view class="order-fact-copy"><text>地点与时间</text><text>{{order.city}} · {{schedule.mode}}</text><text wx:if="{{order.deliveryText}}">{{order.deliveryText}}</text><view class="order-fact-schedule"><text wx:for="{{schedule.lines}}" wx:key="label">{{item.label}} · {{item.text}}</text></view></view></view>
      <view class="order-fact-item"><view class="order-fact-copy"><text>服务内容</text><text>{{order.service}}</text></view></view>
      <view class="order-fact-item"><view class="order-fact-copy"><text>保密需求</text><text>{{ndaText}}</text></view></view>
      <view class="order-fact-item"><view class="order-fact-copy"><text>合作金额</text><text class="am-money am-money-inline">合计 ￥{{order.finalPrice}}</text></view></view>
    </view>
  </view>
  <view wx:if="{{order.stage === 'NDA_BUYER_PENDING' && signIssues.length}}" class="required-summary"><view class="required-heading"><view class="required-dot"></view><text>签署前还需完成</text></view><text wx:for="{{signIssues}}" wx:key="*this">{{item}}</text></view>
  <button hover-class="none" wx:if="{{canBuyerSign}}" class="primary-block am-action am-action-primary am-action-block" bindtap="signNda">阅读并签署保密协议</button>
  <view wx:if="{{waitingProvider}}" class="notice-card">你已签署，等待服务方签署保密协议。</view>
  <view wx:if="{{order.stage === 'BUYER_FINAL_CONFIRM' && confirmIssues.length}}" class="required-summary"><view class="required-heading"><view class="required-dot"></view><text>进入执行前还需完成</text></view><text wx:for="{{confirmIssues}}" wx:key="*this">{{item}}</text></view>
  <button hover-class="none" wx:if="{{canConfirm}}" class="primary-block am-action am-action-primary am-action-block" bindtap="confirmExecution">确认合作内容并进入执行</button>

  <button hover-class="none" wx:if="{{order.referenceAssetId && !order.privateFieldsHidden}}" class="am-action am-action-secondary am-action-block" bindtap="openReference">查看私人参考图</button>
  <brand-success-card
    wx:if="{{completed}}"
    eyebrow="订单已经完成"
    title="这次合作顺利收官"
    copy="合作结果已保存，可以继续评价服务方。"
    action-text="{{order.rating ? '查看已提交评价' : '评价本次服务'}}"
    bind:action="goReview"
  />
  <button hover-class="none" wx:if="{{completed}}" class="am-action am-action-secondary am-action-block" bindtap="goDelivery">查看交付结果</button>
  </block>
  <button hover-class="none" wx:if="{{order.cloudOrder && order.viewerRole === 'BUYER' && order.paymentStatus === 'PAID'}}" class="am-action am-action-secondary am-action-block" bindtap="goRefund">{{order.stage === 'COMPLETED' ? '退款记录与争议反馈' : '退款申请与记录'}}</button>
</view>
<view wx:else class="empty-state"><text>{{loadError || '没有找到订单'}}</text><button hover-class="none" wx:if="{{loadError}}" bindtap="retryLoad">重新加载</button></view>
<main-bottom-nav/>
