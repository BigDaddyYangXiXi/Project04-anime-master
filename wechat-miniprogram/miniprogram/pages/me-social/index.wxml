<app-top-nav workspace="{{navWorkspace}}" title="{{title}}" show-back="{{true}}"/>
<view class="mi-page mi-stack"><text class="mi-muted">{{type === 'likes' ? '按当前公开作品查看收到的喜欢，与自己收藏的作品分开统计。' : '这些用户关注了你的账号。仅展示公开昵称和用户名。'}}</text><text wx:if="{{loading}}" class="mi-muted">正在读取…</text><view wx:if="{{error}}" class="mi-card mi-pad"><text class="mi-error">{{error}}</text><button hover-class="none" class="am-action am-action-secondary" bindtap="load">重新读取</button></view><view wx:elif="{{ready && !items.length}}" class="mi-card mi-pad"><text class="mi-title">暂无记录</text><text class="mi-muted">发布作品与服务，让更多人了解你。</text></view><view wx:for="{{items}}" wx:key="id" class="mi-card"><button hover-class="none" wx:if="{{type === 'likes'}}" class="mi-row" data-id="{{item.id}}" bindtap="openWork"><text class="mi-row-copy">{{item.title}}</text><text class="mi-muted">{{item.count}} 次喜欢</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><view wx:else class="mi-pad"><text class="mi-title">{{item.nickname}}</text><text wx:if="{{item.username}}" class="mi-muted">@{{item.username}}</text></view></view><button hover-class="none" wx:if="{{cursor !== null}}" class="am-action am-action-secondary" aria-disabled="{{loading}}" data-am-disabled="{{loading}}" data-more="1" bindtap="{{(loading) ? '' : 'load'}}">加载更多</button></view>
