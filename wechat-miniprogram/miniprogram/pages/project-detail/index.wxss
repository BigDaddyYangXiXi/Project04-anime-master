.project-shell { padding: 20rpx 32rpx 80rpx; }
.project-header { position: relative; overflow: hidden; padding: 24rpx 28rpx; border: 2rpx solid rgba(255,255,255,.9); border-radius: 34rpx; color: #4a302d; background: linear-gradient(135deg,#ffe2d5,#ffd3c5 54%,#fbcdd8); }
.project-header::after { position: absolute; top: -72rpx; right: -62rpx; width: 220rpx; height: 220rpx; border: 18rpx solid rgba(255,255,255,.34); border-radius: 50%; content: ""; }
.project-header text { display: block; }
.project-title { margin: 0 0 4rpx; font-size: 42rpx; font-weight: 800; line-height: 54rpx; }
.project-copy { overflow: hidden; color: #755d58; font-size: 23rpx; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(201,78,97,.16); }
.project-stats view { min-width: 0; text-align: center; }
.project-stats text:first-child { overflow: hidden; font-size: 28rpx; font-weight: 800; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-stats text:last-child { color: #806963; font-size: 22rpx; line-height: 34rpx; }
.content-card { margin-top: 18rpx; padding: 24rpx; border: 1rpx solid #eedfd9; border-radius: 32rpx; background: #fff; }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 14rpx; }
.section-title > view { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; }
.section-title > .role-heading { align-items: center; gap: 10rpx; }
.role-count { color: #c94e61; font-size: 22rpx; line-height: 32rpx; }
.section-title > view text:first-child, .section-title > text:first-child { font-size: 29rpx; font-weight: 800; line-height: 40rpx; }
.section-title > view text:last-child, .section-title > text:last-child { color: #c94e61; font-size: 22rpx; line-height: 32rpx; }
.order-section-title { position: relative; min-height: 64rpx; padding-right: 128rpx; }
.section-title > .role-heading { align-items: center; }
.section-title > .role-heading .role-count { color: #c94e61; font-size: 22rpx; line-height: 32rpx; }
.add-order-inline { position: absolute; top: 50%; right: 0; display: flex; width: 112rpx; height: 64rpx; align-items: center; justify-content: center; border: 1rpx solid #f0c9c1; border-radius: 20rpx; color: #c94e61; background: #fff7f2; font-size: 22rpx; font-weight: 700; line-height: 32rpx; box-shadow: none; transform: translateY(-50%); }
.role-list { overflow: hidden; border: 1rpx solid #eedfd9; border-radius: 22rpx; background: #fff; }
.role-row { display: flex; width: 100%; min-height: 104rpx; gap: 12rpx; align-items: center; padding: 8rpx 12rpx 8rpx 18rpx; border: 0; border-bottom: 1rpx solid #eedfd9; border-radius: 0; background: transparent; text-align: left; }
.role-row:last-child { border-bottom: 0; }
.role-main { width: 0; min-width: 0; flex: 1 1 auto; }
.role-main text, .role-trailing text { display: block; }
.role-title { overflow: hidden; font-size: 24rpx; font-weight: 800; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.role-sub { overflow: hidden; margin-top: 2rpx; color: #806f69; font-size: 20rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.role-trailing { min-width: 104rpx; flex: 0 0 auto; text-align: right; }
.role-state { color: #c94e61; font-size: 19rpx; font-weight: 700; line-height: 28rpx; }
.role-amount { margin-top: 2rpx; color: #4a302d; font-size: 22rpx; font-weight: 800; line-height: 32rpx; }
.unlink-order { display: flex; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; align-items: center; justify-content: center; padding: 0; border: 0; border-left: 1rpx solid #f1e5e0; color: #b34b5b; background: transparent; font-size: 21rpx; font-weight: 700; line-height: 32rpx; box-shadow: none; }
.empty-state { padding: 30rpx 24rpx; border-radius: 26rpx; background: #fff7f2; text-align: center; }
.empty-state text { display: block; }
.empty-state text:first-child { font-size: 27rpx; font-weight: 800; line-height: 40rpx; }
.empty-state text:last-child { margin-top: 8rpx; color: #806f69; font-size: 23rpx; line-height: 36rpx; }
.secondary-block { display: block; width: 100%; min-height: 88rpx; margin-top: 24rpx; padding: 20rpx 32rpx; border-radius: 28rpx; font-size: 28rpx; font-weight: 700; line-height: 40rpx; }
.available-panel { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #eedfd9; border-radius: 26rpx; background: #fffaf7; }
.available-heading { margin-bottom: 14rpx; }
.available-heading text { display: block; }
.available-heading text:first-child { font-size: 25rpx; font-weight: 800; line-height: 38rpx; }
.available-heading text:last-child { margin-top: 2rpx; color: #806f69; font-size: 21rpx; line-height: 32rpx; }
.available-list { overflow: hidden; border: 1rpx solid #eedfd9; border-radius: 20rpx; background: #fff; }
.available-row { display: grid; width: 100%; grid-template-columns: minmax(0,1fr) auto; gap: 18rpx; align-items: center; padding: 20rpx; border: 0; border-bottom: 1rpx solid #f2e6e1; background: transparent; text-align: left; }
.available-row:last-child { border-bottom: 0; }
.available-row view:first-child text { display: block; }
.available-row view:first-child text:first-child { font-size: 24rpx; font-weight: 800; line-height: 36rpx; }
.available-row view:first-child text:last-child { margin-top: 4rpx; color: #806f69; font-size: 21rpx; line-height: 32rpx; }
.available-row view:last-child { text-align: right; }
.available-row view:last-child text { display: block; }
.available-row view:last-child text:first-child { color: #c94e61; font-size: 20rpx; line-height: 30rpx; }
.available-row view:last-child text:last-child { margin-top: 4rpx; color: #c94e61; font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.info-list { overflow: hidden; border: 1rpx solid #eedfd9; border-radius: 26rpx; }
.info-list view { display: grid; grid-template-columns: 104rpx minmax(0,1fr); gap: 16rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid #f2e6e1; }
.info-list view:last-child { border-bottom: 0; }
.info-list text:first-child { color: #98857e; font-size: 23rpx; line-height: 36rpx; }
.info-list text:last-child { font-size: 24rpx; line-height: 36rpx; }
.description-block { margin-top: 20rpx; padding: 24rpx; border-radius: 26rpx; background: #fff7f2; }
.description-block text { display: block; }
.description-block text:first-child { color: #c94e61; font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.description-lines { margin-top: 12rpx; }
.description-line { display: grid; grid-template-columns: 112rpx minmax(0,1fr); gap: 10rpx; align-items: start; padding: 5rpx 0; }
.description-line.plain { display: block; }
.description-label { color: #8d7068; font-size: 24rpx; font-weight: 700; line-height: 42rpx; }
.description-value { color: #4f403c; font-size: 26rpx; line-height: 42rpx; overflow-wrap: anywhere; }
.target-images-block { margin-top: 20rpx; }
.target-images-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.target-images-heading text:first-child { color: #c94e61; font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.target-images-heading text:last-child { color: #98857e; font-size: 21rpx; line-height: 32rpx; }
.target-images-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }
.target-images-grid image { width: 100%; height: 220rpx; border: 1rpx solid #ead8d1; border-radius: 20rpx; background: #fff7f2; box-sizing: border-box; }
.target-images-grid.single { grid-template-columns: 1fr; }
.target-images-grid.single image { height: 320rpx; }
.target-images-empty { display: block; padding: 18rpx 20rpx; border: 1rpx dashed #e6cec5; border-radius: 20rpx; color: #8f7a73; background: #fffaf7; font-size: 22rpx; line-height: 34rpx; }
