.project-shell { padding: var(--am-detail-nav-page-padding); }
.project-header { position: relative; overflow: hidden; padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); color: var(--am-color-text); background: var(--am-color-surface); }

.project-header text { display: block; }
.project-title { margin: 0 0 4rpx; font-size: 42rpx; font-weight: var(--am-weight-semibold); line-height: 54rpx; }
.project-copy { overflow: hidden; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.project-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin-top: var(--am-space-2); padding-top: 14rpx; border-top: 1rpx solid var(--am-color-border); }
.project-stats view { min-width: 0; text-align: center; }
.project-stats text:first-child { overflow: hidden; font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); text-overflow: ellipsis; white-space: nowrap; }
.project-stats text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.content-card { margin-top: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface);  margin-bottom: var(--am-detail-section-gap);}
.section-title { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-2); margin-bottom: 14rpx; }
.section-title > view { display: flex; min-width: 0; align-items: baseline; gap: 12rpx; }
.section-title > .role-heading { align-items: center; gap: 10rpx; }
.role-count { color: var(--am-color-brand); font-size: var(--am-type-micro); line-height: 32rpx; }
.section-title > view text:first-child, .section-title > text:first-child { font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); }
.section-title > view text:last-child, .section-title > text:last-child { color: var(--am-color-brand); font-size: var(--am-type-micro); line-height: 32rpx; }
.order-section-title { position: relative; min-height: 64rpx; padding-right: 128rpx; }
.section-title > .role-heading { align-items: center; }
.section-title > .role-heading .role-count { color: var(--am-color-brand); font-size: var(--am-type-micro); line-height: 32rpx; }
.add-order-inline { position: absolute; top: 50%; right: 0; display: flex; width: 112rpx; height: 64rpx; align-items: center; justify-content: center; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; color: var(--am-color-brand); background: var(--am-color-control-surface); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 32rpx; box-shadow: none; transform: translateY(-50%); }
.role-list { overflow: hidden; border: 1rpx solid var(--am-color-border); border-radius: 22rpx; background: var(--am-color-surface); }
.role-row { display: flex; width: 100%; min-height: 104rpx; gap: 12rpx; align-items: center; padding: 8rpx 12rpx 8rpx 18rpx; border: 0; border-bottom: 1rpx solid var(--am-color-border); border-radius: 0; background: transparent; text-align: left; }
.role-row:last-child { border-bottom: 0; }
.role-main { width: 0; min-width: 0; flex: 1 1 auto; }
.role-main text, .role-trailing text { display: block; }
.role-title { overflow: hidden; font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.role-sub { overflow: hidden; margin-top: 2rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.role-trailing { min-width: 104rpx; flex: 0 0 auto; text-align: right; }
.role-state { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 28rpx; }
.role-amount { margin-top: 2rpx; color: var(--am-color-text); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 32rpx; }
.unlink-order { display: flex; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; align-items: center; justify-content: center; padding: var(--am-space-none); border: 0; border-left: 1rpx solid var(--am-color-border); color: var(--am-color-danger); background: transparent; font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 32rpx; box-shadow: none; }
.empty-state { padding: 30rpx 24rpx; border-radius: 26rpx; background: var(--am-color-control-surface); text-align: center; }
.empty-state text { display: block; }
.empty-state text:first-child { font-size: 27rpx; font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); }
.empty-state text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.secondary-block { display: block; width: 100%;  margin-top: var(--am-space-3);      }
.available-panel { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid var(--am-color-border); border-radius: 26rpx; background: var(--am-color-control-surface); }
.available-heading { margin-bottom: 14rpx; }
.available-heading text { display: block; }
.available-heading text:first-child { font-size: 25rpx; font-weight: var(--am-weight-semibold); line-height: 38rpx; }
.available-heading text:last-child { margin-top: 2rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.available-list { overflow: hidden; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; background: var(--am-color-surface); }
.available-row { display: grid; width: 100%; grid-template-columns: minmax(0,1fr) auto; gap: 18rpx; align-items: center; padding: 20rpx; border: 0; border-bottom: 1rpx solid var(--am-color-border); background: transparent; text-align: left; }
.available-row:last-child { border-bottom: 0; }
.available-row view:first-child text { display: block; }
.available-row view:first-child text:first-child { font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); }
.available-row view:first-child text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.available-row view:last-child { text-align: right; }
.available-row view:last-child text { display: block; }
.available-row view:last-child text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); line-height: 30rpx; }
.available-row view:last-child text:last-child { margin-top: 4rpx; color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.info-list { overflow: hidden; border: 1rpx solid var(--am-color-border); border-radius: 26rpx; }
.info-list view { display: grid; grid-template-columns: 104rpx minmax(0,1fr); gap: var(--am-space-2); padding: 20rpx 22rpx; border-bottom: 1rpx solid var(--am-color-border); }
.info-list view:last-child { border-bottom: 0; }
.info-list text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.info-list text:last-child { font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.description-block { margin-top: 20rpx; padding: var(--am-space-3); border-radius: 26rpx; background: var(--am-color-control-surface); }
.description-block text { display: block; }
.description-block text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.description-lines { margin-top: 12rpx; }
.description-line { display: grid; grid-template-columns: 112rpx minmax(0,1fr); gap: 10rpx; align-items: start; padding: 5rpx 0; }
.description-line.plain { display: block; }
.description-label { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.description-value { color: var(--am-color-text); font-size: var(--am-type-label); line-height: 42rpx; overflow-wrap: anywhere; }
.target-images-block { margin-top: 20rpx; }
.target-images-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--am-space-2); margin-bottom: 12rpx; }
.target-images-heading text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.target-images-heading text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.target-images-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }
.target-images-grid image { width: 100%; height: 220rpx; border: 1rpx solid #ead8d1; border-radius: 20rpx; background: #fff7f2; box-sizing: border-box; }
.target-images-grid.single { grid-template-columns: 1fr; }
.target-images-grid.single image { height: 320rpx; }
.target-images-empty { display: block; padding: 18rpx 20rpx; border: 1rpx dashed var(--am-color-border); border-radius: 20rpx; color: var(--am-color-text-secondary); background: var(--am-color-control-surface); font-size: var(--am-type-micro); line-height: 34rpx; }

@import "../../styles/money.wxss";
.project-stats { position: relative; z-index: 1; }
