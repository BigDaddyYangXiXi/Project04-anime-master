@import "../../styles/media-placeholder.wxss";
@import "../../styles/creator-follow.wxss";
page { background: var(--am-color-canvas); }
page .detail-shell { padding: var(--am-space-none) var(--am-space-4); padding-bottom: calc(var(--am-work-action-height) + var(--am-work-body-bottom) + env(safe-area-inset-bottom)); color: var(--am-color-text); background: var(--am-color-canvas); }
.work-detail-head { padding-top: var(--am-space-6); }
.provider-head { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); min-height: var(--am-avatar-detail-author); padding: var(--am-space-2) var(--am-space-none); }
.provider-link { display: flex; flex: 1; min-width: 0; min-height: 88rpx; align-items: center; gap: var(--am-space-2); margin: var(--am-space-none); padding: var(--am-space-none); background: var(--am-color-transparent); text-align: left; }
.provider-link text { display: block; overflow: hidden; color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); line-height: var(--am-work-line-label); text-overflow: ellipsis; white-space: nowrap; }
.avatar { display: flex; width: var(--am-avatar-detail-author); height: var(--am-avatar-detail-author); flex: 0 0 var(--am-avatar-detail-author); align-items: center; justify-content: center; border-radius: var(--am-radius-avatar); color: var(--am-color-text-secondary); background: var(--am-color-control-surface); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); }
.avatar-image { display: block; }
.provider-link:active { opacity: .65; }
.like-button[data-am-disabled="true"] { opacity: .55; }
.detail-title { display: block; margin: var(--am-work-space-six) var(--am-space-none) var(--am-space-3); color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); overflow-wrap: break-word; }
.detail-subtitle { display: block; margin: var(--am-space-2) var(--am-space-none); color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); line-height: var(--am-work-line-small); }
.work-image-stack { margin: var(--am-media-full-bleed-margin); }
.work-figure-card { position: relative; overflow: hidden; }
.detail-image { display: block; width: 100%; height: auto; }
.work-code-bar { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); margin-top: var(--am-space-6); padding-top: var(--am-space-4); padding-bottom: var(--am-space-none); border-top: var(--am-work-rule); }
.work-code-bar::before { content: none; }
.work-code-copy { flex: 1; min-width: 0; }
.work-code-copy text { display: block; color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); line-height: var(--am-work-line-small); }
.work-code-copy text:last-child { color: var(--am-color-text); font-size: var(--am-type-caption); line-height: var(--am-work-code-line); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.code-copy-button { display: flex; margin: var(--am-space-none); width: 128rpx; min-width: 128rpx; max-width: 128rpx; flex: 0 0 128rpx; min-height: 88rpx; align-items: center; justify-content: center; gap: 12rpx; padding: 0 12rpx; color: var(--am-color-text-secondary); background: var(--am-color-transparent); font-size: var(--am-type-caption); }
.code-copy-button.active { color: var(--am-color-text-secondary); }
.copy-glyph { position: relative; width: 28rpx; height: 28rpx; }
.copy-glyph::before,.copy-glyph::after { position: absolute; width: 18rpx; height: 18rpx; border: 2rpx solid currentColor; border-radius: 3rpx; box-sizing: border-box; content: ""; }
.copy-glyph::before { top: 1rpx; left: 1rpx; }
.copy-glyph::after { right: 1rpx; bottom: 1rpx; background: var(--am-color-canvas); }
.detail-shell .work-detail-info { padding: var(--am-space-none); margin: var(--am-space-none); border: 0; border-radius: 0; background: var(--am-color-transparent); box-shadow: none; }
.detail-description { display: block; margin: var(--am-space-4) var(--am-space-none); color: var(--am-color-text); font-size: var(--am-type-body); line-height: var(--am-work-line-body); }
.tag-row { display: flex; flex-wrap: wrap; gap: var(--am-space-2); margin-top: var(--am-space-4); }
.tag-row text { padding: var(--am-work-tag-padding); border-radius: var(--am-radius-tag); color: var(--am-color-text-secondary); background: var(--am-color-control-surface); font-size: var(--am-type-micro); line-height: var(--am-work-line-small); }
.work-action-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: var(--am-space-3); padding: var(--am-work-footer-padding) var(--am-space-4) calc(var(--am-work-footer-padding) + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--am-color-border); background: var(--am-color-canvas); }
.like-button { display: flex; width: 88rpx; min-width: 88rpx; max-width: 88rpx; min-height: 88rpx; flex: 0 0 88rpx; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; padding: var(--am-space-none); color: var(--am-color-text-secondary); background: var(--am-color-transparent); font-size: var(--am-type-micro); line-height: 30rpx; }
.like-icon { display: block; width: 44rpx; height: 44rpx; }
.like-button.active { color: var(--am-color-brand); }
.action-price { flex: 1; min-width: 0; }
.action-price text { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 30rpx; }
.action-price text:last-child { color: var(--am-color-price); font-size: var(--am-type-section-title); line-height: var(--am-line-body); font-weight: var(--am-weight-semibold); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.booking-button { display: flex; width: 272rpx; min-width: 240rpx; max-width: 272rpx; flex: 0 0 44%; align-items: center; justify-content: center; border-radius: var(--am-radius-pill); }
.work-state { padding: 96rpx 32rpx; text-align: center; color: var(--am-color-text-secondary); font-size: var(--am-type-body); }
.work-state button { min-height: 88rpx; margin-top: var(--am-space-3); color: var(--am-color-brand); background: var(--am-color-transparent); }

@import "../../styles/money.wxss";

.detail-shell.is-provider-preview { padding-bottom: calc(var(--am-work-body-bottom) + env(safe-area-inset-bottom)); }
.related-service { margin-top: var(--am-space-6); padding-top: var(--am-space-6); border-top: var(--am-work-rule); }
.service-heading { display: block; color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.related-service-link { display: flex; align-items: center; gap: var(--am-space-3); width: 100%; min-width: 100%; max-width: 100%; min-height: var(--am-work-service-min-height); padding: var(--am-space-4) var(--am-space-3); margin: var(--am-space-none); border: var(--am-work-rule); border-radius: var(--am-radius-control); text-align: left; background: var(--am-color-surface); }
.service-copy { flex: 1; min-width: 0; }
.service-name { display: block; color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); line-height: var(--am-work-line-label); }
.service-description { display: block; margin-top: var(--am-work-space-six); color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); font-weight: var(--am-weight-regular); line-height: var(--am-work-line-small); }
.service-price { flex-shrink: 0; }
.reference-count { display: block; margin-top: var(--am-work-space-six); color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); line-height: var(--am-work-line-small); }
.service-chevron { flex-shrink: 0; width: var(--am-space-1); height: var(--am-space-1); border-top: var(--am-border-control); border-right: var(--am-border-control); transform: rotate(45deg); }

.work-context-note { display: block; margin: var(--am-space-2) var(--am-space-none); color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); line-height: var(--am-work-line-small); }

.service-section-head { margin-bottom: var(--am-space-4); }

.service-note { display: block; margin: var(--am-space-2) var(--am-space-none); color: var(--am-color-text-secondary); font-size: var(--am-work-type-small); line-height: var(--am-work-line-small); }

.author-copy { flex: 1; min-width: 0; }

.provider-link .author-meta { font-size: var(--am-work-type-small); font-weight: var(--am-weight-regular); line-height: var(--am-work-line-small); color: var(--am-color-text-secondary); }

.social-read-error { display: flex; flex-direction: column; gap: var(--am-space-3); padding: var(--am-space-4); color: var(--am-color-text-secondary); font-size: var(--am-type-body); }

.work-credits { margin:var(--am-space-4); padding:var(--am-space-3) var(--am-space-none); border-bottom:var(--am-border-control); }
.work-credits > view { display:flex; gap:var(--am-space-3); padding:var(--am-space-1) var(--am-space-none); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
.work-credits > view > text:first-child { color:var(--am-color-text-secondary); flex-shrink:0; }
.work-credits > view > text:last-child { overflow-wrap:anywhere; }

/* Approved photo-led reading order is shared by public and draft previews. */
.work-detail-shell .work-image-stack { margin:var(--am-space-none); }
.work-detail-shell .work-figure-card { border-radius:var(--am-radius-card); }
.work-detail-shell .work-detail-head { padding-top:var(--am-space-3); }
.work-detail-shell .provider-head { padding:var(--am-space-3) var(--am-space-4); margin:var(--am-space-3) var(--am-space-none); border-radius:var(--am-radius-card); background:var(--am-color-surface); }
.work-image-continuation .work-figure-card + .work-figure-card { margin-top:var(--am-space-2); }
.work-detail-shell .work-credits { margin:var(--am-space-3) var(--am-space-none); }

@import "../../styles/storefront-editor.wxss";
.storefront-work-preview { padding:var(--am-space-4) var(--am-space-4) var(--am-space-8); }
.storefront-work-hero { display:block; width:100%; margin-top:var(--am-space-4); border-radius:var(--am-radius-control); }
.storefront-work-title { display:block; margin-top:var(--am-space-6); font-size:var(--am-type-page-title); line-height:var(--am-line-page-title); font-weight:var(--am-weight-semibold); }
.storefront-work-copy { display:block; white-space:pre-wrap; margin-top:var(--am-space-3); font-size:var(--am-type-body); line-height:var(--am-line-body); }
.storefront-work-section { margin:var(--am-space-6) var(--am-space-none); }
.storefront-work-heading { display:block; font-size:var(--am-type-section-title); line-height:var(--am-line-section-title); font-weight:var(--am-weight-semibold); }
