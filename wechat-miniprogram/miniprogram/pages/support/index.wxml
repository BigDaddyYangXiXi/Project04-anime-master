<app-top-nav workspace="{{navWorkspace}}" title="{{title}}" show-back="{{true}}"/>
<view class="mi-page mi-stack">
  <view wx:if="{{error}}" class="mi-card mi-pad"><text class="mi-copy mi-error">{{error}}</text><button hover-class="none" wx:if="{{mode !== 'form'}}" class="am-action am-action-secondary" bindtap="load">重新读取</button><button hover-class="none" class="am-action am-action-secondary" bindtap="contact">联系开发者</button></view>
  <block wx:if="{{mode === 'form'}}"><view class="mi-card mi-pad"><text class="mi-title">{{title}}</text><text class="mi-copy">{{kind === 'CANCEL' ? '注销需核验账号及未结订单、退款、款项等事项。提交申请不会立即删除账号，受理前可撤回。' : kind === 'PHONE' ? '说明需要更正的情况，后续经身份核验处理。本页不直接换绑手机号。' : kind === 'PRIVACY' ? '请说明需要查询、更正或删除的信息范围，核验身份后处理。' : '请描述遇到的问题、发生步骤和期望结果。'}}</text><text class="mi-muted">不要填写密码、验证码、完整证件号或银行卡号。</text></view><text class="mi-copy">申请说明</text><textarea class="mi-form" maxlength="1000" value="{{description}}" disabled="{{pending || unknown}}" data-field="description" bindinput="input" placeholder="10—1000字"/><text class="mi-muted">{{description.length}}/1000</text><text class="mi-copy">关联订单编号（选填）</text><input class="mi-form" maxlength="64" value="{{orderId}}" disabled="{{pending || unknown}}" data-field="orderId" bindinput="input" placeholder="仅填写本人订单"/><view class="mi-card mi-pad"><text class="mi-copy">问题截图（选填，最多3张）</text><text class="mi-muted">请遮挡密码、验证码、证件及银行卡信息。图片通过审核后可提交。</text><view wx:for="{{images}}" wx:key="assetId" class="mi-media-row"><button hover-class="none" class="mi-media-preview" data-id="{{item.assetId}}" bindtap="previewDraft" aria-label="查看第{{index + 1}}张截图"><image wx:if="{{item.preview}}" class="mi-support-image" src="{{item.preview}}" mode="aspectFit" data-id="{{item.assetId}}" binderror="imageUnavailable"/><text wx:else class="mi-muted">截图{{index + 1}}</text></button><view class="mi-row-copy"><text class="mi-copy">第{{index + 1}}张截图</text><text class="mi-muted">{{item.statusText}}</text></view><button hover-class="none" class="am-action am-action-secondary mi-media-remove" data-id="{{item.assetId}}" aria-disabled="{{pending || unknown || uploading}}" data-am-disabled="{{pending || unknown || uploading}}" bindtap="{{(pending || unknown || uploading) ? '' : 'removeImage'}}" aria-label="移除第{{index + 1}}张截图">移除</button></view><text wx:if="{{uploading}}" class="mi-muted">正在处理图片，请稍候…</text><button hover-class="none" wx:if="{{images.length < 3}}" class="am-action am-action-secondary" aria-disabled="{{pending || unknown || uploading}}" data-am-disabled="{{pending || unknown || uploading}}" bindtap="{{(pending || unknown || uploading) ? '' : 'chooseImages'}}">添加截图</button><button hover-class="none" wx:if="{{images.length && !unknown}}" class="am-action am-action-secondary" aria-disabled="{{pending || uploading}}" data-am-disabled="{{pending || uploading}}" bindtap="{{(pending || uploading) ? '' : 'refreshImages'}}">刷新审核状态</button></view><text wx:if="{{guide}}" class="mi-muted">将附带当前帮助文章来源。</text><button hover-class="none" class="am-action am-action-primary" aria-disabled="{{pending || uploading}}" data-am-disabled="{{pending || uploading}}" bindtap="{{(pending || uploading) ? '' : 'submit'}}">{{pending ? '正在核对…' : unknown ? '核对并重试原申请' : '提交申请'}}</button><button hover-class="none" class="am-action am-action-secondary" bindtap="history">查看我的申请与反馈</button></block>
  <block wx:elif="{{mode === 'list'}}"><text wx:if="{{loading}}" class="mi-muted">正在读取…</text><view wx:if="{{ready && !items.length}}" class="mi-card mi-pad"><text class="mi-title">暂无申请记录</text><text class="mi-muted">已提交的反馈与账号申请会显示在这里。</text></view><view wx:for="{{items}}" wx:key="id" class="mi-card"><button hover-class="none" class="mi-row" data-id="{{item.id}}" bindtap="open"><view class="mi-row-copy"><text class="mi-title">{{item.title}}</text><text class="mi-muted">{{item.dateText}} · {{item.statusText}}</text></view><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><button hover-class="none" wx:if="{{cursor}}" class="am-action am-action-secondary" data-more="1" aria-disabled="{{loading}}" data-am-disabled="{{loading}}" bindtap="{{(loading) ? '' : 'load'}}">加载更多</button></block>
  <block wx:elif="{{record}}"><view class="mi-card mi-pad"><text class="mi-title">{{record.statusText}}</text><text class="mi-muted mi-break">{{record.id}}</text><text class="mi-copy">{{record.description}}</text><text wx:if="{{record.orderId}}" class="mi-muted mi-break">关联订单：{{record.orderId}}</text><text class="mi-muted">申请已记录，不代表换绑、退款或注销已经完成。</text></view><view wx:if="{{record.attachments && record.attachments.length}}" class="mi-card mi-pad"><text class="mi-title">已提交的截图</text><button hover-class="none" wx:for="{{record.attachments}}" wx:key="assetId" class="mi-media-row mi-media-detail" data-id="{{item.assetId}}" bindtap="previewImage"><view class="mi-media-thumb"><image wx:if="{{item.url}}" class="mi-support-image" src="{{item.url}}" mode="aspectFit" data-id="{{item.assetId}}" binderror="imageUnavailable"/><text wx:else class="mi-muted">截图{{index + 1}}</text></view><view class="mi-row-copy"><text class="mi-copy">第{{index + 1}}张截图</text><text class="mi-muted">{{item.url ? '查看大图' : '暂不可用，点击重新读取'}}</text></view><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><view wx:for="{{record.events}}" wx:key="id" class="mi-card mi-pad"><text class="mi-title">{{item.actorText}}</text><text class="mi-muted">{{item.dateText}}</text><text class="mi-copy">{{item.text}}</text></view><view wx:if="{{mutationUnknown}}" class="mi-card mi-pad"><text class="mi-copy">上次操作结果尚未确认，正在保留原提交内容。</text><button hover-class="none" class="am-action am-action-secondary" aria-disabled="{{pending || loading}}" data-am-disabled="{{pending || loading}}" bindtap="{{(pending || loading) ? '' : 'retryMutation'}}">核对上次操作</button></view><block wx:if="{{record.status !== 'CLOSED' && record.status !== 'WITHDRAWN'}}"><text class="mi-copy">补充说明</text><textarea class="mi-form" maxlength="1000" data-field="supplement" value="{{supplement}}" bindinput="input" disabled="{{pending || mutationUnknown}}"/><button hover-class="none" class="am-action am-action-primary" aria-disabled="{{pending || mutationUnknown}}" data-am-disabled="{{pending || mutationUnknown}}" bindtap="{{(pending || mutationUnknown) ? '' : 'append'}}">补充信息</button><button hover-class="none" wx:if="{{record.kind === 'CANCEL'}}" class="am-action am-action-secondary" aria-disabled="{{pending || mutationUnknown}}" data-am-disabled="{{pending || mutationUnknown}}" data-action="withdraw" bindtap="{{(pending || mutationUnknown) ? '' : 'append'}}">撤回注销申请</button></block><button hover-class="none" class="am-action am-action-secondary" bindtap="contact">联系开发者</button></block>
</view>
