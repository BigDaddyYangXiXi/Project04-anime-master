<app-top-nav workspace="{{navWorkspace}}" title="{{title}}" show-back="{{true}}"/>
<view class="mi-page mi-stack">
  <view wx:if="{{message}}" class="mi-card mi-pad" role="status"><text class="mi-copy">{{message}}</text><button hover-class="none" wx:if="{{section === 'security'}}" class="am-action am-action-secondary" bindtap="loadAccount">重新读取</button></view>
  <block wx:if="{{section === 'main'}}"><view class="mi-card"><button hover-class="none" class="mi-row" data-section="security" bindtap="open"><text class="mi-row-copy">账号与安全</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-section="permissions" bindtap="open"><text class="mi-row-copy">提醒与权限</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-section="privacy" bindtap="open"><text class="mi-row-copy">协议与隐私</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-section="about" bindtap="open"><text class="mi-row-copy">关于万匠屋</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><button hover-class="none" class="am-action am-action-secondary" bindtap="logout">退出登录</button></block>
  <block wx:elif="{{section === 'security'}}"><view class="mi-card mi-pad"><text class="mi-title">{{nickname || '当前账号'}}</text><text wx:if="{{username}}" class="mi-muted">{{username}}</text><text class="mi-muted">微信身份用于登录。平台不会索取微信密码或验证码。</text></view><view class="mi-card"><button hover-class="none" class="mi-row" bindtap="edit"><text class="mi-row-copy">修改头像与昵称</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-kind="PHONE" bindtap="request"><text class="mi-row-copy">申请更正绑定手机号</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-kind="CANCEL" bindtap="request"><text class="mi-row-copy">申请注销账号</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><text class="mi-muted">手机号更正与注销需核验身份。提交申请不会立即换绑或删除账号。</text></block>
  <block wx:elif="{{section === 'permissions'}}"><view class="mi-card mi-pad"><text class="mi-title">位置权限</text><text class="mi-copy">{{location}}</text><text class="mi-muted">用于识别所在城市并展示附近服务。拒绝后仍可手动选择服务城市。</text><button hover-class="none" class="am-action am-action-secondary" bindtap="openPermission">打开微信设置</button></view><view class="mi-card mi-pad"><text class="mi-title">订单提醒</text><text class="mi-muted">由微信确认每次订阅，不是永久开启。未订阅时仍可在订单页查看最新进度。</text><button hover-class="none" class="am-action am-action-secondary" aria-disabled="{{loading}}" data-am-disabled="{{loading}}" bindtap="{{(loading) ? '' : 'subscribe'}}">{{loading ? '正在请求…' : '订阅订单提醒'}}</button></view></block>
  <block wx:elif="{{section === 'privacy'}}"><view class="mi-card"><button hover-class="none" class="mi-row" bindtap="agreement"><text class="mi-row-copy">用户服务协议与账号规范</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" bindtap="privacy"><text class="mi-row-copy">隐私保护指引</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" data-kind="PRIVACY" bindtap="request"><text class="mi-row-copy">个人信息查询、更正与删除</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><text class="mi-muted">隐私指引由微信打开，内容以当前生效版本为准。</text></block>
  <block wx:elif="{{section === 'about'}}"><view class="mi-card mi-pad"><text class="mi-title">ArsViora 万匠屋</text><text class="mi-copy">好手艺，遇见好生意。</text><text class="mi-muted">版本：{{version}}</text><text class="mi-muted">帮助需求方找到合适的老师，帮助服务方管理作品、服务与合作。</text></view><button hover-class="none" class="am-action am-action-secondary" bindtap="contact">联系开发者</button></block>
</view>
