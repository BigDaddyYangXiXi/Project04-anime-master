.funds-shell{padding:28rpx}
.balance-card{padding:34rpx;border:1rpx solid #f0d7d1;border-radius:38rpx;background:linear-gradient(145deg,#fffaf6,#fff0ea)}
.balance-label,.balance-value{display:block}.balance-label{color:#8a6e68;font-size:21rpx;font-weight:700}.balance-value{margin-top:8rpx;color:#2b2523;font-size:58rpx;font-weight:800;line-height:1.25}
.balance-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:28rpx}.balance-actions button{width:100%;min-height:80rpx;border-radius:24rpx;box-shadow:none}
.funds-hero{margin-top:24rpx;padding:34rpx;border-radius:38rpx;color:#fff;background:linear-gradient(145deg,#df6d73,#ed8b73)}.funds-hero text{display:block}.funds-hero text:first-child{font-size:21rpx;font-weight:700}.funds-hero text:nth-child(2){margin-top:8rpx;font-size:54rpx;font-weight:800}.funds-hero text:last-child{margin-top:10rpx;color:rgba(255,255,255,.82);font-size:19rpx;line-height:30rpx}
.funds-menu,.records,.integrity-note{overflow:hidden;margin-top:24rpx;border:1rpx solid #eee3df;border-radius:34rpx;background:#fff}.funds-menu button{display:flex;width:100%;min-height:108rpx;align-items:center;gap:16rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #eee3df;background:#fff;text-align:left}.funds-menu button:last-child{border-bottom:0}.funds-menu button>view:first-child{min-width:0;flex:1}.funds-menu text{display:block}.funds-menu button>view text:first-child{font-size:25rpx;font-weight:800}.funds-menu button>view text:last-child{margin-top:4rpx;color:#766964;font-size:19rpx}.funds-menu button>text{color:#a86b70;font-size:18rpx}.chevron{width:14rpx;height:14rpx;border-top:3rpx solid #b8aaa5;border-right:3rpx solid #b8aaa5;transform:rotate(45deg)}
.records,.integrity-note{padding:28rpx}.section-title{display:block;margin-bottom:14rpx;font-size:28rpx;font-weight:800}.records>view{display:flex;align-items:center;padding:18rpx 0;border-top:1rpx solid #eee3df}.records>view>view{min-width:0;flex:1}.records text{display:block}.records>view>view text:first-child{font-size:23rpx;font-weight:700}.records>view>view text:last-child{margin-top:4rpx;color:#766964;font-size:18rpx}.records>view>text{color:#299673;font-size:22rpx;font-weight:800}
.integrity-note{background:#fff8f4}.integrity-note text{display:block}.integrity-note text:first-child{color:#c6536b;font-size:24rpx;font-weight:800}.integrity-note text:last-child{margin-top:8rpx;color:#766964;font-size:21rpx;line-height:34rpx}
