<app-top-nav title="资金管理" workspace="provider" show-back="{{true}}"/>
<view class="funds-shell">
  <view class="balance-card"><text class="balance-label">结算状态</text><text class="balance-value">待开通</text><text class="balance-copy">{{settlementCopy}}</text></view>
  <view wx:if="{{loading}}" class="integrity-note"><text>正在读取资金记录</text><text>请稍候。</text></view>
  <view wx:elif="{{loadError}}" class="integrity-note"><text>资金记录未能加载</text><text>{{loadError}}</text><button class="secondary-block" bindtap="load">重新加载</button></view>
  <block wx:elif="{{loaded}}">
    <view class="integrity-note"><text>收款资料</text><text>{{merchantCopy}}</text></view>
    <view class="records">
      <view class="records-heading"><text class="section-title">合作付款记录</text><text>按付款时间排序</text></view>
      <text class="records-copy">金额为付款记录总额，包含支付优惠；服务费、退款及最终结算需以各自处理结果为准。</text>
      <button wx:for="{{records}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="openOrder">
        <view class="record-main"><text>{{item.statusText}}</text><text class="order-id">{{item.orderId}}</text><text class="record-time">{{item.timeText}}</text></view>
        <text class="record-amount {{item.needsReview ? 'review' : ''}}">{{item.amountText}}</text><view class="chevron"></view>
      </button>
      <view wx:if="{{!records.length}}" class="records-empty"><text>暂无已确认的付款记录</text><text>合作付款记录保存后会显示在这里。</text></view>
      <text wx:if="{{moreError}}" class="records-copy error-copy">{{moreError}}</text>
      <button wx:if="{{nextCursor}}" class="secondary-block" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在读取…' : moreError ? '重试加载更多' : '加载更多'}}</button>
      <text wx:elif="{{records.length}}" class="records-end">已显示全部付款记录</text>
    </view>
  </block>
</view>