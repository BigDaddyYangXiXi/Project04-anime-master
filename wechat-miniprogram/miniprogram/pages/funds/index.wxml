<app-top-nav title="资金管理" workspace="{{role}}" show-back="{{true}}"/>
<view wx:if="{{role === 'buyer'}}" class="funds-shell buyer-funds">
  <text class="records-copy">查看订单款项，进入订单处理付款或查看退款记录。</text>
  <text wx:if="{{loading}}" class="records-copy">正在读取订单款项</text>
  <view wx:elif="{{loadError}}" class="integrity-note"><text>{{loadError}}</text><button hover-class="none" class="secondary-block am-action am-action-secondary" bindtap="load">重新加载</button></view>
  <view wx:elif="{{loaded}}" class="records">
    <button hover-class="none" wx:for="{{records}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="openOrder"><view class="record-main"><text>{{item.title}}</text><text class="record-time">{{item.statusText}}</text><text class="order-id">{{item.orderId}}</text></view><view class="income-column"><text class="income-label">订单金额</text><text class="record-amount am-money am-money-list">{{item.amountText}}</text></view></button>
    <view wx:if="{{!records.length}}" class="records-empty"><text>暂无待付款或已确认的订单款项</text></view>
  </view>
</view>
<view wx:else class="funds-shell">
  <view class="balance-card"><text class="balance-label">结算状态</text><text class="balance-value">待开通</text><text class="balance-copy">{{settlementCopy}}</text></view>
  <block wx:if="{{loading}}"></block>
  <view wx:elif="{{loadError}}" class="integrity-note"><text>资金记录未能加载</text><text>{{loadError}}</text><button hover-class="none" class="secondary-block am-action am-action-secondary" bindtap="load">重新加载</button></view>
  <block wx:elif="{{loaded}}">
    <view class="integrity-note"><text>收款资料</text><text>{{merchantCopy}}</text></view>
    <view wx:if="{{taxCopy}}" class="integrity-note"><text>税务资料</text><text>{{taxCopy}}</text><button hover-class="none" wx:if="{{taxError}}" class="secondary-block am-action am-action-secondary" bindtap="loadTaxStatus">重试</button></view>
    <button hover-class="none" class="secondary-block am-action am-action-secondary" bindtap="showWithdrawalGuide">提现指南</button>
    <view class="records">
      <view class="records-heading"><text class="section-title">订单收益明细</text><text>按付款时间排序</text></view>
      <text class="records-copy">平台服务费20%，以下为税前预计收益，不代表可提现余额。通道手续费由平台承担；适用税费在结算时扣除，提现不重复扣费。</text>
      <button hover-class="none" wx:for="{{records}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="openOrder">
        <view class="record-main"><text>{{item.statusText}}</text><text class="order-id">{{item.orderId}}</text><text class="record-time">{{item.timeText}}</text><text class="record-time">订单总额 {{item.amountText}}</text><text class="record-time">{{item.hasRefund ? '原平台服务费' : '平台服务费'}} {{item.feeText}}</text><block wx:if="{{item.hasRefund}}"><text class="record-time">已退款 {{item.refundText}}</text><text class="record-time">退款后平台服务费 {{item.retainedFeeText}}</text></block></view>
        <view class="income-column"><text class="income-label">税前收益</text><text class="record-amount am-money am-money-list {{item.needsReview ? 'review' : ''}}">{{item.incomeText}}</text><text class="income-label">{{item.incomeStateText}}</text></view>
      </button>
      <view wx:if="{{!records.length}}" class="records-empty"><text>暂无已确认的付款记录</text><text>合作付款记录保存后会显示在这里。</text></view>
      <text wx:if="{{moreError}}" class="records-copy error-copy">{{moreError}}</text>
      <button aria-disabled="{{loadingMore}}" hover-class="none" wx:if="{{nextCursor}}" class="secondary-block am-action am-action-secondary" data-am-disabled="{{loadingMore}}" bindtap="{{(loadingMore) ? '' : 'loadMore'}}">{{moreError ? '重试加载更多' : '加载更多'}}</button>
      <text wx:elif="{{records.length}}" class="records-end">已显示全部付款记录</text>
    </view>
  </block>
</view>
