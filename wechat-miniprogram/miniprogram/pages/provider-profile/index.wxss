.creator-editor .service-editor-body { gap:var(--am-space-none); }

.creator-editor button.editor-choice-row { display:flex; width:100%; align-items:center; justify-content:space-between; gap:var(--am-space-3); padding:var(--am-space-3) var(--am-space-none); margin:var(--am-space-none); border-radius:var(--am-space-none); background:var(--am-color-transparent); text-align:left; }
.creator-editor button.editor-choice-row + button.editor-choice-row { border-top:var(--am-border-control); }
.editor-choice-row > view:not(.right-check) { flex:1; min-width:0; }
.editor-choice-row text { display:block; font-size:var(--am-type-body); line-height:var(--am-line-body); }
.editor-choice-row text + text { margin-top:var(--am-space-1); color:var(--am-color-text-secondary); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }

.editor-section-title { margin:var(--am-space-4) var(--am-space-none) var(--am-space-2); }
.editor-notice { padding:var(--am-space-2) var(--am-space-3); margin-bottom:var(--am-space-4); border-left:var(--am-border-control); color:var(--am-color-text-secondary); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
.creator-editor .editor-service-list { border-radius:var(--am-radius-card); overflow:hidden; }

.editor-save-result { padding:var(--am-space-6) var(--am-space-none); text-align:center; }
.editor-result-mark { display:block; font-size:var(--am-type-page-title); line-height:var(--am-line-page-title); color:var(--am-color-success); margin-bottom:var(--am-space-2); }

button.service-area-base { width:auto; margin:var(--am-space-none); line-height:var(--am-line-caption); color:var(--am-color-brand); }

.image-selected { outline: 1px solid var(--am-color-brand); outline-offset: calc(var(--am-space-1) / 2); }
.image-drop-target { opacity: .65; }
.image-selection-tools { display:flex; align-items:center; flex-wrap:wrap; gap:var(--am-space-1); }
.image-selection-tools > text { color:var(--am-color-text-secondary); font-size:var(--am-type-caption); }
.image-selection-tools > button { width:auto; margin:var(--am-space-none); padding:var(--am-space-none) var(--am-space-2); min-height:var(--am-touch-min); font-size:var(--am-type-caption); color:var(--am-color-text); background:var(--am-color-control-surface); }
.creator-editor button.editor-optional-toggle { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:var(--am-touch-min); margin:var(--am-space-none) var(--am-space-none) var(--am-space-3); padding:var(--am-space-none); background:var(--am-color-transparent); text-align:left; }
.editor-optional-toggle text { font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
.editor-optional-toggle text + text { font-size:var(--am-type-caption); color:var(--am-color-text-secondary); }
.creator-editor .service-area-list { margin:var(--am-space-2) var(--am-space-none); }
.creator-editor .service-area-chip { padding:var(--am-space-none) var(--am-space-2); }
.creator-editor .service-area-chip button { min-width:var(--am-touch-min); min-height:var(--am-touch-min); background:var(--am-color-transparent); }
.profile-shell .content-card.editor-service-form { padding:var(--am-space-none); margin-bottom:var(--am-space-none); border:var(--am-border-none); border-radius:var(--am-space-none); background:var(--am-color-transparent); }
.creator-editor .service-location-grid > view:last-child { margin-bottom:var(--am-space-none); }
.creator-editor .service-cities .creator-caption { margin-bottom:var(--am-space-none); }

.creator-editor .am-picker { font-size:var(--am-type-body); line-height:var(--am-line-body); }

.creator-editor .editor-summary-row > view > text:first-child, .creator-editor .compact-field > text { color:var(--am-color-text-secondary); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
.creator-editor .editor-summary-row > view > .editor-placeholder { color:var(--am-color-text-secondary); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
@import "../../styles/storefront-editor.wxss";
