.profile-shell { padding: 28rpx 32rpx 80rpx; }
.page-intro { padding: 18rpx 8rpx 28rpx; }
.page-intro text { display: block; }
.page-title { margin-top: 0; color: #2b2523; font-size: 48rpx; font-weight: 800; line-height: 1.35; }
.page-copy { margin-top: 8rpx; color: #6f625d; font-size: 26rpx; line-height: 1.65; }
.content-card { width: 100%; margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.primary-button, .secondary-button { min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: 24rpx; font-weight: 700; }
.card-title { display: block; margin-bottom: 24rpx; font-size: 30rpx; font-weight: 800; }
.form-stack { display: flex; flex-direction: column; gap: 22rpx; }
.form-stack label, .service-editor-body label { display: flex; min-width: 0; flex-direction: column; gap: 10rpx; color: #2b2523; font-size: 21rpx; font-weight: 700; }
.form-stack input, .form-stack textarea, .service-editor input, .service-editor textarea { width: 100%; min-height: 72rpx; padding: 14rpx 18rpx; border: 1rpx solid #d9d0d9; border-radius: 18rpx; background: #fcfbfc; color: #2b2523; font-size: 23rpx; font-weight: 400; }
.form-stack textarea, .service-editor textarea { height: 156rpx; line-height: 1.55; }
.form-stack input[disabled] { color: #6f625d; background: #f2eff2; }
.profile-quick-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }
.readonly-field { min-width: 0; color: #2b2523; font-size: 21rpx; font-weight: 700; }
.readonly-field > view { display: flex; min-height: 72rpx; flex-direction: column; justify-content: center; margin-top: 10rpx; padding: 10rpx 18rpx; border: 1rpx solid #eee3df; border-radius: 18rpx; background: #f7f4f2; }
.readonly-field > view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.readonly-field > view text:first-child { font-size: 23rpx; }
.readonly-field > view text:last-child { color: #82736d; font-size: 16rpx; font-weight: 400; }
.compact-error { margin-top: -12rpx; }
.tag-preview { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx; }
.tag-preview-item { display: block; max-width: 100%; height: 40rpx; padding: 2rpx 16rpx; overflow: hidden; border-radius: 8rpx; color: #616161; background: #efedef; font-size: 24rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.upload-field > text { display: block; margin-bottom: 10rpx; font-size: 21rpx; font-weight: 700; }
.upload-button { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 76rpx; align-items: center; justify-content: center; padding: 14rpx 18rpx; border: 2rpx dashed #d9aaa8; border-radius: 20rpx; background: #fff; color: #c6536b; box-shadow: none; font-size: 21rpx; }
.upload-preview { display: block; width: 100%; height: 300rpx; border-radius: 24rpx; }
.section-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; }
.section-title > view { min-width: 0; flex: 1; }
.section-title > view text { display: block; }
.section-title > view text:first-child { color: #2b2523; font-size: 30rpx; font-weight: 800; }
.section-title > view text:last-child, .section-title > text:last-child { margin-top: 4rpx; color: #6f625d; font-size: 20rpx; line-height: 1.5; }
.service-editor { margin-top: 14rpx; overflow: hidden; border: 1rpx solid #e2d9e3; border-radius: 24rpx; background: #fff; }
.service-editor-head { display: flex; min-height: 104rpx; align-items: center; gap: 14rpx; padding: 14rpx 12rpx 14rpx 20rpx; }
.service-editor-head > view:first-child { min-width: 0; flex: 1; }
.service-editor-head > view:first-child text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.service-editor-head > view:first-child text:first-child { font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.service-editor-head > view:first-child text:last-child { margin-top: 3rpx; color: #746762; font-size: 17rpx; line-height: 26rpx; }
.expand-control { display: flex; min-width: 112rpx; min-height: 76rpx; align-items: center; justify-content: flex-end; gap: 10rpx; color: #b6545f; font-size: 19rpx; font-weight: 700; }
.service-chevron { width: 13rpx; height: 13rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: translateY(-3rpx) rotate(45deg); }
.service-chevron.expanded { transform: translateY(4rpx) rotate(225deg); }
.service-editor-body { display: flex; flex-direction: column; gap: 20rpx; padding: 20rpx; border-top: 1rpx solid #eee3df; background: #fffaf7; }
.service-quick-grid { display: grid; grid-template-columns:minmax(0,1.45fr) minmax(0,.75fr) minmax(0,.65fr); gap: 10rpx; }
.service-quick-grid input { min-height: 68rpx; padding: 12rpx 14rpx; }
.service-description textarea { height: 136rpx; }
.region-picker-value { display: flex; box-sizing: border-box; min-height: 72rpx; align-items: center; justify-content: space-between; gap: 12rpx; padding: 12rpx 14rpx; border: 1rpx solid #eadbd5; border-radius: 16rpx; background: #fff; color: #3f3734; font-size: 21rpx; }
.region-picker-value > text { color: #df7a68; font-size: 28rpx; }
.field-label { display: block; margin-bottom: 8rpx; color: #6f625d; font-size: 19rpx; }
.service-location-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }
.service-area-list { display: flex; flex-wrap: wrap; gap: 10rpx; }
.service-area-base,.service-area-chip { display: inline-flex; min-height: 48rpx; align-items: center; gap: 8rpx; padding: 0 16rpx; border-radius: 24rpx; background: #fff0e8; color: #785b51; font-size: 18rpx; }
.service-area-base { border: 1rpx solid #f2c8b8; }
.service-area-chip > text:last-child { display: flex; min-width: 32rpx; min-height: 40rpx; align-items: center; justify-content: center; color: #ce695e; font-size: 27rpx; }
.work-picker-trigger { display: flex; min-height: 84rpx; align-items: center; justify-content: space-between; gap: 14rpx; padding: 10rpx 14rpx; border: 1rpx solid #ecd9d3; border-radius: 18rpx; background: #fff; }
.work-picker-trigger > view:first-child { min-width: 0; }
.work-picker-trigger > view:first-child text { display: block; }
.work-picker-trigger > view:first-child text:first-child { font-size: 21rpx; font-weight: 800; }
.work-picker-trigger > view:first-child text:last-child { color: #7a6d67; font-size: 16rpx; }
.work-picker-trigger > view:last-child { display: flex; flex: 0 0 auto; align-items: center; gap: 12rpx; color: #c6536b; font-size: 18rpx; font-weight: 700; }
.danger-button { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 76rpx; align-items: center; justify-content: center; padding: 14rpx; border: 2rpx solid #e5b9bd; border-radius: 20rpx; background: #fff6f6; color: #a23f4b; box-shadow: none; font-size: 21rpx; font-weight: 700; }
.picker-mask { position: fixed; z-index: 80; inset: 0; display: flex; align-items: flex-end; background: rgba(42,31,28,.42); }
.work-picker-sheet { width: 100%; max-height: 78vh; padding: 26rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; }
.picker-head { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #eee3df; }
.picker-head > view:first-child text { display: block; }
.picker-head > view:first-child text:first-child { font-size: 28rpx; font-weight: 800; }
.picker-head > view:first-child text:last-child { margin-top: 2rpx; color: #746762; font-size: 18rpx; }
.picker-head > view:last-child { display: flex; min-width: 88rpx; min-height: 72rpx; align-items: center; justify-content: flex-end; color: #c6536b; font-size: 20rpx; font-weight: 700; }
.picker-scroll { max-height: 600rpx; }
.picker-work-row { display: grid; grid-template-columns: 84rpx minmax(0,1fr) 52rpx; min-height: 108rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #eee3df; }
.picker-work-row image,.picker-work-cover { width: 84rpx; height: 76rpx; border-radius: 16rpx; background: #ffe3d8; }
.picker-work-row > view:nth-child(2) { min-width: 0; }
.picker-work-row > view:nth-child(2) text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-work-row > view:nth-child(2) text:first-child { font-size: 22rpx; font-weight: 800; }
.picker-work-row > view:nth-child(2) text:last-child { margin-top: 4rpx; color: #8a7770; font-size: 17rpx; }
.right-check { position: relative; width: 38rpx; height: 38rpx; justify-self: end; border: 2rpx solid #cdbdb7; border-radius: 10rpx; background: #fff; }
.right-check.checked { border-color: #e86878; background: #e86878; }
.right-check.checked::after { position: absolute; top: 7rpx; left: 11rpx; width: 8rpx; height: 15rpx; border-right: 3rpx solid #fff; border-bottom: 3rpx solid #fff; content: ""; transform: rotate(45deg); }
.picker-actions { display: grid; grid-template-columns: 1fr 1.35fr; gap: 14rpx; padding-top: 18rpx; }
.picker-actions button { display: flex; min-height: 82rpx; align-items: center; justify-content: center; border: 2rpx solid #efc9c3; border-radius: 22rpx; color: #b64f5e; background: #fff; box-shadow: none; font-size: 22rpx; font-weight: 800; }
.picker-actions button:last-child { border-color: #ee7b7c; color: #fff; background: #ee7b7c; }
.dashed-button { display: flex; box-sizing: border-box; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin: 24rpx 0 0; padding: 20rpx; border: 1rpx dashed #d79a9e; border-radius: 24rpx; background: #fff; color: #c6536b; box-shadow: none; font-size: 22rpx; font-weight: 700; }
.dashed-button::after { border: 0; }
.tone-rose { background: linear-gradient(145deg,#ffe0ef,#ffd9dc); }
.tone-blue { background: linear-gradient(145deg,#dcecff,#ffd9dc); }
.portfolio-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx 14rpx; }
.portfolio-work { min-width: 0; overflow: hidden; border: 1rpx solid #eee3df; border-radius: 24rpx; background: #fff; }
.portfolio-visual { position: relative; width: 100%; height: 220rpx; overflow: hidden; background: #ffe4dd; }
.portfolio-visual > image,.portfolio-cover { display: block; width: 100%; height: 100%; }
.portfolio-pin { position: absolute; top: 8rpx; right: 8rpx; display: flex; min-width: 100rpx; min-height: 72rpx; align-items: center; justify-content: flex-end; gap: 8rpx; padding: 0 12rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 18rpx; background: rgba(255,250,248,.94); color: #895f57; font-size: 18rpx; font-weight: 700; }
.portfolio-pin .right-check { width: 30rpx; height: 30rpx; }
.portfolio-pin .right-check.checked::after { top: 4rpx; left: 8rpx; }
.portfolio-info { padding: 16rpx; }
.portfolio-title { display: block; overflow: hidden; color: #2b2523; font-size: 23rpx; font-weight: 800; line-height: 34rpx; text-overflow: ellipsis; white-space: nowrap; }
.portfolio-tags { display: flex; min-height: 40rpx; align-items: center; gap: 6rpx; margin-top: 8rpx; overflow: hidden; }
.portfolio-tag { display: block; max-width: 118rpx; height: 36rpx; padding: 0 12rpx; overflow: hidden; border-radius: 8rpx; color: #616161; background: #efedef; font-size: 20rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.portfolio-meta { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 10rpx; }
.portfolio-meta text:first-child { color: #c6536b; font-size: 22rpx; font-weight: 800; }
.portfolio-meta text:last-child { color: #7a6d67; font-size: 18rpx; }
.field-help { color: #6f625d; font-size: 20rpx; line-height: 1.5; }
.work-upload-editor { width: 100%; min-height: calc(100vh - 180rpx); }
.composer-surface { width: 100%; padding: 18rpx 8rpx 28rpx; }
.composer-media-head { display: flex; min-height: 52rpx; align-items: center; justify-content: space-between; color: #2b2523; }
.composer-media-head text:first-child { font-size: 23rpx; font-weight: 800; }
.composer-media-head text:last-child { color: #8c7e78; font-size: 19rpx; }
.composer-media-scroll { width: 100%; margin-top: 12rpx; white-space: nowrap; }
.composer-media-strip { display: inline-flex; gap: 14rpx; padding-right: 8rpx; }
.composer-image-item,.composer-add-image { position: relative; box-sizing: border-box; width: 196rpx; min-width: 196rpx; height: 196rpx; overflow: hidden; border-radius: 22rpx; }
.composer-image-item { background: #f0e8e4; }
.composer-image-item image { display: block; width: 100%; height: 100%; }
.composer-image-item > button { position: absolute; top: 0; right: 0; width: 88rpx; min-width: 88rpx; height: 88rpx; padding: 0; border: 0; color: #fff; background: radial-gradient(circle,rgba(43,37,35,.72) 0 26rpx,transparent 28rpx); box-shadow: none; font-size: 36rpx; font-weight: 300; line-height: 88rpx; }
.composer-image-item > button::after { border: 0; }
.composer-image-item > text { position: absolute; left: 10rpx; bottom: 10rpx; display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: rgba(43,37,35,.62); font-size: 17rpx; }
.composer-add-image { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; padding: 0; border: 2rpx solid #e8d9d5; background: #fffaf8; color: #786b66; box-shadow: none; font-size: 19rpx; font-weight: 700; }
.composer-add-image::after { border: 0; }
.composer-add-image > view { position: relative; width: 58rpx; height: 58rpx; }
.composer-add-image > view::before,.composer-add-image > view::after { position: absolute; top: 27rpx; left: 7rpx; width: 44rpx; height: 4rpx; border-radius: 4rpx; background: #ed7b7f; content: ""; }
.composer-add-image > view::after { transform: rotate(90deg); }
.composer-media-help { display: block; margin-top: 12rpx; color: #9a8c85; font-size: 18rpx; line-height: 28rpx; }
.composer-title,.composer-body,.composer-details,.composer-tags-field { box-sizing: border-box; width: 100%; }
.composer-title { min-height: 112rpx; margin-top: 30rpx; padding: 18rpx 0; border: 0; border-bottom: 1rpx solid #eadfda; background: transparent; color: #27211f; font-size: 40rpx; font-weight: 800; }
.composer-body { min-height: 260rpx; padding: 30rpx 0; border: 0; border-bottom: 1rpx solid #eadfda; background: transparent; color: #3f3734; font-size: 28rpx; line-height: 1.75; }
.composer-placeholder { color: #b4aaa5; font-weight: 400; }
.composer-details { display: grid; grid-template-columns: 220rpx minmax(0,1fr); min-height: 94rpx; align-items: center; border-bottom: 1rpx solid #eadfda; }
.composer-price { display: flex; min-width: 0; align-items: center; color: #c6536b; font-size: 28rpx; font-weight: 800; }
.composer-price input { min-width: 0; height: 72rpx; padding: 0 8rpx; border: 0; background: transparent; color: #c6536b; font-size: 27rpx; font-weight: 800; }
.composer-subtitle { min-width: 0; height: 72rpx; padding: 0 0 0 22rpx; border: 0; border-left: 1rpx solid #eadfda; background: transparent; color: #4c423e; font-size: 23rpx; }
.composer-tags-field { display: flex; min-height: 94rpx; align-items: center; border-bottom: 1rpx solid #eadfda; color: #c6536b; font-size: 28rpx; font-weight: 800; }
.composer-tags-field input { min-width: 0; height: 72rpx; flex: 1; padding: 0 12rpx; border: 0; background: transparent; color: #4c423e; font-size: 23rpx; font-weight: 400; }
.composer-tag-scroll { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.composer-tags { display: inline-flex; gap: 10rpx; padding-right: 8rpx; }
.composer-tags .tag-preview-item { background: #f2eeee; color: #665c58; }
.composer-foot { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 28rpx; color: #978983; font-size: 18rpx; }
.composer-preview { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 0; border: 0; border-top: 1rpx solid #eadfda; border-radius: 0; background: transparent; color: #b65261; box-shadow: none; font-size: 21rpx; font-weight: 700; text-align: left; }
.composer-preview::after { border: 0; }
.composer-preview text { font-size: 34rpx; font-weight: 400; }
.work-save-actions { position: sticky; z-index: 10; bottom: calc(18rpx + env(safe-area-inset-bottom)); margin: 12rpx 0 20rpx; padding: 12rpx; border: 1rpx solid rgba(235,216,211,.92); border-radius: 28rpx; background: rgba(255,251,248,.94); }
.two-actions { display: flex; gap: 18rpx; margin-top: 8rpx; }
.two-actions button { min-width: 0; max-width: 100%; }
.secondary-button { flex: 1; }
.primary-button { flex: 1.5; border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); color: #fff; }
.primary-button.blocked, .primary-button[disabled] { opacity: .42; box-shadow: none; }
.required-note { display: flex; align-items: flex-start; gap: 10rpx; }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; margin-top: 11rpx; border-radius: 50%; background: #d83b46; box-shadow: 0 0 0 6rpx #fff0f1; }
