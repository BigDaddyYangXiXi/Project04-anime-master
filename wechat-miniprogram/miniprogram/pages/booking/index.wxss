@import "../../styles/money.wxss";
page { background: var(--am-color-canvas); }
.booking-shell { padding: var(--am-space-6) var(--am-space-4) calc(var(--am-booking-footer-clearance) + env(safe-area-inset-bottom)); color: var(--am-color-text); }
.booking-person { display: flex; align-items: center; gap: var(--am-booking-person-gap); margin-bottom: var(--am-space-6); }
.booking-avatar { display: flex; align-items: center; justify-content: center; width: var(--am-avatar-detail-author); height: var(--am-avatar-detail-author); flex: 0 0 var(--am-avatar-detail-author); border-radius: var(--am-radius-avatar); background: var(--am-color-control-surface); }
.person-copy { flex: 1; min-width: 0; }
.person-copy text { display: block; font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); line-height: var(--am-booking-line-primary); }
.person-copy text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); }
.booking-badge { padding: var(--am-space-1) var(--am-space-2); border-radius: var(--am-radius-tag); background: var(--am-color-selected-surface); color: var(--am-color-brand); font-size: var(--am-type-micro); }
.booking-section { margin-top: var(--am-space-6); }
.booking-heading { display: flex; align-items: center; justify-content: space-between; height: var(--am-line-section-title); margin-bottom: var(--am-space-4); }
.booking-heading>text { font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.booking-heading button.edit-link { display: flex; align-items: center; justify-content: flex-end; white-space: nowrap; min-height: var(--am-touch-min); width: var(--am-booking-edit-width); min-width: var(--am-booking-edit-width); max-width: var(--am-booking-edit-width); flex-shrink: 0; text-align: right; padding: var(--am-space-none); margin: var(--am-space-none); background: var(--am-color-transparent); color: var(--am-color-brand); font-size: var(--am-booking-type-secondary); }
.booking-card { border: var(--am-work-rule); border-radius: var(--am-radius-control); padding: var(--am-space-4) var(--am-space-3); background: var(--am-color-surface); }
.summary-service { display: flex; align-items: center; gap: var(--am-space-3); }
.summary-service+.summary-service { border-top: var(--am-work-rule); margin-top: var(--am-space-4); padding-top: var(--am-space-4); }
.summary-copy { flex: 1; min-width: 0; }
.summary-copy text { display: block; color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); line-height: var(--am-booking-line-primary); overflow-wrap: anywhere; }
.summary-copy text:last-child { margin-top: var(--am-work-space-six); color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); }
.summary-service>.am-money { flex-shrink: 0; }
.summary-rows { padding: var(--am-space-none) var(--am-space-3); }
.summary-row { display: flex; gap: var(--am-space-3); align-items: center; width: 100%; min-width: 100%; max-width: 100%; min-height: var(--am-booking-row-height); padding: var(--am-booking-row-padding) var(--am-space-none); margin: var(--am-space-none); background: var(--am-color-transparent); text-align: left; }
.summary-row+.summary-row { border-top: var(--am-work-rule); }
.row-icon { width: var(--am-booking-icon); height: var(--am-booking-icon); flex-shrink: 0; }
.row-arrow { width: var(--am-space-1); height: var(--am-space-1); flex-shrink: 0; border-top: var(--am-border-control); border-right: var(--am-border-control); transform: rotate(45deg); }
.requirement-summary { font-weight: var(--am-weight-regular); display: block; font-size: var(--am-type-label); line-height: var(--am-line-body); }
.reference-summary { display: flex; align-items: center; gap: var(--am-space-2); width: 100%; min-width: 100%; max-width: 100%; min-height: var(--am-touch-min); border-top: var(--am-work-rule); margin-top: var(--am-space-4); padding-top: var(--am-space-3); background: var(--am-color-transparent); color: var(--am-color-text-secondary); text-align: left; font-size: var(--am-booking-type-secondary); }
.reference-summary text { flex: 1; }
.reference-summary .row-icon { width: var(--am-space-4); height: var(--am-space-4); }
.fee-section { border-top: var(--am-work-rule); margin-top: var(--am-space-6); padding-top: var(--am-space-6); }
.fee-item { display: flex; justify-content: space-between; gap: var(--am-space-3); margin-top: var(--am-space-3); font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); color: var(--am-color-text-secondary); }
.fee-item text:last-child { color: var(--am-color-text); flex-shrink: 0; font-variant-numeric: tabular-nums; }
.fee-total { display: flex; align-items: center; justify-content: space-between; border-top: var(--am-work-rule); margin-top: var(--am-space-4); padding-top: var(--am-space-4); margin-bottom: var(--am-space-3); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); }
.booking-hint { display: block; margin-top: var(--am-space-2); color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.booking-footer { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); border-top: var(--am-work-rule); background: var(--am-color-canvas); padding: var(--am-booking-person-gap) var(--am-space-4) calc(var(--am-booking-person-gap) + env(safe-area-inset-bottom)); }
.footer-label { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.booking-footer button.send-button { margin: var(--am-space-none); width: var(--am-booking-send-width); min-width: var(--am-booking-send-width); max-width: var(--am-booking-send-width); border-radius: var(--am-radius-pill); }
.booking-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; }
.editor-shade { position: absolute; inset: 0; background: var(--am-booking-scrim); }
.booking-sheet { position: relative; width: 100%; border-radius: var(--am-booking-sheet-radius) var(--am-booking-sheet-radius) var(--am-space-none) var(--am-space-none); background: var(--am-color-canvas); padding: var(--am-space-2) var(--am-space-4) calc(var(--am-space-6) + env(safe-area-inset-bottom)); }
.sheet-handle { width: var(--am-space-8); height: var(--am-space-1); border-radius: var(--am-radius-pill); background: var(--am-color-border); margin: var(--am-space-none) auto var(--am-space-3); }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--am-space-4); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.sheet-heading button { width: var(--am-touch-min); min-width: var(--am-touch-min); max-width: var(--am-touch-min); min-height: var(--am-touch-min); margin: var(--am-space-none); background: var(--am-color-transparent); color: var(--am-color-text-secondary); font-size: var(--am-type-page-title); }
.editor-scroll { max-height: 65vh; }
.booking-sheet .content-card { padding: var(--am-space-none); margin: var(--am-space-none); border: var(--am-border-none); border-radius: var(--am-space-none); background: var(--am-color-transparent); box-shadow: var(--am-shadow-none); }
.field { margin-top: var(--am-space-4); }
.field>text,.field-label-row>text { display: block; margin-bottom: var(--am-space-2); font-size: var(--am-booking-type-secondary); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); color: var(--am-color-text-secondary); }
.booking-sheet .am-input,.booking-sheet .am-picker,.booking-sheet .am-textarea { background: var(--am-color-control-surface); border: var(--am-work-rule); border-radius: var(--am-radius-control); font-size: var(--am-type-label); padding: var(--am-space-3); color: var(--am-color-text); }
.am-textarea { width: 100%; box-sizing: border-box; }
.date-time-row { display: flex; gap: var(--am-space-2); }
.date-time-row .field { flex: 1; min-width: 0; }
.segmented-control { display: flex; gap: var(--am-space-2); margin: var(--am-space-4) var(--am-space-none); }
.segmented-control button { flex: 1; min-width: 0; min-height: var(--am-touch-min); padding: var(--am-space-2); background: var(--am-color-control-surface); border-radius: var(--am-radius-control); color: var(--am-color-text-secondary); font-size: var(--am-type-label); }
.segmented-control button.active { color: var(--am-color-brand); background: var(--am-color-selected-surface); }
.segment-title { display: block; margin-top: var(--am-space-4); font-size: var(--am-type-label); }
.remove-segment,.dashed-button,.reference-clear { min-height: var(--am-touch-min); width: 100%; min-width: 100%; padding: var(--am-space-2); margin: var(--am-space-2) var(--am-space-none); background: var(--am-color-transparent); color: var(--am-color-brand); font-size: var(--am-type-label); }
.remove-segment { color: var(--am-color-danger); }
.service-option { display: flex; align-items: center; gap: var(--am-space-3); width: 100%; min-width: 100%; max-width: 100%; padding: var(--am-space-4) var(--am-space-3); border: var(--am-work-rule); border-radius: var(--am-radius-control); margin-top: var(--am-space-3); background: var(--am-color-surface); text-align: left; }
.service-option.selected { border-color: var(--am-color-brand); }
.service-option.unavailable { opacity: .5; }
.check-box { width: var(--am-booking-icon); height: var(--am-booking-icon); border: var(--am-border-control); border-radius: var(--am-radius-tag); flex-shrink: 0; }
.selected .check-box { background: var(--am-color-brand); }
.check-mark { width: var(--am-space-3); height: var(--am-work-space-six); border-bottom: var(--am-booking-check-border); border-left: var(--am-booking-check-border); transform: translate(var(--am-space-1),var(--am-space-1)) rotate(-45deg); }
.service-copy { flex: 1; min-width: 0; }
.service-copy text { display: block; color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.service-copy text:first-child { color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); line-height: var(--am-booking-line-primary); margin-bottom: var(--am-work-space-six); }
.service-price { flex-shrink: 0; }
.reference-upload,.referenced-work,.reference-empty { display: flex; flex-direction: column; width: 100%; min-width: 100%; padding: var(--am-space-3); background: var(--am-color-control-surface); border-radius: var(--am-radius-control); text-align: left; font-size: var(--am-type-label); }
.reference-picker .section-title text { display: block; font-size: var(--am-type-label); font-weight: var(--am-weight-medium); }
.reference-picker .section-title text:last-child,.reference-upload text:last-child,.referenced-work text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); }
.field-error,.field>text.field-error { display: block; color: var(--am-color-danger); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); margin-top: var(--am-space-3); }
.inline-required { display: none; }
.field-help { font-size: var(--am-booking-type-secondary); color: var(--am-color-text-secondary); }
.editor-save { width: 100%; min-width: 100%; max-width: 100%; border-radius: var(--am-radius-pill); margin-top: var(--am-space-6); }
.empty-retry { margin-top: var(--am-space-6); }

