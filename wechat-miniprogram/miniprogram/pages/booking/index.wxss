.booking-shell { min-height: 100vh; padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); color: #5f4a45; background: #fff8f3; }
.page-intro { padding: 20rpx 8rpx 32rpx; }.page-intro > text { display: block; }.page-title { color: #171717; font-size: 48rpx; line-height: 64rpx; font-weight: 700; }.page-copy { margin-top: 8rpx; color: #616161; font-size: 26rpx; line-height: 40rpx; }
.booking-origin-card { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; padding: 24rpx 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }.avatar { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #c4c4c7; font-weight: 700; }.booking-origin-card > view:last-child { display: flex; min-width: 0; flex-direction: column; }.booking-origin-card text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.booking-origin-card > view > text:first-child { color: #7d6b65; font-size: 20rpx; line-height: 30rpx; }.booking-origin-card > view > text:nth-child(2) { color: #171717; font-size: 28rpx; line-height: 42rpx; font-weight: 700; }.booking-origin-card > view > text:last-child { color: #7d6b65; font-size: 22rpx; line-height: 34rpx; }
.content-card { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }.section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }.section-title > text:first-child, .section-title > view text:first-child { color: #171717; font-size: 30rpx; line-height: 44rpx; font-weight: 800; }.section-title > view { display: flex; min-width: 0; flex-direction: column; }.section-title > view text:last-child { color: #7d6b65; font-size: 20rpx; line-height: 30rpx; }.section-title > text:last-child { color: #c6536b; font-size: 22rpx; font-weight: 700; }.form-stack { display: flex; flex-direction: column; gap: 30rpx; }
.field { min-width: 0; }.field > text:first-child { display: block; margin-bottom: 12rpx; color: #5f4a45; font-size: 22rpx; line-height: 34rpx; font-weight: 600; }.picker-value, .field input, .field textarea { width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; border: 1rpx solid #d9d0d9; border-radius: 22rpx; color: #171717; background: #fcfbfc; font-size: 24rpx; line-height: 40rpx; }.field textarea { height: 180rpx; }.field-help { display: block; margin-top: 8rpx; color: #8c8490; font-size: 18rpx; text-align: right; }
.segmented-control { display: grid; gap: 0; }.time-mode-control { grid-template-columns: repeat(3,minmax(0,1fr)); }.reference-mode-control { grid-template-columns: repeat(2,minmax(0,1fr)); }.segmented-control button { display: flex; width: 100%; min-width: 0; min-height: 88rpx; margin: 0; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 0; background: transparent; }.segment-surface { position: relative; display: flex; width: 100%; height: 72rpx; align-items: center; justify-content: center; border-top: 1rpx solid #e7deda; border-bottom: 1rpx solid #e7deda; color: #7d6b65; background: #fff; font-size: 24rpx; line-height: 36rpx; white-space: nowrap; }.segmented-control button:first-child .segment-surface { border-left: 1rpx solid #e7deda; border-radius: 16rpx 0 0 16rpx; }.segmented-control button + button .segment-surface { border-left: 1rpx solid #e7deda; }.segmented-control button:last-child .segment-surface { border-right: 1rpx solid #e7deda; border-radius: 0 16rpx 16rpx 0; }.segmented-control button.active .segment-surface { color: #c6536b; background: #fff0f1; font-weight: 700; }.segment-indicator { position: absolute; bottom: 4rpx; left: 50%; width: 48rpx; height: 4rpx; border-radius: 4rpx; background: #ff6f71; transform: translateX(-50%); }.segmented-control button:active .segment-surface { background: #fff6f3; }
.date-time-row { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(0,.85fr); gap: 16rpx; margin-top: 24rpx; }.segments { display: flex; flex-direction: column; gap: 16rpx; }.segment-row { display: flex; flex-direction: column; gap: 16rpx; padding: 20rpx; border: 1rpx solid #eadeda; border-radius: 20rpx; background: #fff8f3; }.segment-title { color: #171717; font-size: 26rpx; font-weight: 700; }.remove-segment { width: 100%; min-width: 100%; min-height: 88rpx; margin: 0; border-radius: 16rpx; color: #9b4c42; background: #fcebe8; }.dashed-button { width: 100%; min-width: 100%; min-height: 88rpx; margin: 0; border: 1rpx dashed #baadb9; border-radius: 28rpx; color: #c6536b; background: rgba(255,255,255,.55); font-size: 24rpx; }
.service-section-title .section-price { min-width: 120rpx; flex: 0 0 120rpx; text-align: right; font-variant-numeric: tabular-nums; }.service-option { display: grid; width: 100%; min-width: 100%; max-width: 100%; min-height: 128rpx; margin: 0; grid-template-columns: 48rpx minmax(0,1fr) 104rpx; align-items: center; gap: 20rpx; padding: 16rpx; border-top: 1rpx solid #eee; background: #fff; text-align: left; }.service-option.selected { margin: 0; padding: 16rpx; border-radius: 16rpx; background: #fff6f3; box-shadow: inset 0 0 0 1rpx #efb6b8; }.service-option.unavailable { opacity: .5; }.check-box { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 1rpx solid #aaa1ab; border-radius: 10rpx; }.selected .check-box { border-color: #ff6f71; background: #ff6f71; }.check-mark { width: 18rpx; height: 10rpx; border-bottom: 4rpx solid #fff; border-left: 4rpx solid #fff; transform: translateY(-2rpx) rotate(-45deg); }.service-copy { display: flex; min-width: 0; flex-direction: column; }.service-copy text:first-child { color: #171717; font-size: 28rpx; line-height: 42rpx; font-weight: 700; }.service-copy text:last-child { color: #616161; font-size: 24rpx; line-height: 36rpx; }.service-price { min-width: 104rpx; color: #c6536b; font-size: 28rpx; line-height: 40rpx; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
.reference-picker { display: flex; flex-direction: column; gap: 20rpx; padding-top: 6rpx; }.reference-picker .section-title { margin-bottom: 0; }.reference-upload { display: flex; width: 100%; min-width: 100%; min-height: 104rpx; margin: 0; flex-direction: column; align-items: flex-start; justify-content: center; padding: 24rpx; border: 1rpx dashed #bcaebe; border-radius: 26rpx; color: #c6536b; background: #faf8fa; text-align: left; }.reference-upload text:last-child { color: #7d6b65; font-size: 20rpx; }.referenced-work, .reference-empty { display: flex; min-height: 104rpx; flex-direction: column; justify-content: center; padding: 24rpx; border-radius: 20rpx; background: #fff6f3; }.referenced-work text:first-child, .reference-empty text:first-child { color: #171717; font-size: 26rpx; font-weight: 700; }.referenced-work text:last-child, .reference-empty text:last-child { margin-top: 6rpx; color: #7d6b65; font-size: 22rpx; }.reference-clear { min-height: 88rpx; margin: 0; color: #9b4c42; background: transparent; font-size: 22rpx; text-decoration: underline; text-underline-offset: 6rpx; }
.section-state, .inline-required, .field-label-row { display: flex; align-items: center; gap: 8rpx; }.section-state > text:last-child, .inline-required > text:last-child { color: #b5434e; font-size: 22rpx; line-height: 34rpx; font-weight: 700; }.required-dot { display: block; width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d83b46; box-shadow: 0 0 0 6rpx #fff0f1; }.service-section-title > view { display: flex; min-width: 0; flex-direction: row; align-items: center; gap: 16rpx; }.field-label-row { justify-content: space-between; margin-bottom: 12rpx; }.field-label-row > text:first-child { color: #5f4a45; font-size: 22rpx; line-height: 34rpx; font-weight: 600; }.field-label-row + textarea { margin-top: 0; }.field-error { display: block; margin-top: 8rpx; color: #b5434e; font-size: 22rpx; line-height: 34rpx; }.field-error.standalone { margin: 0 8rpx 20rpx; padding: 20rpx; border-radius: 18rpx; background: #fff0f1; }.validation-summary { display: flex; margin: 0 8rpx 20rpx; padding: 20rpx 24rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid #efb6b8; border-radius: 18rpx; color: #9b3542; background: #fff0f1; font-size: 22rpx; line-height: 34rpx; }.validation-summary > text:first-child { color: #7b2633; font-weight: 700; }
.primary-block { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin: 0; padding: 20rpx 32rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; font-size: 28rpx; line-height: 40rpx; font-weight: 700; }.primary-block.blocked, .primary-block[disabled] { opacity: .42; box-shadow: none; }
.empty-retry { display: flex; width: auto; min-height: 80rpx; margin: 24rpx auto 0; padding: 18rpx 40rpx; align-items: center; justify-content: center; border: 2rpx solid #f3b3ad; border-radius: 24rpx; color: #a64459; background: #fff4ef; font-size: 26rpx; font-weight: 700; }
@media (max-width: 340px) { .date-time-row { grid-template-columns: 1fr; }.service-option { grid-template-columns: 48rpx minmax(0,1fr); }.service-price { grid-column: 2; } }
