<app-top-nav class="app-navigation" title="确认预约" show-back="{{true}}"/>
<view wx:if="{{loadingProvider}}" class="empty-page"><text class="empty-page-title">正在读取服务方资料</text><text class="empty-page-copy">请稍候，不会提交预约。</text></view>
<view wx:elif="{{provider}}" class="booking-shell">
  <view class="page-intro"><text class="page-title">确认日期与合作范围</text><text class="page-copy">填写完成后只发送沟通邀请；服务方表达意向并主动联系，双方确认后才进入执行。</text></view>

  <view class="booking-origin-card"><view class="avatar">{{provider.initial}}</view><view><text>当前服务方</text><text>{{provider.name}} · {{provider.career}}</text><text>{{selectedServiceText || '请选择服务项目'}}</text></view></view>

  <view class="content-card form-stack"><view class="section-title"><view><text>地域与合作时间</text><text>必填；连续时段可跨日</text></view><view class="section-state"><text wx:if="{{!timeValid}}" class="required-dot"></text><text>{{timeValid ? provider.career : '待完善'}}</text></view></view><view class="field"><text>服务城市</text><picker mode="region" bindchange="updateCity"><view class="picker-value">{{city || '请选择服务城市'}}</view></picker></view><view class="segmented-control time-mode-control"><button wx:for="{{timeModes}}" wx:key="id" class="{{timeMode === item.id ? 'active' : ''}}" data-mode="{{item.id}}" bindtap="chooseTimeMode"><view class="segment-surface"><text>{{item.label}}</text><view wx:if="{{timeMode === item.id}}" class="segment-indicator"></view></view></button></view>
    <view wx:if="{{timeMode === 'day'}}" class="field"><text>服务日期</text><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="updateDate"><view class="picker-value">{{date}}</view></picker></view>
    <view wx:elif="{{timeMode === 'segments'}}" class="segments"><view wx:for="{{segments}}" wx:key="id" class="segment-row"><text class="segment-title">时段 {{index + 1}}</text><view class="date-time-row"><view class="field"><text>开始日期</text><picker mode="date" value="{{item.startDate}}" start="{{minDate}}" data-id="{{item.id}}" data-key="startDate" bindchange="updateSegment"><view class="picker-value">{{item.startDate}}</view></picker></view><view class="field"><text>开始时间</text><picker mode="time" value="{{item.startTime}}" data-id="{{item.id}}" data-key="startTime" bindchange="updateSegment"><view class="picker-value">{{item.startTime}}</view></picker></view></view><view class="date-time-row"><view class="field"><text>结束日期</text><picker mode="date" value="{{item.endDate}}" start="{{minDate}}" data-id="{{item.id}}" data-key="endDate" bindchange="updateSegment"><view class="picker-value">{{item.endDate}}</view></picker></view><view class="field"><text>结束时间</text><picker mode="time" value="{{item.endTime}}" data-id="{{item.id}}" data-key="endTime" bindchange="updateSegment"><view class="picker-value">{{item.endTime}}</view></picker></view></view><button class="remove-segment" disabled="{{segments.length === 1}}" data-id="{{item.id}}" bindtap="removeSegment">删除时段</button></view><button class="dashed-button" bindtap="addSegment">＋ 增加一个时段</button></view>
    <view wx:else><view class="date-time-row"><view class="field"><text>开始日期</text><picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="updateStartDate"><view class="picker-value">{{startDate}}</view></picker></view><view class="field"><text>开始时间</text><picker mode="time" value="{{startTime}}" bindchange="updateStartTime"><view class="picker-value">{{startTime}}</view></picker></view></view><view class="date-time-row"><view class="field"><text>结束日期</text><picker mode="date" value="{{endDate}}" start="{{minDate}}" bindchange="updateEndDate"><view class="picker-value">{{endDate}}</view></picker></view><view class="field"><text>结束时间</text><picker mode="time" value="{{endTime}}" bindchange="updateEndTime"><view class="picker-value">{{endTime}}</view></picker></view></view></view>
    <text wx:if="{{timeError && showValidationErrors}}" class="field-error">{{timeError}}</text>
  </view>

  <view class="content-card"><view class="section-title service-section-title"><view><text>本次预约服务</text><view wx:if="{{!serviceValid}}" class="inline-required"><text class="required-dot"></text><text>待完善</text></view></view><text class="section-price">￥{{displayedTotal}}</text></view><button wx:for="{{provider.services}}" wx:key="id" class="service-option {{item.selected ? 'selected' : ''}} {{item.availableInCity === false ? 'unavailable' : ''}}" data-id="{{item.id}}" bindtap="toggleService"><view class="check-box"><view wx:if="{{item.selected}}" class="check-mark"></view></view><view class="service-copy"><text>{{item.name}}</text><text>{{item.availableInCity === false ? '该服务暂不覆盖当前城市' : item.description}}</text><text>{{item.serviceLocationText}}</text></view><text class="service-price">{{item.priceText}}</text></button><text wx:if="{{showValidationErrors && !serviceValid}}" class="field-error">请选择一项覆盖当前城市或支持线上的服务。</text></view>

  <view class="content-card form-stack"><view class="section-title"><view><text>需求方联系方式</text><text>姓名必填；微信或手机号至少填写一项</text></view><view class="section-state"><text wx:if="{{!contactValid}}" class="required-dot"></text><text>{{contactValid ? '已完成' : '待完善'}}</text></view></view><view class="field"><text>姓名</text><input data-key="name" value="{{contact.name}}" placeholder="服务方联系时如何称呼你" bindinput="updateContact" /><text wx:if="{{showValidationErrors && !contactNameValid}}" class="field-error">请填写联系人称呼。</text></view><view class="field"><text>微信号</text><input data-key="wechat" value="{{contact.wechat}}" placeholder="微信或手机至少填写一项" bindinput="updateContact" /></view><view class="field"><text>手机号</text><input data-key="phone" type="number" maxlength="11" value="{{contact.phone}}" placeholder="11 位手机号" bindinput="updateContact" /><text wx:if="{{showValidationErrors && !contactMethodValid}}" class="field-error">请填写微信号或有效的 11 位手机号。</text></view></view>

  <view class="content-card form-stack"><view class="field"><view class="field-label-row"><text>个性化需求（必填）</text><view wx:if="{{!noteValid}}" class="inline-required"><text class="required-dot"></text><text>待完善</text></view></view><textarea value="{{note}}" maxlength="500" placeholder="至少 10 个字，说明角色、风格、现场条件或交付偏好" bindinput="updateNote"></textarea><text class="field-help">{{note.length}}/500</text><text wx:if="{{showValidationErrors && !noteValid}}" class="field-error">个性化需求至少填写 10 个字。</text></view><view class="reference-picker"><view class="section-title"><view><text>参考资料（选填）</text><text>引用作品或上传一张图片，两种方式互斥</text></view></view><view class="segmented-control reference-mode-control"><button class="{{referenceMode === 'work' ? 'active' : ''}}" data-mode="work" bindtap="chooseReference"><view class="segment-surface"><text>引用作品</text><view wx:if="{{referenceMode === 'work'}}" class="segment-indicator"></view></view></button><button class="{{referenceMode === 'file' ? 'active' : ''}}" data-mode="file" bindtap="chooseReference"><view class="segment-surface"><text>上传图片</text><view wx:if="{{referenceMode === 'file'}}" class="segment-indicator"></view></view></button></view><button wx:if="{{referenceMode === 'file'}}" class="reference-upload" bindtap="chooseReferenceFile"><text>{{referenceFile ? referenceFile.name : '选择一张参考图片'}}</text><text>选择后会清除作品引用。</text></button><view wx:elif="{{referenceMode === 'work' && work}}" class="referenced-work"><text>{{work.title}}</text><text>{{work.code}}</text></view><view wx:else class="reference-empty"><text>本次不提供参考资料</text><text>服务方将只根据你的文字需求判断是否沟通。</text></view><button wx:if="{{referenceMode}}" class="reference-clear" bindtap="clearReference">清除参考资料</button></view></view>

  <view wx:if="{{showValidationErrors && validationIssues.length}}" class="validation-summary"><text>还不能发送，请完成：</text><text wx:for="{{validationIssues}}" wx:key="*this">· {{item}}</text></view><text wx:if="{{message}}" class="field-error standalone">{{message}}</text><button class="primary-block {{!canSubmit ? 'blocked' : ''}}" disabled="{{submitting}}" aria-disabled="{{!canSubmit}}" bindtap="submitBooking">{{submitting ? '正在发送…' : '发送预约沟通邀请 · ￥' + displayedTotal}}</button>
</view>
<view wx:else class="empty-page"><text class="empty-page-title">没有找到可预约的服务方</text><text class="empty-page-copy">{{message || '该橱窗可能尚未发布或已经下线。'}}</text><button wx:if="{{message}}" class="empty-retry" bindtap="retryLoad">重新加载</button></view>
