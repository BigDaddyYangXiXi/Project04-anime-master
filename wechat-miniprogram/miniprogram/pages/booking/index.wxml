<app-top-nav class="app-navigation" title="确认预约" show-back="{{true}}"/>
<block wx:if="{{loadingProvider}}"></block>
<view wx:elif="{{provider}}" class="booking-shell">
  <view class="booking-person"><image wx:if="{{provider.avatar}}" class="booking-avatar" src="{{provider.avatar}}" mode="aspectFill"/><view wx:else class="booking-avatar">{{provider.initial}}</view><view class="person-copy"><text>{{provider.name}}</text><text>{{provider.career}} · {{provider.city}}</text></view><text class="booking-badge">预约沟通</text></view>
  <view class="booking-section"><view class="booking-heading"><text>本次服务</text><button hover-class="none" class="edit-link" data-section="services" bindtap="openEditor">更改服务</button></view><view class="booking-card"><view wx:for="{{selectedServices}}" wx:key="id" class="summary-service"><view class="summary-copy"><text>{{item.name}}</text><text>{{item.description}} · 按{{item.unit}}计价</text></view><text class="am-money am-money-list">{{item.priceText}}</text></view><text wx:if="{{!selectedServices.length}}" class="booking-hint">请选择服务</text></view></view>
  <view class="booking-section"><view class="booking-heading"><text>地点与时间</text></view><view class="booking-card summary-rows"><button hover-class="none" class="summary-row" data-section="place" bindtap="openEditor"><image class="row-icon" src="/assets/booking/location.svg"/><view class="summary-copy"><text>{{city || '选择服务城市'}}</text><text>服务地点</text></view><view class="row-arrow"></view></button><button hover-class="none" class="summary-row" data-section="time" bindtap="openEditor"><image class="row-icon" src="/assets/booking/time.svg"/><view class="summary-copy"><text>{{timeValid ? timeDisplay : '选择合作时间'}}</text><text>{{timeMode === 'day' ? '全天预约' : timeMode === 'segments' ? '多个时段' : '连续时段'}}</text></view><view class="row-arrow"></view></button></view></view>
  <view class="booking-section"><view class="booking-heading"><text>你的需求</text><button hover-class="none" class="edit-link" data-section="note" bindtap="openEditor">{{note ? '编辑' : '填写需求'}}</button></view><view class="booking-card"><text class="requirement-summary">{{note || '待填写角色、风格或现场要求'}}</text><button hover-class="none" class="reference-summary" data-section="reference" bindtap="openEditor"><image class="row-icon" src="/assets/booking/image.svg"/><text>{{referenceMode === 'work' && work ? '参考作品 · ' + work.title : referenceFile ? referenceFile.name : '添加参考资料（选填）'}}</text><view class="row-arrow"></view></button></view></view>
  <view class="booking-section"><view class="booking-heading"><text>保密要求</text></view><view class="booking-card"><view class="summary-row"><view class="summary-copy"><text>先签署保密协议</text><text>开启后，双方签署前隐藏详细需求、具体地址、私人参考图及补充正文。</text></view><switch checked="{{ndaRequired}}" disabled="{{submitting}}" color="{{ndaSwitchColor}}" bindchange="changeNda"/></view><text class="booking-hint">{{ndaRequired ? '服务方同意沟通后，先签署再查看保密内容。' : '本次不要求签署 NDA，服务方可查看提交的需求。'}}</text></view></view>
  <view class="booking-section"><view class="booking-heading"><text>联系信息</text></view><view class="booking-card summary-rows"><button hover-class="none" class="summary-row" data-section="contact" bindtap="openEditor"><image class="row-icon" src="/assets/booking/user.svg"/><view class="summary-copy"><text>{{contact.name || '填写联系人'}}</text><text>{{contact.wechat ? '微信 · ' + contact.wechat : contact.phone || '微信或手机号至少填写一项'}}</text></view><view class="row-arrow"></view></button></view></view>
  <view class="fee-section"><view class="booking-heading"><text>费用核对</text></view><view wx:for="{{selectedServices}}" wx:key="id" class="fee-item"><text>{{item.name}}</text><text>{{item.priceText}}</text></view><view class="fee-total"><text>服务参考合计</text><text class="am-money am-money-detail">￥{{displayedTotal}}</text></view><text class="booking-hint">服务范围与最终费用将在双方确认合作时核对。</text><text class="booking-hint payment-timing">此步无需付款，待双方确认合作后支付</text></view>
  <text wx:if="{{message}}" class="field-error">{{message}}</text>
  <view class="booking-footer"><view><text class="footer-label">服务参考合计</text><text class="am-money am-money-detail">￥{{displayedTotal}}</text></view><button aria-disabled="{{submitting}}" hover-class="none" class="send-button am-action am-action-primary" data-am-disabled="{{submitting}}" bindtap="{{(submitting) ? '' : 'submitBooking'}}">{{submitting ? '正在发送…' : '发送预约邀请'}}</button></view>
</view>
<view wx:else class="empty-page"><text class="empty-page-title">{{message ? '预约资料暂不可用' : '没有找到可预约的服务方'}}</text><text class="empty-page-copy">{{message || '该橱窗可能尚未发布或已经下线。'}}</text><button hover-class="none" wx:if="{{message}}" class="empty-retry am-action am-action-secondary" bindtap="retryLoad">重新加载</button></view>

<view wx:if="{{editorSection}}" class="booking-overlay {{sheetKeyboardHeight ? 'am-keyboard-open' : ''}}" style="bottom: {{sheetKeyboardHeight}}px; top: {{sheetKeyboardHeight ? sheetSafeTop : 0}}px"><view class="editor-shade" catchtouchmove="preventSheetBackgroundScroll" bindtap="cancelEditor"></view><view class="booking-sheet am-input-sheet"><view class="sheet-handle"></view><view class="sheet-heading" catchtouchmove="preventSheetBackgroundScroll"><text>{{editorTitle}}</text><button hover-class="none" bindtap="cancelEditor" aria-label="取消编辑">×</button></view><scroll-view scroll-y class="editor-scroll am-sheet-scroll" scroll-into-view="{{sheetScrollTarget}}"><view wx:if="{{editorSection === 'place'}}"><view class="field"><text>服务城市</text><picker mode="region" bindchange="updateCity"><view class="picker-value am-picker">{{city || '请选择服务城市'}}</view></picker></view></view><view wx:if="{{editorSection === 'time'}}"><view class="content-card form-stack"><view class="segmented-control time-mode-control"><button hover-class="none" wx:for="{{timeModes}}" wx:key="id" class="{{timeMode === item.id ? 'active' : ''}}" data-mode="{{item.id}}" bindtap="chooseTimeMode"><view class="segment-surface"><text>{{item.label}}</text><view wx:if="{{timeMode === item.id}}" class="segment-indicator"></view></view></button></view>
    <view wx:if="{{timeMode === 'day'}}" class="field"><text>服务日期</text><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="updateDate"><view class="picker-value am-picker">{{date}}</view></picker></view>
    <view wx:elif="{{timeMode === 'segments'}}" class="segments"><view wx:for="{{segments}}" wx:key="id" class="segment-row"><text class="segment-title">时段 {{index + 1}}</text><view class="date-time-row"><view class="field"><text>开始日期</text><picker mode="date" value="{{item.startDate}}" start="{{minDate}}" data-id="{{item.id}}" data-key="startDate" bindchange="updateSegment"><view class="picker-value am-picker">{{item.startDate}}</view></picker></view><view class="field"><text>开始时间</text><picker mode="time" value="{{item.startTime}}" data-id="{{item.id}}" data-key="startTime" bindchange="updateSegment"><view class="picker-value am-picker">{{item.startTime}}</view></picker></view></view><view class="date-time-row"><view class="field"><text>结束日期</text><picker mode="date" value="{{item.endDate}}" start="{{minDate}}" data-id="{{item.id}}" data-key="endDate" bindchange="updateSegment"><view class="picker-value am-picker">{{item.endDate}}</view></picker></view><view class="field"><text>结束时间</text><picker mode="time" value="{{item.endTime}}" data-id="{{item.id}}" data-key="endTime" bindchange="updateSegment"><view class="picker-value am-picker">{{item.endTime}}</view></picker></view></view><button aria-disabled="{{segments.length === 1}}" hover-class="none" class="remove-segment" data-am-disabled="{{segments.length === 1}}" data-id="{{item.id}}" bindtap="{{(segments.length === 1) ? '' : 'removeSegment'}}">删除时段</button></view><button hover-class="none" class="dashed-button" bindtap="addSegment">＋ 增加一个时段</button></view>
    <view wx:else><view class="date-time-row"><view class="field"><text>开始日期</text><picker mode="date" value="{{startDate}}" start="{{minDate}}" bindchange="updateStartDate"><view class="picker-value am-picker">{{startDate}}</view></picker></view><view class="field"><text>开始时间</text><picker mode="time" value="{{startTime}}" bindchange="updateStartTime"><view class="picker-value am-picker">{{startTime}}</view></picker></view></view><view class="date-time-row"><view class="field"><text>结束日期</text><picker mode="date" value="{{endDate}}" start="{{minDate}}" bindchange="updateEndDate"><view class="picker-value am-picker">{{endDate}}</view></picker></view><view class="field"><text>结束时间</text><picker mode="time" value="{{endTime}}" bindchange="updateEndTime"><view class="picker-value am-picker">{{endTime}}</view></picker></view></view></view>
    <text wx:if="{{timeError && showValidationErrors}}" class="field-error">{{timeError}}</text>
  </view></view><view wx:if="{{editorSection === 'services'}}"><view class="content-card"><button hover-class="none" wx:for="{{provider.services}}" wx:key="id" class="service-option {{item.selected ? 'selected' : ''}} {{item.availableInCity === false ? 'unavailable' : ''}}" data-id="{{item.id}}" bindtap="toggleService"><view class="check-box"><view wx:if="{{item.selected}}" class="check-mark"></view></view><view class="service-copy"><text>{{item.name}}</text><text>{{item.availableInCity === false ? '该服务暂不覆盖当前城市' : item.description}}</text><text>{{item.serviceLocationText}}</text></view><text class="am-money am-money-list service-price">{{item.priceText}}</text></button><text wx:if="{{showValidationErrors && !serviceValid}}" class="field-error">请选择一项覆盖当前城市或支持线上的服务。</text></view></view><view wx:if="{{editorSection === 'contact'}}"><view class="content-card form-stack"><view class="field" id="contact-name"><text>姓名</text><input class="am-input" data-field="contact-name" adjust-position="{{false}}" bindfocus="sheetInputFocus" bindkeyboardheightchange="sheetKeyboardChange" data-key="name" value="{{contact.name}}" placeholder="服务方联系时如何称呼你" bindinput="updateContact" /><text wx:if="{{showValidationErrors && !contactNameValid}}" class="field-error">请填写联系人称呼。</text></view><view class="field" id="contact-wechat"><text>微信号</text><input class="am-input" data-field="contact-wechat" adjust-position="{{false}}" bindfocus="sheetInputFocus" bindkeyboardheightchange="sheetKeyboardChange" data-key="wechat" value="{{contact.wechat}}" placeholder="微信或手机至少填写一项" bindinput="updateContact" /></view><view class="field" id="contact-phone"><text>手机号</text><input class="am-input" data-field="contact-phone" adjust-position="{{false}}" bindfocus="sheetInputFocus" bindkeyboardheightchange="sheetKeyboardChange" data-key="phone" type="number" maxlength="11" value="{{contact.phone}}" placeholder="11 位手机号" bindinput="updateContact" /><text wx:if="{{showValidationErrors && !contactMethodValid}}" class="field-error">请填写微信号或有效的 11 位手机号。</text></view></view></view><view wx:if="{{editorSection === 'note'}}"><view class="content-card form-stack"><view class="field" id="note-input"><view class="field-label-row"><text>个性化需求（必填）</text><view wx:if="{{!noteValid}}" class="inline-required"><text class="required-dot"></text><text>待完善</text></view></view><textarea class="am-textarea" data-field="note-input" adjust-position="{{false}}" bindfocus="sheetInputFocus" bindkeyboardheightchange="sheetKeyboardChange" value="{{note}}" maxlength="500" placeholder="至少 10 个字，说明角色、风格、现场条件或交付偏好" bindinput="updateNote"></textarea><text class="field-help">{{note.length}}/500</text><text wx:if="{{showValidationErrors && !noteValid}}" class="field-error">个性化需求至少填写 10 个字。</text></view></view></view><view wx:if="{{editorSection === 'reference'}}"><view class="reference-picker"><view class="section-title"><view><text>参考资料（选填）</text><text>参考作品或上传一张图片，两种方式互斥</text></view></view><view class="segmented-control reference-mode-control"><button hover-class="none" class="{{referenceMode === 'work' ? 'active' : ''}}" data-mode="work" bindtap="chooseReference"><view class="segment-surface"><text>参考作品</text><view wx:if="{{referenceMode === 'work'}}" class="segment-indicator"></view></view></button><button hover-class="none" class="{{referenceMode === 'file' ? 'active' : ''}}" data-mode="file" bindtap="chooseReference"><view class="segment-surface"><text>上传图片</text><view wx:if="{{referenceMode === 'file'}}" class="segment-indicator"></view></view></button></view><button hover-class="none" wx:if="{{referenceMode === 'file'}}" class="reference-upload" bindtap="chooseReferenceFile"><text>{{referenceFile ? referenceFile.name : '选择一张参考图片'}}</text><text>选择后会清除作品参考。</text></button><view wx:elif="{{referenceMode === 'work' && work}}" class="referenced-work"><text>{{work.title}}</text><text>{{work.code}}</text></view><view wx:else class="reference-empty"><text>本次不提供参考资料</text><text>服务方将只根据你的文字需求判断是否沟通。</text></view><button hover-class="none" wx:if="{{referenceMode}}" class="reference-clear" bindtap="clearReference">清除参考资料</button></view></view><text wx:if="{{editorError && (editorSection === 'place' || editorSection === 'reference')}}" class="field-error">{{editorError}}</text><button hover-class="none" class="editor-save am-action am-action-primary" bindtap="saveEditor">保存</button></scroll-view></view></view>
