.hero-card{position:relative;overflow:hidden;margin:10rpx 0 24rpx;padding:30rpx;border:1rpx solid #f0dcd4;border-radius:38rpx;background:linear-gradient(145deg,#fff8f3,#fff 62%,#fff1ec)}.hero-logo{position:absolute;z-index:1;top:-18rpx;right:-20rpx;width:250rpx;height:250rpx;border-radius:50%;opacity:.18}.hero-copy{position:relative;z-index:2;max-width:560rpx}.hero-copy text{display:block}.hero-title{margin-top:0;font-size:38rpx;font-weight:800;line-height:52rpx}.hero-desc{margin-top:8rpx;color:#6f625d;font-size:23rpx;line-height:38rpx}.primary-actions{position:relative;z-index:2;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:24rpx}.main-action{display:flex;min-width:0;min-height:104rpx;align-items:center;gap:14rpx;padding:14rpx 16rpx;border:2rpx solid #efc9c3;border-radius:24rpx;background:rgba(255,255,255,.96);text-align:left}.main-action.selected-action{border-color:#e96e82;color:#fff;background:linear-gradient(90deg,#f38a8e,#e96e82)}.action-mark,.upload-mark{display:flex;width:44rpx;height:44rpx;flex:0 0 44rpx;align-items:center;justify-content:center;border-radius:14rpx;color:#bd5662;background:#fff2ef;font-size:23rpx;font-weight:800}.selected-action .action-mark,.selected-action .upload-mark{color:#c6536b;background:rgba(255,255,255,.92)}.upload-mark{position:relative}.upload-mark view{position:absolute;border-radius:999rpx;background:#e86d67}.upload-mark view:first-child{width:22rpx;height:4rpx}.upload-mark view:last-child{width:4rpx;height:22rpx}.action-copy{min-width:0}.action-copy text{display:block}.action-copy text:first-child{font-size:23rpx;font-weight:800;line-height:32rpx}.action-copy text:last-child{margin-top:2rpx;color:#7a6964;font-size:16rpx;line-height:24rpx}.selected-action .action-copy text:last-child{color:rgba(255,255,255,.86)}.preview-button{position:relative;z-index:2;display:flex;width:100%;min-width:100%;max-width:100%;min-height:80rpx;align-items:center;justify-content:space-between;gap:12rpx;margin-top: