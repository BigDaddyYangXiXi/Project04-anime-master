.me-shell { padding: var(--am-space-2) var(--am-page-gutter) calc(var(--am-nav-bottom-content) + var(--am-space-4) + env(safe-area-inset-bottom)); }
page .me-shell button { width: 100%; margin: var(--am-space-none); border: var(--am-border-none); border-radius: var(--am-radius-tag); background: var(--am-color-transparent); color: var(--am-color-text); text-align: left; font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); }
page .me-shell .profile-head { display: flex; align-items: center; gap: var(--am-space-3); min-height: var(--am-touch-min); padding: var(--am-space-3) var(--am-space-none) var(--am-space-4); }
.avatar { display: block; width: var(--am-avatar-detail-author); height: var(--am-avatar-detail-author); flex: 0 0 var(--am-avatar-detail-author); border-radius: var(--am-radius-avatar); background: var(--am-color-control-surface); }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--am-color-brand); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-role { display: block; margin-top: var(--am-space-1); font-size: var(--am-type-caption); line-height: var(--am-line-caption); color: var(--am-color-text-secondary); }
.profile-edit { display: flex; align-items: center; gap: var(--am-space-1); flex-shrink: 0; font-size: var(--am-type-caption); color: var(--am-color-text-secondary); }
.chevron { width: var(--am-browse-arrow-size); height: var(--am-browse-arrow-size); flex: 0 0 var(--am-browse-arrow-size); }
.me-panel { margin-bottom: var(--am-space-3); padding: var(--am-space-3) var(--am-space-4); border-radius: var(--am-radius-card); background: var(--am-color-surface); }
.stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--am-space-3); }
.stat { min-width: 0; text-align: center; padding: var(--am-space-none) var(--am-space-1); }
.stat + .stat { border-left: var(--am-border-control); }
.stat:nth-child(3n + 1) { border-left: var(--am-border-none); }
.stat-value { display: block; font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-page-title); }
.stat-label { display: block; margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.entry-title { font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); line-height: var(--am-line-body); }
page .me-shell .collection-entry { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: var(--am-touch-min); padding: var(--am-space-none) var(--am-space-1); }
page .me-shell .collection-entry + .collection-entry { border-left: var(--am-border-control); border-radius: var(--am-space-none); }
.row-icon { display: block; width: var(--am-icon-control); height: var(--am-icon-control); flex: 0 0 var(--am-icon-control); }
page .me-shell .utility-row { display: flex; align-items: center; gap: var(--am-space-3); min-height: var(--am-touch-min); padding: var(--am-space-none); }
.row-copy { flex: 1; min-width: 0; }
.row-title { display: block; font-size: var(--am-type-label); line-height: var(--am-line-label); }
.row-note { display: block; margin-top: var(--am-space-1); font-size: var(--am-type-caption); line-height: var(--am-line-caption); color: var(--am-color-text-secondary); }
.me-error { display: flex; align-items: center; gap: var(--am-space-3); margin-bottom: var(--am-space-3); padding: var(--am-space-3) var(--am-space-4); border: var(--am-border-control); border-radius: var(--am-radius-card); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.me-error > text { flex: 1; }
page .me-shell .me-retry { width: auto; min-width: var(--am-touch-min); min-height: var(--am-touch-min); color: var(--am-color-brand); padding: var(--am-space-none); }
.me-pressed { opacity: var(--am-opacity-pressed); }
.asset-footer { margin-top: var(--am-space-2); border-top: var(--am-border-control); padding-top: var(--am-space-1); }
.paired-footer { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
page .me-shell .footer-action { min-height: var(--am-touch-min); padding: var(--am-space-2); text-align: center; font-size: var(--am-type-caption); }
.footer-action + .footer-action { border-left: var(--am-border-control); }
.recent-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--am-type-caption); }
.trade-tools { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
page .me-shell .attention-row { border-top: var(--am-border-control); border-radius: var(--am-space-none); margin-top: var(--am-space-2); padding: var(--am-space-2) var(--am-space-none); }
.utilities-panel { padding-top: var(--am-space-none); padding-bottom: var(--am-space-none); }
page .me-shell .utilities-panel .utility-row { padding: var(--am-space-2) var(--am-space-none); }
.utilities-panel .utility-row + .utility-row { border-top: var(--am-border-control); }


page .me-shell .buyer-tool { display: flex; flex-direction: column; align-items: center; gap: var(--am-space-1); min-height: var(--am-touch-min); padding: var(--am-space-1) var(--am-space-none); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }

.asset-footer .row-note, .attention-row .row-note { margin-top: var(--am-space-none); }
