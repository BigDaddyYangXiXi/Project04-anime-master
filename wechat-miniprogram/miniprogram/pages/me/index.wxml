<app-top-nav class="app-navigation" title="我的" show-back="{{false}}" show-role-switch="{{true}}" role-text="{{role === 'provider' ? '服务方' : '需求方'}}" bindroleswitch="switchIdentity"/>
<view class="me-shell">
  <button hover-class="none" class="profile-head" bindtap="editAccount" aria-label="修改头像和昵称"><image wx:if="{{account.avatar}}" class="avatar" src="{{account.avatar}}" mode="aspectFill"/><view wx:else class="avatar avatar-fallback">{{initial}}</view><view class="profile-copy"><text class="profile-name">{{account.nickname || '我的账号'}}</text><text wx:if="{{account.username}}" class="profile-role">@{{account.username}}</text></view><view class="profile-edit"><text>编辑资料</text><image class="chevron" src="/assets/me/chevron.svg"/></view></button>
  <view wx:if="{{dashboardError}}" class="me-error" role="alert"><text>{{dashboardError}}</text><button hover-class="none" class="me-retry" aria-disabled="{{dashboardLoading}}" data-am-disabled="{{dashboardLoading}}" bindtap="{{(dashboardLoading) ? '' : 'retryDashboard'}}">重试</button></view>
  <view class="me-panel"><view class="stats-grid"><button hover-class="none" wx:for="{{role === 'buyer' ? buyerHighlights : providerHighlights}}" wx:key="key" class="stat collection-entry" data-type="{{item.key}}" bindtap="openHighlight"><text class="stat-value">{{item.value}}</text><text class="stat-label">{{item.label}}</text></button></view></view>
  <view class="me-panel business-panel">
    <button hover-class="none" class="utility-row" bindtap="openBusiness"><image class="row-icon" src="{{role === 'buyer' ? '/assets/me/projects.svg' : '/assets/me/storefront.svg'}}"/><view class="row-copy"><text class="entry-title">{{role === 'buyer' ? '项目管理' : '橱窗管理'}}</text><text class="row-note">{{role === 'buyer' ? projectText : (previewMeta || (dashboardError ? '橱窗暂不可用' : '正在读取橱窗'))}}</text></view><text wx:if="{{role === 'provider'}}" class="row-note">{{storefrontStatusText}}</text><image class="chevron" src="/assets/me/chevron.svg"/></button>
    <view class="asset-footer" wx:if="{{role === 'buyer'}}"><button hover-class="none" class="utility-row" bindtap="openRecentProject"><text class="row-note">{{recentProject ? '最近编辑' : '开始整理'}}</text><text class="row-copy recent-title">{{recentProject ? recentProject.title : (projectReady ? '创建第一个项目' : '查看项目')}}</text><image class="chevron" src="/assets/me/chevron.svg"/></button></view>
    <view class="asset-footer paired-footer" wx:else><button hover-class="none" class="footer-action" bindtap="openCalendar">档期管理</button><button hover-class="none" class="footer-action" bindtap="previewStorefront">橱窗预览</button></view>
  </view>
  <view class="me-panel"><view class="trade-tools"><button hover-class="none" class="buyer-tool" bindtap="openFunds"><image class="row-icon" src="/assets/me/funds.svg"/><text>资金</text></button><button hover-class="none" class="buyer-tool" bindtap="openBuyerOrders"><image class="row-icon" src="/assets/me/orders.svg"/><text>订单</text></button><button hover-class="none" class="buyer-tool" data-mode="coops" bindtap="openActivity"><image class="row-icon" src="/assets/me/cooperation.svg"/><text>合作</text></button><button hover-class="none" class="buyer-tool" bindtap="openReviews"><image class="row-icon" src="/assets/me/reviews.svg"/><text>评价</text></button></view><button hover-class="none" class="utility-row attention-row" data-mode="todo" bindtap="openTodo"><text class="row-copy row-note">{{todoText}}</text><image class="chevron" src="/assets/me/chevron.svg"/></button></view>
  <view class="me-panel utilities-panel"><button hover-class="none" wx:if="{{role === 'buyer'}}" class="utility-row" bindtap="openHomePreferences"><image class="row-icon" src="/assets/me/preferences.svg"/><text class="row-copy row-title">广场偏好</text><image class="chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" wx:else class="utility-row" data-type="liked" bindtap="openAssets"><image class="row-icon" src="/assets/me/liked.svg"/><text class="row-copy row-title">喜欢与关注</text><image class="chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="utility-row" bindtap="openHelp"><image class="row-icon" src="/assets/me/help.svg"/><text class="row-copy row-title">帮助与反馈</text><image class="chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="utility-row" bindtap="openSettings"><image class="row-icon" src="/assets/me/settings.svg"/><text class="row-copy row-title">设置</text><image class="chevron" src="/assets/me/chevron.svg"/></button></view>
</view>
