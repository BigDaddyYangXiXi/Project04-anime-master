<app-top-nav class="app-navigation" title="评价管理" workspace="provider" show-back="{{true}}"/>
<view class="am-editor-form reviews-shell">
  <view class="rating-overview"><text>{{rating}}</text><text>综合评分／5</text><text>{{reviews.length ? reviews.length + ' 条完成订单评价' : '暂无完成订单评价'}}</text><text>{{ratingBoundary}}</text></view>
  <block wx:if="{{loading}}"></block>
  <view wx:elif="{{loadError}}" class="empty-state"><text>{{loadError}}</text><button hover-class="none" bindtap="retryLoad">重新加载</button></view>
  <view wx:for="{{reviews}}" wx:key="id" class="review-card">
    <view class="review-head"><view class="avatar">{{item.buyer[0]}}</view><view><text>{{item.buyer}} · {{item.rating}} 星</text><text>{{item.id}} · {{item.service}}</text></view></view>
    <text class="review-copy">{{item.reviewText || '需求方未填写补充文字。'}}</text>
    <view wx:if="{{item.reviewReply}}" class="public-reply"><text>服务方公开回复</text><text>{{item.reviewReply}}</text></view>
    <block wx:else>
      <button aria-disabled="{{!!pendingId}}" hover-class="none" class="reply-toggle" data-id="{{item.id}}" bindtap="{{(!!pendingId) ? '' : 'toggleReply'}}" aria-expanded="{{editingReplyId === item.id}}" data-am-disabled="{{!!pendingId}}">{{editingReplyId === item.id ? '收起回复' : drafts[item.id] ? '继续编辑回复' : '回复评价'}}</button>
      <view wx:if="{{editingReplyId === item.id}}" class="reply-editor"><text>公开回复</text><textarea class="am-textarea" value="{{drafts[item.id]}}" data-id="{{item.id}}" maxlength="200" placeholder="感谢认可，也欢迎下次继续合作" bindinput="update"/><text>{{drafts[item.id] ? drafts[item.id].length : 0}}/200 · 发布后同步到需求方评价页且不可修改</text><view wx:if="{{!drafts[item.id]}}" class="required-note"><view class="required-dot"></view><text>填写回复内容后才能发布</text></view><button hover-class="none" class="am-action am-action-primary {{!drafts[item.id] ? 'blocked' : ''}}" data-am-disabled="{{pendingId === item.id}}" aria-disabled="{{(pendingId === item.id) || (!drafts[item.id])}}" data-id="{{item.id}}" bindtap="{{(pendingId === item.id) ? '' : 'reply'}}">{{pendingId === item.id ? '正在发布' : '发布公开回复'}}</button></view>
    </block>
  </view>
  <view wx:if="{{!loading && !loadError && !reviews.length}}" class="empty-state"><text>暂无完成订单评价</text><text>需求方完成验收并提交评分后，会在这里形成只读记录。</text></view>
  <text wx:if="{{message}}" class="message">{{message}}</text>
</view>
<main-bottom-nav/>
