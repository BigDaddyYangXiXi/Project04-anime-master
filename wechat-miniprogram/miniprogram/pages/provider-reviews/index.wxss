.reviews-shell { padding: var(--am-detail-nav-page-padding); }
.rating-overview { margin-bottom: var(--am-space-3); padding: 44rpx 32rpx; border: 1rpx solid var(--am-color-border); border-radius: var(--am-radius-card); background: var(--am-color-surface); text-align: center; box-shadow: var(--am-shadow-none); }
.rating-overview text { display: block; }
.rating-overview text:first-child { color: var(--am-color-brand); font-size: 72rpx; font-weight: var(--am-weight-semibold); }
.rating-overview text:nth-child(2) { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); }
.rating-overview text:nth-child(3) { margin-top: var(--am-space-2); color: var(--am-color-warning); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); }
.rating-overview text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.review-card { margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.review-head { display: flex; align-items: center; gap: 18rpx; }
.avatar { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: var(--am-radius-avatar); background: var(--am-color-brand); color: var(--am-color-on-brand); text-align: center; font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); line-height: 72rpx; }
.review-head > view:last-child { min-width: 0; }
.review-head text { display: block; }
.review-head text:first-child { font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); }
.review-head text:last-child { margin-top: 5rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.review-copy { display: block; margin-top: var(--am-space-3); color: var(--am-color-text); font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); }
.public-reply { margin-top: 22rpx; padding: 22rpx; border-radius: 24rpx; background: var(--am-color-control-surface); color: var(--am-color-brand); }
.public-reply text { display: block; }
.public-reply text:first-child { font-weight: var(--am-weight-semibold); }
.public-reply text:last-child { margin-top: var(--am-space-1); line-height: 1.6; }
.reply-editor { margin-top: var(--am-space-3); }
.reply-editor > text:first-child { display: block; font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); }
.reply-editor textarea { width: 100%; height: 180rpx; margin-top: 12rpx;       }
.reply-editor > text:nth-child(3) { display: block; margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.required-note { display: flex; margin-top: 12rpx; align-items: center; gap: 10rpx; color: var(--am-color-danger); font-size: var(--am-type-micro); line-height: 34rpx; }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: var(--am-color-danger); box-shadow: var(--am-shadow-none); }
.reply-editor button { width: 100%; margin-top: var(--am-space-3); }

.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; text-align: center; }
.empty-state text:first-child { font-size: 30rpx; font-weight: var(--am-weight-semibold); }
.empty-state text:last-child { max-width: 520rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.6; }
.message { display: block; color: var(--am-color-success); text-align: center; font-size: var(--am-type-micro); }

.reply-toggle { display: flex; width: 100%; align-items: center; justify-content: flex-start; min-height: var(--am-touch-min); margin-top: var(--am-space-2); padding: var(--am-space-none); color: var(--am-color-brand); background: var(--am-color-transparent); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); text-align: left; }

@import "../../styles/editor-form.wxss";
