.reviews-shell { padding: 28rpx 32rpx 72rpx; }
.rating-overview { margin-bottom: 24rpx; padding: 44rpx 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; text-align: center; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.rating-overview text { display: block; }
.rating-overview text:first-child { color: #c6536b; font-size: 72rpx; font-weight: 800; }
.rating-overview text:nth-child(2) { margin-top: 4rpx; color: #6f625d; font-size: 22rpx; }
.rating-overview text:nth-child(3) { margin-top: 16rpx; color: #9a6509; font-size: 24rpx; font-weight: 700; }
.rating-overview text:last-child { margin-top: 8rpx; color: #6f625d; font-size: 20rpx; }
.review-card { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.review-head { display: flex; align-items: center; gap: 18rpx; }
.avatar { flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border-radius: 24rpx; background: linear-gradient(145deg,#ef7d83,#ed8c68); color: #fff; text-align: center; font-size: 26rpx; font-weight: 800; line-height: 72rpx; }
.review-head > view:last-child { min-width: 0; }
.review-head text { display: block; }
.review-head text:first-child { font-size: 26rpx; font-weight: 800; }
.review-head text:last-child { margin-top: 5rpx; color: #6f625d; font-size: 20rpx; }
.review-copy { display: block; margin-top: 24rpx; color: #2b2523; font-size: 24rpx; line-height: 1.7; }
.public-reply { margin-top: 22rpx; padding: 22rpx; border-radius: 24rpx; background: #fff0f1; color: #c6536b; }
.public-reply text { display: block; }
.public-reply text:first-child { font-weight: 800; }
.public-reply text:last-child { margin-top: 8rpx; line-height: 1.6; }
.reply-editor { margin-top: 24rpx; }
.reply-editor > text:first-child { display: block; font-size: 22rpx; font-weight: 700; }
.reply-editor textarea { width: 100%; height: 180rpx; margin-top: 12rpx; padding: 20rpx 22rpx; border: 1rpx solid #d9d0d9; border-radius: 22rpx; background: #fcfbfc; font-size: 24rpx; line-height: 1.6; }
.reply-editor > text:nth-child(3) { display: block; margin-top: 8rpx; color: #6f625d; font-size: 20rpx; }
.required-note { display: flex; margin-top: 12rpx; align-items: center; gap: 10rpx; color: #b5434e; font-size: 22rpx; line-height: 34rpx; }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d83b46; box-shadow: 0 0 0 6rpx #fff0f1; }
.reply-editor button { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin-top: 18rpx; padding: 20rpx 24rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); color: #fff; font-size: 24rpx; font-weight: 700; }
.reply-editor button.blocked, .reply-editor button[disabled] { opacity: .42; box-shadow: none; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; text-align: center; }
.empty-state text:first-child { font-size: 30rpx; font-weight: 800; }
.empty-state text:last-child { max-width: 520rpx; color: #6f625d; font-size: 24rpx; line-height: 1.6; }
.message { display: block; color: #208a66; text-align: center; font-size: 22rpx; }
