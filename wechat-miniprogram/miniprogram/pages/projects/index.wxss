@import "../../styles/availability-calendar.wxss";

.projects-shell {
  padding: 20rpx 32rpx 190rpx;
}

.page-intro {
  padding: 16rpx 8rpx 24rpx;
}

.page-intro text,
.project-row text {
  display: block;
}

.intro-title {
  margin: 0 0 12rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 64rpx;
  letter-spacing: -1rpx;
}

.intro-copy {
  color: #6f625d;
  font-size: 26rpx;
  line-height: 40rpx;
}

.project-list {
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #eee3df;
  border-radius: 28rpx;
  background: #ffffff;
}

.project-row {
  display: flex;
  width: 100%;
  gap: 16rpx;
  align-items: center;
  padding: 20rpx 22rpx;
  border: 0;
  border-bottom: 1rpx solid #f1e6e1;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
  text-align: left;
}
.project-row:last-child { border-bottom: 0; }

.project-copy {
  width: 0;
  flex: 1 1 auto;
  min-width: 0;
}

.project-heading { display: flex; min-width: 0; align-items: center; gap: 12rpx; }

.order-status {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  color: #c6536b;
  background: #fff0f1;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

.project-title {
  overflow: hidden;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-meta,
.project-note {
  margin-top: 4rpx;
  color: #6f625d;
  font-size: 22rpx;
  line-height: 32rpx;
}

.project-note {
  font-size: 20rpx;
  line-height: 30rpx;
}
.row-chevron { width: 16rpx; height: 16rpx; flex: 0 0 16rpx; margin-right: 4rpx; border-top: 3rpx solid #b9aaa4; border-right: 3rpx solid #b9aaa4; transform: rotate(45deg); }

.dashed-button {
  display: block;
  width: 100%;
  min-width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  border: 4rpx solid transparent;
  border-radius: 28rpx;
  color: #c6536b;
  background: linear-gradient(135deg, #fff9ed, #fff0e1) padding-box,
    linear-gradient(135deg, #fbc5c4, #fce4ab, #c2e8d6, #c0caf8, #fbbfd2) border-box;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.calendar-shell { padding: 28rpx 32rpx 190rpx; }
.calendar-intro { padding: 18rpx 8rpx 28rpx; }
.calendar-intro text { display: block; }
.calendar-intro text:first-child { color: #c6536b; font-size: 20rpx; font-weight: 700; line-height: 30rpx; letter-spacing: 3rpx; }
.calendar-intro text:nth-child(2) { margin-top: 8rpx; font-size: 48rpx; font-weight: 800; line-height: 60rpx; }
.calendar-intro text:last-child { margin-top: 8rpx; color: #6f625d; font-size: 24rpx; line-height: 38rpx; }
.calendar-actions { display: flex; gap: 18rpx; margin-top: 24rpx; }
.calendar-actions button { width: 100%; min-height: 88rpx; border-radius: 28rpx; font-size: 24rpx; font-weight: 700; line-height: 38rpx; }
.calendar-actions .primary-button { border: 2rpx solid rgba(255,255,255,.92); color: #fff; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); }
.calendar-actions button[disabled] { opacity: .4; }
.calendar-message { display: block; margin-top: 18rpx; color: #208a66; text-align: center; font-size: 22rpx; line-height: 34rpx; }
