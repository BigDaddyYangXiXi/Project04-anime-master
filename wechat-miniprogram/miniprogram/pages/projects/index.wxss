@import "../../styles/availability-calendar.wxss";

.projects-shell { padding: var(--am-detail-nav-page-padding);
}

.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6);
}

.page-intro text,
.project-row text {
  display: block;
}

.intro-title {
  margin: 0 0 12rpx;
  font-size: var(--am-type-page-title);
  font-weight: var(--am-weight-semibold);
  line-height: 64rpx;
  letter-spacing: -1rpx;
}

.intro-copy {
  color: var(--am-color-text-secondary);
  font-size: var(--am-type-label);
  line-height: var(--am-line-label);
}

.project-list {
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--am-color-border);
  border-radius: 28rpx;
  background: var(--am-color-surface);
}

.project-row {
  display: flex;
  width: 100%;
  gap: var(--am-space-2);
  align-items: center;
  padding: 20rpx 22rpx;
  border: 0;
  border-bottom: 1rpx solid var(--am-color-border);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
  text-align: left;
}
.project-row:last-child { border-bottom: 0; }

.project-copy {
  width: 0;
  flex: 1 1 auto;
  min-width: 0;
}

.project-heading { display: flex; min-width: 0; align-items: center; gap: 12rpx; }

.order-status {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  color: var(--am-color-brand);
  background: var(--am-color-selected-surface);
  font-size: var(--am-type-micro);
  font-weight: var(--am-weight-semibold);
  line-height: 30rpx;
}

.project-title {
  overflow: hidden;
  min-width: 0;
  font-size: 27rpx;
  font-weight: var(--am-weight-semibold);
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.project-meta,
.project-note {
  margin-top: 4rpx;
  color: var(--am-color-text-secondary);
  font-size: var(--am-type-micro);
  line-height: 32rpx;
}

.project-note {
  font-size: var(--am-type-caption);
  line-height: 30rpx;
}
.row-chevron { width: 16rpx; height: 16rpx; flex: 0 0 16rpx; margin-right: 4rpx; border-top: 3rpx solid #b9aaa4; border-right: 3rpx solid #b9aaa4; transform: rotate(45deg); }

.dashed-button { width: 100%; margin-top: var(--am-space-3); }

.calendar-shell { padding: 28rpx 32rpx 190rpx; }
.calendar-intro { padding: 18rpx 8rpx 28rpx; }
.calendar-intro text { display: block; }
.calendar-intro text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 30rpx; letter-spacing: 3rpx; }
.calendar-intro text:nth-child(2) { margin-top: var(--am-space-1); font-size: 48rpx; font-weight: var(--am-weight-semibold); line-height: var(--am-line-page-title); }
.calendar-intro text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 38rpx; }
.calendar-actions { display: flex; gap: 18rpx; margin-top: var(--am-space-3); }
.calendar-actions button { width: 100%; min-height: 88rpx; border-radius: 28rpx; font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 38rpx; }

.calendar-message { display: block; margin-top: 18rpx; color: var(--am-color-success); text-align: center; font-size: var(--am-type-micro); line-height: 34rpx; }
