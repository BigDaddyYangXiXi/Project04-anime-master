@import "../../styles/availability-calendar.wxss";
.schedule-shell { padding: 28rpx 32rpx 190rpx; }
.page-intro { padding: 18rpx 8rpx 26rpx; }
.page-intro text { display: block; }
.page-intro text:first-child { color: #c6536b; font-size: 20rpx; font-weight: 800; line-height: 30rpx; letter-spacing: 2rpx; }
.page-intro text:nth-child(2) { margin-top: 8rpx; color: #2b2523; font-size: 46rpx; font-weight: 800; line-height: 58rpx; }
.page-intro text:last-child { margin-top: 8rpx; color: #6f625d; font-size: 23rpx; line-height: 37rpx; }
.selection-note { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; padding: 20rpx 24rpx; border: 1rpx solid #eee3df; border-radius: 22rpx; background: #fff; }
.selection-note text:first-child { color: #6f625d; font-size: 21rpx; line-height: 32rpx; }
.selection-note text:last-child { color: #c6536b; font-size: 23rpx; font-weight: 800; line-height: 34rpx; text-align: right; }
.primary-block { display: flex; width: 100%; min-height: 88rpx; margin-top: 20rpx; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; font-size: 26rpx; font-weight: 800; line-height: 40rpx; }
.primary-block[disabled] { opacity: .4; }
