@import "../../styles/availability-calendar.wxss";
.preview-month-actions { display:flex; justify-content:space-between; gap:var(--am-space-3); }
.preview-month-actions button { margin:var(--am-space-none); }
.schedule-shell { padding: var(--am-detail-nav-page-padding); }
.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6); }
.page-intro text { display: block; }
.page-intro text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 30rpx; letter-spacing: 2rpx; }
.page-intro text:nth-child(2) { margin-top: var(--am-space-1); color: var(--am-color-text); font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); line-height: 58rpx; }
.page-intro text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 37rpx; }
.selection-note { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; padding: 20rpx 24rpx; border: 1rpx solid var(--am-color-border); border-radius: 22rpx; background: var(--am-color-surface); }
.selection-note text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.selection-note text:last-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; text-align: right; }
.primary-block { display: flex; width: 100%;  margin-top: 20rpx; align-items: center; justify-content: center;         }

@import "../../styles/storefront-editor.wxss";
