.search-page { min-height: 100vh; padding: var(--am-detail-nav-page-padding); color: var(--am-color-text); background: var(--am-color-canvas); }
.career-search { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 72rpx; margin: var(--am-space-none); align-items: center; gap: var(--am-space-1); padding: 4rpx 18rpx; border: 1rpx solid var(--am-color-border); border-radius: 24rpx; background: var(--am-color-surface); text-align: left; }
.career-search > text:nth-child(2) { min-width: 0; flex: 1; overflow: hidden; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); text-overflow: ellipsis; white-space: nowrap; }
.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: var(--am-space-3) var(--am-space-none); }
.tag-row text { padding: 10rpx 16rpx; border-radius: 999rpx; color: var(--am-color-text-secondary); background: var(--am-color-control-surface); font-size: var(--am-type-caption); line-height: 28rpx; }
.result-summary { display: flex; align-items: center; gap: 10rpx; margin: 4rpx 4rpx 24rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.result-summary text:first-child { color: var(--am-color-brand); font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); }
.work-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--am-space-2); align-items: start; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: var(--am-space-2); text-align: center; }.empty-state text:first-child { font-size: var(--am-type-section-title); line-height: 48rpx; font-weight: var(--am-weight-semibold); }.empty-state text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.modal-layer { position: fixed; z-index: 99; inset: 0; display: flex; align-items: flex-start; }.scrim { position: absolute; inset: 0; width: 100%; height: 100%; background: rgba(31,25,31,.42); }.modal-panel { position: relative; z-index: 1; display: flex; width: 100%; max-height: calc(100vh - 160rpx); flex-direction: column; gap: var(--am-space-3); padding: var(--am-space-4); overflow-y: auto; border-radius: 0 0 36rpx 36rpx; background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.modal-title { font-size: 36rpx; line-height: 52rpx; font-weight: var(--am-weight-semibold); }.modal-search { display: flex; width: 100%; height: 72rpx; min-height: 72rpx; max-height: 72rpx; align-items: center; gap: var(--am-space-1); padding: 4rpx 18rpx; border: 1rpx solid var(--am-color-border); border-radius: 24rpx; background: var(--am-color-surface); }.modal-search input { min-width: 0; height: 36rpx; flex: 1; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }.search-placeholder { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); }

.search-icon { position: relative; width: 40rpx; min-width: 40rpx; max-width: 40rpx; height: 36rpx; min-height: 36rpx; max-height: 36rpx; flex: 0 0 40rpx; font-size: 0; }
.search-icon::before { position: absolute; top: 1rpx; left: 0; width: 30rpx; height: 30rpx; border: 4rpx solid var(--am-color-border); border-radius: 50%; box-sizing: border-box; content: ""; }
.search-icon::after { position: absolute; top: 26rpx; left: 26rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: var(--am-color-control-surface); content: ""; transform: rotate(45deg); transform-origin: left center; }
.recent-head { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.recent-head > text { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }.recent-head button { min-height: 88rpx; padding: 0 20rpx; color: var(--am-color-brand); background: transparent; font-size: var(--am-type-micro); font-weight: var(--am-weight-regular); }.recent-list { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 0 12rpx; }.recent-item { position: relative; display: flex; width: auto; min-width: 0; min-height: 88rpx; flex: 0 0 auto; align-items: stretch; }.recent-item::before { position: absolute; top: 16rpx; right: 0; bottom: 16rpx; left: 0; border: 1rpx solid var(--am-color-border); border-radius: 28rpx; background: var(--am-color-canvas); content: ""; }.recent-item button { position: relative; z-index: 1; display: flex; width: auto; min-width: 0; height: 88rpx; min-height: 88rpx; max-height: 88rpx; flex: 0 0 auto; align-items: center; justify-content: center; padding: 0 20rpx; color: var(--am-color-text-secondary); background: transparent; font-size: var(--am-type-micro); line-height: 32rpx; font-weight: var(--am-weight-regular); }.recent-item button:first-child { max-width: 240rpx; overflow: hidden; padding-right: var(--am-space-2); text-overflow: ellipsis; white-space: nowrap; }.recent-item button:last-child { width: 88rpx; padding: var(--am-space-none); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); }.recent-item button:last-child::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 1rpx; background: var(--am-color-control-surface); content: ""; }
.modal-actions { display: flex; gap: 12rpx; }.modal-actions button { min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-semibold); }.modal-actions .secondary-button { flex: 1; }.modal-actions .primary-button { flex: 1.5;     }

@import "../../styles/discovery-controls.wxss";

