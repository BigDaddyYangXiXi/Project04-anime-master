.search-page { min-height: 100vh; padding: 24rpx 32rpx 180rpx; color: #5f4a45; background: #fff8f3; }
.career-search { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 72rpx; margin: 0; align-items: center; gap: 8rpx; padding: 4rpx 18rpx; border: 1rpx solid #f2cfd3; border-radius: 24rpx; background: #fff; text-align: left; }
.career-search > text:nth-child(2) { min-width: 0; flex: 1; overflow: hidden; color: #7d6b65; font-size: 24rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0; }
.tag-row text { padding: 10rpx 16rpx; border-radius: 999rpx; color: #6e5966; background: #f7eeee; font-size: 20rpx; line-height: 28rpx; }
.result-summary { display: flex; align-items: center; gap: 10rpx; margin: 4rpx 4rpx 24rpx; color: #7d6b65; font-size: 20rpx; line-height: 32rpx; }
.result-summary text:first-child { color: #c6536b; font-size: 28rpx; font-weight: 800; }
.work-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; align-items: start; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; text-align: center; }.empty-state text:first-child { font-size: 32rpx; line-height: 48rpx; font-weight: 700; }.empty-state text:last-child { color: #7d6b65; font-size: 26rpx; line-height: 40rpx; }
.modal-layer { position: fixed; z-index: 99; inset: 0; display: flex; align-items: flex-start; }.scrim { position: absolute; inset: 0; width: 100%; height: 100%; background: rgba(31,25,31,.42); }.modal-panel { position: relative; z-index: 1; display: flex; width: 100%; max-height: calc(100vh - 160rpx); flex-direction: column; gap: 24rpx; padding: 32rpx; overflow-y: auto; border-radius: 0 0 36rpx 36rpx; background: #fff; box-shadow: 0 24rpx 80rpx rgba(48,35,47,.2); }
.modal-title { font-size: 36rpx; line-height: 52rpx; font-weight: 800; }.modal-search { display: flex; width: 100%; height: 72rpx; min-height: 72rpx; max-height: 72rpx; align-items: center; gap: 8rpx; padding: 4rpx 18rpx; border: 1rpx solid #f2cfd3; border-radius: 24rpx; background: #fff; }.modal-search input { min-width: 0; height: 36rpx; flex: 1; color: #7d6b65; font-size: 24rpx; line-height: 36rpx; font-weight: 400; }.search-placeholder { color: #7d6b65; font-size: 24rpx; font-weight: 400; }

.search-icon { position: relative; width: 40rpx; min-width: 40rpx; max-width: 40rpx; height: 36rpx; min-height: 36rpx; max-height: 36rpx; flex: 0 0 40rpx; font-size: 0; }
.search-icon::before { position: absolute; top: 1rpx; left: 0; width: 30rpx; height: 30rpx; border: 4rpx solid #ff6f71; border-radius: 50%; box-sizing: border-box; content: ""; }
.search-icon::after { position: absolute; top: 26rpx; left: 26rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: #ff6f71; content: ""; transform: rotate(45deg); transform-origin: left center; }
.recent-head { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.recent-head > text { color: #7d6b65; font-size: 24rpx; line-height: 36rpx; font-weight: 400; }.recent-head button { min-height: 88rpx; padding: 0 20rpx; color: #c6536b; background: transparent; font-size: 22rpx; font-weight: 400; }.recent-list { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 0 12rpx; }.recent-item { position: relative; display: flex; width: auto; min-width: 0; min-height: 88rpx; flex: 0 0 auto; align-items: stretch; }.recent-item::before { position: absolute; top: 16rpx; right: 0; bottom: 16rpx; left: 0; border: 1rpx solid #eadeda; border-radius: 28rpx; background: #fff8f3; content: ""; }.recent-item button { position: relative; z-index: 1; display: flex; width: auto; min-width: 0; height: 88rpx; min-height: 88rpx; max-height: 88rpx; flex: 0 0 auto; align-items: center; justify-content: center; padding: 0 20rpx; color: #7d6b65; background: transparent; font-size: 22rpx; line-height: 32rpx; font-weight: 400; }.recent-item button:first-child { max-width: 240rpx; overflow: hidden; padding-right: 16rpx; text-overflow: ellipsis; white-space: nowrap; }.recent-item button:last-child { width: 88rpx; padding: 0; color: #9b857b; font-size: 24rpx; font-weight: 400; }.recent-item button:last-child::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 1rpx; background: #eadeda; content: ""; }
.modal-actions { display: flex; gap: 12rpx; }.modal-actions button { min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: 24rpx; line-height: 36rpx; font-weight: 700; }.modal-actions .secondary-button { flex: 1; }.modal-actions .primary-button { flex: 1.5; color: #fff; border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; }
