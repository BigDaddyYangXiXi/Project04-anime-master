<app-top-nav bind:layout="onNavigationLayout" class="app-navigation" title="搜索结果" show-back="{{true}}"/>
<view class="search-page">
  <button hover-class="none" class="career-search browse-control" bindtap="openSearch"><image class="browse-search-icon" src="/assets/actions/browse-search.svg" aria-hidden="true"/><text class="browse-control-label">{{searchQuery || '搜索' + career + '作品、风格或服务者'}}</text></button>
  <view wx:if="{{selectedFilters.length}}" class="tag-row"><text wx:for="{{selectedFilters}}" wx:key="*this">{{item}}</text></view>
  <view class="result-summary"><text>{{catalogNextCursor ? "已显示 " : ""}}{{results.length}}</text><text>个结果 · {{career}} · {{city}}</text></view>

  <text wx:if="{{catalogCacheError}}">刷新失败，请稍后重试</text>
  <block wx:if="{{catalogLoading}}"></block>
  <view wx:elif="{{catalogError}}" class="empty-state"><text>公开目录暂不可用</text><text>{{catalogError}}</text></view>
  <view wx:elif="{{results.length}}" class="work-grid"><work-card wx:for="{{results}}" wx:key="listKey" work="{{item}}" source="B01S"/></view>
  <view wx:else class="empty-state"><text>没有匹配作品</text><text>换一个搜索词或减少筛选条件。</text></view>
  <include src="../../templates/discovery-pagination.wxml"/>
</view>

<view wx:if="{{searchOpen}}" class="modal-layer" style="top: {{navigationHeight}}px;"><view class="scrim" bindtap="closeSearch"></view><view class="modal-panel" catchtap="noop"><text class="modal-title">搜索{{career}}</text><view class="modal-search"><image class="browse-search-icon" src="/assets/actions/browse-search.svg" aria-hidden="true"/><input value="{{searchDraft}}" placeholder="作品、风格或服务者" placeholder-class="search-placeholder" bindinput="updateSearchDraft" confirm-type="search" bindconfirm="submitSearch" /></view><view class="recent-head"><text>最近搜索</text><button aria-disabled="{{!recent.length}}" hover-class="none" data-am-disabled="{{!recent.length}}" bindtap="{{(!recent.length) ? '' : 'clearRecent'}}">全部清空</button></view><view class="recent-list"><view wx:for="{{recent}}" wx:key="*this" class="recent-item"><button hover-class="none" data-value="{{item}}" bindtap="submitSearch">{{item}}</button><button hover-class="none" aria-label="删除最近搜索 {{item}}" data-value="{{item}}" bindtap="removeRecent">×</button></view></view><view class="modal-actions"><button hover-class="none" class="secondary-button am-action am-action-secondary" bindtap="closeSearch">取消</button><button hover-class="none" class="primary-button am-action am-action-primary" bindtap="submitSearch">查看结果</button></view></view></view>
<main-bottom-nav/>
