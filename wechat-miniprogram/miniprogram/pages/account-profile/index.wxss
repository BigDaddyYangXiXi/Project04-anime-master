.account-shell { padding: var(--am-detail-page-padding)}.profile-card,.form-card { margin-bottom: var(--am-detail-section-gap); padding: var(--am-space-4) var(--am-space-none); border: var(--am-border-none); border-radius: var(--am-radius-control);background: var(--am-color-transparent)}button.avatar-picker{display:flex;width:auto;max-width:100%;gap:var(--am-space-4);margin:var(--am-space-none);align-items:center;padding:var(--am-space-none);background:transparent;line-height:normal}.avatar-picker::after{display: none}.avatar-preview{display: flex;width:var(--am-avatar-detail-author);height:var(--am-avatar-detail-author);align-items: center;justify-content: center;border: 4rpx solid transparent;border-radius: var(--am-radius-avatar);background: var(--am-color-brand)}.avatar-fallback{color: var(--am-color-text);font-size: var(--am-type-page-title);font-weight: var(--am-weight-semibold)}.avatar-picker>text{margin-top: var(--am-space-2);color: var(--am-color-brand);font-size: var(--am-type-caption);font-weight: var(--am-weight-semibold)}.privacy-note{display: block;margin-top: var(--am-space-3);color: var(--am-color-text-secondary);font-size: var(--am-type-caption);line-height: var(--am-line-caption);text-align: center}.field-title{display: flex;align-items: center;justify-content: space-between}.field-title text:first-child{font-size: var(--am-type-caption);font-weight: var(--am-weight-semibold)}.field-title text:last-child{color: var(--am-color-text-secondary);font-size: var(--am-type-caption)}.nickname-input{width: 100%;height: 88rpx;margin-top: var(--am-space-2);}.save-button{display: flex;width: 100%;height: 88rpx;align-items: center;justify-content: center;}

@import "../../styles/editor-form.wxss";

.account-shell { padding-bottom:calc(var(--am-touch-min) + var(--am-space-8) + env(safe-area-inset-bottom)); }
.account-state-note { display:block; margin:var(--am-storefront-state-margin); padding:var(--am-space-2) var(--am-space-4); background:var(--am-color-surface); font-size:var(--am-type-caption); line-height:var(--am-line-caption); color:var(--am-color-text-secondary); }
.account-save-footer { position:fixed; left:0; right:0; bottom:0; padding:var(--am-space-3) var(--am-space-4) calc(var(--am-space-3) + env(safe-area-inset-bottom)); background:var(--am-color-canvas); border-top:var(--am-border-control); }
.account-shell .field-title text:first-child { color:var(--am-color-text-secondary); font-weight:var(--am-weight-regular); line-height:var(--am-line-caption); }

.account-help { text-align:left; margin-top:var(--am-space-2); }
.account-feedback { margin-top:var(--am-space-6); padding:var(--am-space-4); background:var(--am-color-surface); font-size:var(--am-type-caption); line-height:var(--am-line-caption); border-radius:var(--am-radius-control); }
