.account-shell{padding:34rpx 28rpx 80rpx}.profile-card,.form-card{margin-bottom:24rpx;padding:32rpx;border:1rpx solid #eee3df;border-radius:36rpx;background:#fff}.avatar-picker{display:flex;width:100%;flex-direction:column;align-items:center;padding:0;background:transparent;line-height:normal}.avatar-picker::after{display:none}.avatar-preview{display:flex;width:132rpx;height:132rpx;align-items:center;justify-content:center;border:4rpx solid transparent;border-radius:44rpx;background:linear-gradient(145deg,#f0787e,#ed8c68) padding-box,linear-gradient(135deg,#fbc5c4,#fce4ab,#c2e8d6,#c0caf8,#fbbfd2) border-box}.avatar-fallback{color:#fff;font-size:44rpx;font-weight:800}.avatar-picker>text{margin-top:18rpx;color:#c6536b;font-size:23rpx;font-weight:700}.privacy-note{display:block;margin-top:22rpx;color:#7b6d68;font-size:21rpx;line-height:34rpx;text-align:center}.field-title{display:flex;align-items:center;justify-content:space-between}.field-title text:first-child{font-size:24rpx;font-weight:700}.field-title text:last-child{color:#9b8c86;font-size:18rpx}.nickname-input{width:100%;height:88rpx;margin-top:14rpx;padding:0 22rpx;border:1rpx solid #eaded9;border-radius:22rpx;background:#fffaf8;font-size:27rpx}.save-button{display:flex;width:100%;height:88rpx;align-items:center;justify-content:center;border-radius:26rpx;color:#fff;background:#ef7b7e;font-size:26rpx;font-weight:800}.save-button.blocked{opacity:.42}
