<app-top-nav title="头像与昵称" workspace="{{role}}" show-back="{{true}}" custom-back="{{true}}" bindback="back"/>
<block wx:if="{{loading}}"></block>
<view wx:elif="{{loadError && !draft.nickname}}" class="empty-page"><text class="empty-page-title">{{loadError}}</text></view>
<view wx:else class="am-editor-form account-shell"><text class="account-state-note">账号资料 · 单独保存，不随橱窗发布</text>
  <view class="profile-card">
    <button class="avatar-picker" open-type="{{(saving || avatarBusy) ? '' : 'chooseAvatar'}}" hover-class="none" aria-disabled="{{saving || avatarBusy}}" bindchooseavatar="chooseAvatar">
      <image wx:if="{{draft.avatar}}" class="avatar-preview" src="{{draft.avatar}}" mode="aspectFill"/>
      <view wx:else class="avatar-preview avatar-fallback">{{initial}}</view>
      <text>{{draft.avatar ? '更换头像' : '选择头像'}}</text>
    </button>


  </view>
  <view class="form-card">
    <view class="field-title"><text>昵称</text><text>{{nicknameLength}} / 12</text></view>
    <input type="text" class="nickname-input am-input" value="{{draft.nickname}}" maxlength="144" bindinput="updateNickname" placeholder="请输入昵称"/>
  </view>
  <text class="privacy-note account-help">昵称保存后更新，新头像通过检测后更新。</text><view wx:if="{{avatarMessage}}" class="account-feedback" aria-live="polite">{{avatarMessage}}</view><view class="account-save-footer"><button class="save-button am-action am-action-primary am-action-block" disabled="{{!canSave || saving || loading}}" bindtap="save">{{saving ? '保存中' : avatarBusy ? '先保存昵称' : '保存账号资料'}}</button></view>
  <text wx:if="{{loadError}}" class="privacy-note">{{loadError}}</text>
</view>
