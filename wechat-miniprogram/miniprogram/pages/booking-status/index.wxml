<app-top-nav class="app-navigation" title="预约状态" show-back="{{true}}"/>
<block wx:if="{{loading && !order}}"></block>
<view wx:elif="{{order}}" class="status-shell">
  <view class="status-head"><view class="status-label"><image class="status-icon" src="/assets/booking/status-{{statusIcon}}.svg"/><text>{{statusTitle}}</text></view><text class="status-title">{{statusView.title}}</text><text class="status-lead">{{statusView.lead}}</text></view>
  <view wx:if="{{!isFailed}}" class="status-track"><view wx:for="{{journeySteps}}" wx:key="number" class="track-step {{item.state}}"><view class="track-line"/><text>{{item.title}}</text></view></view>
  <view class="status-card next-card"><text class="fact-title">{{statusView.focus}}</text><text class="secondary-copy">{{statusView.hint}}</text></view>
  <order-subscription id="order-subscription" wx:if="{{order.cloudOrder && order.stage !== 'COMPLETED' && order.stage !== 'DECLINED'}}" order-id="{{order.id}}"/>
  <text class="section-heading">本次预约</text>
  <view class="status-card">
    <view class="status-person"><view class="status-avatar"><text>{{providerIdentity.nickname[0]}}</text></view><view class="person-copy"><text class="am-identity-full">{{providerIdentity.nickname}}</text><text class="secondary-copy">{{order.career}} · {{order.city}}</text></view><button hover-class="none" class="status-link" bindtap="viewProvider">查看主页</button></view>
    <view class="status-service"><view class="service-copy"><text class="fact-title">{{order.service}}</text><text class="secondary-copy" wx:if="{{order.deliveryText}}">{{order.deliveryText}}</text></view><view class="service-price"><text class="am-money am-money-list">￥{{referencePrice}}</text><text class="secondary-copy">参考价</text></view></view>
    <view class="status-facts"><view class="status-fact"><text>服务地点</text><text>{{order.city}}</text></view><view class="status-fact" wx:for="{{schedule.lines}}" wx:key="label"><text>{{item.label}}</text><text>{{item.text}}</text></view></view>
  </view>
  <view class="status-disclosure"><button hover-class="none" class="disclosure-toggle" bindtap="toggleDetails"><text>需求与参考资料</text><text>{{detailsOpen ? '−' : '+'}}</text></button><view wx:if="{{detailsOpen}}" class="disclosure-content"><text>{{order.requirement || '未填写需求说明'}}</text><text class="secondary-copy">{{order.reference || '未提供参考资料'}}</text><button hover-class="none" wx:if="{{order.referenceAssetId && !order.privateFieldsHidden}}" class="am-action am-action-secondary am-action-block" bindtap="openReference">查看私人参考图</button><image wx:if="{{order.referenceImage}}" class="reference-image" src="{{order.referenceImage}}" mode="widthFix"/></view></view>
  <view class="status-code"><view><text class="secondary-copy">预约编号</text><text>{{order.id}}</text></view><button hover-class="none" class="status-link" bindtap="copyCode">复制</button></view>
</view>
<view wx:else class="empty-page"><text class="empty-page-title">{{loadError ? '预约加载失败' : '没有找到预约'}}</text><text class="empty-page-copy">{{loadError || '请从职业市场重新发起预约。'}}</text><button hover-class="none" wx:if="{{loadError}}" class="am-action am-action-secondary" bindtap="retryLoad">重新加载</button></view>
<view wx:if="{{order}}" class="status-action">
  <button hover-class="none" wx:if="{{isSupplement}}" class="am-action am-action-primary" data-panel="supplement" bindtap="openPanel">补充预约信息</button>
  <block wx:elif="{{isFailed}}"><button hover-class="none" class="am-action am-action-secondary" bindtap="goMarket">找其他高手</button><button hover-class="none" class="am-action am-action-primary" bindtap="retryBooking">调整后再次预约</button></block>
  <button aria-disabled="{{paymentQuerying || loading}}" hover-class="none" wx:elif="{{statusView.kind === 'review'}}" class="am-action am-action-primary" data-am-disabled="{{paymentQuerying || loading}}" bindtap="{{(paymentQuerying || loading) ? '' : 'refreshStatus'}}">{{paymentQuerying ? '正在核对…' : '刷新付款状态'}}</button>
  <button hover-class="none" wx:elif="{{isStepFour}}" class="am-action am-action-primary" bindtap="goOrder">查看执行详情</button>
  <button hover-class="none" wx:elif="{{canSignNda}}" class="am-action am-action-primary" data-panel="nda" bindtap="openPanel">查看保密协议</button>
  <button hover-class="none" wx:elif="{{canConfirmAgreement || (isStepThree && !agreementConfirmed && !waitingProviderNda)}}" class="am-action am-action-primary" data-panel="agreement" bindtap="openPanel">核对合作信息</button>
  <block wx:elif="{{agreementConfirmed && statusView.kind === 'pay'}}"><view class="action-price"><text class="secondary-copy">本次应付</text><text class="am-money am-money-detail">￥{{totalPrice}}</text></view><button aria-disabled="{{paying || paymentQuerying}}" hover-class="none" class="am-action am-action-primary" data-am-disabled="{{paying || paymentQuerying}}" bindtap="{{(paying || paymentQuerying) ? '' : 'startPayment'}}">{{paying ? '正在处理…' : '微信支付'}}</button></block>
  <block wx:else><text class="secondary-copy">{{waitingProviderNda ? '等待双方完成签署' : '当前无需付款，等待状态更新'}}</text><button aria-disabled="{{loading}}" hover-class="none" class="status-link" data-am-disabled="{{loading}}" bindtap="{{(loading) ? '' : 'refreshStatus'}}">刷新状态</button></block>
</view>
<main-bottom-nav/>
<view wx:if="{{panel}}" class="status-mask {{sheetKeyboardHeight ? 'am-keyboard-open' : ''}}" style="bottom: {{sheetKeyboardHeight}}px; top: {{sheetKeyboardHeight ? sheetSafeTop : 0}}px" bindtap="closePanel"><view class="status-sheet am-input-sheet" catchtap="stopTap"><view class="sheet-heading" catchtouchmove="preventSheetBackgroundScroll"><text>{{panel === 'supplement' ? '补充预约信息' : panel === 'nda' ? '保密约定' : '核对合作信息'}}</text><button hover-class="none" class="status-link" bindtap="closePanel">关闭</button></view><scroll-view scroll-y class="sheet-content am-sheet-scroll" scroll-into-view="{{sheetScrollTarget}}">
  <block wx:if="{{panel === 'supplement'}}"><text class="sheet-copy">{{order.supplementNote}}</text><textarea id="supplement-input" class="am-textarea" data-field="supplement-input" adjust-position="{{false}}" bindfocus="sheetInputFocus" bindkeyboardheightchange="sheetKeyboardChange" value="{{supplement}}" bindinput="updateSupplement" placeholder="填写补充信息" maxlength="2000"/><button aria-disabled="{{actionPending}}" hover-class="none" class="am-action am-action-primary" data-am-disabled="{{actionPending}}" bindtap="{{(actionPending) ? '' : 'submitSupplement'}}">保存补充并重新提交</button></block>
  <block wx:else><view class="status-fact"><text>需求方</text><text class="am-identity-full">{{buyerIdentity.nickname}}</text></view><view class="status-fact"><text>服务方</text><text class="am-identity-full">{{providerIdentity.nickname}}</text></view><view class="status-fact"><text>地点</text><text>{{order.city}}</text></view><view class="status-fact" wx:for="{{schedule.lines}}" wx:key="label"><text>{{item.label}}</text><text>{{item.text}}</text></view><view class="status-fact"><text>服务范围</text><text>{{order.service}}</text></view><view class="status-fact"><text>需求说明</text><text>{{order.requirement}}</text></view><view class="status-fact"><text>保密约定</text><text>{{order.ndaRequired ? '需要双方签署保密协议' : '双方确认无需保密协议'}}</text></view><view class="sheet-total"><text>合作金额</text><text class="am-money am-money-detail">￥{{totalPrice}}</text></view>
    <block wx:if="{{panel === 'nda'}}"><text class="secondary-copy">当前仅记录保密约定的确认顺序，不提供法律电子签章。</text><button aria-disabled="{{actionPending}}" hover-class="none" class="am-action am-action-primary" data-am-disabled="{{actionPending}}" bindtap="{{(actionPending) ? '' : 'signNda'}}">确认保密约定</button></block>
    <block wx:else><view wx:if="{{agreementIssues.length}}" class="sheet-issues"><text wx:for="{{agreementIssues}}" wx:key="*this">{{item}}</text></view><checkbox-group bindchange="updateAgreementRead"><label class="agreement-check"><checkbox value="read" checked="{{agreementRead}}" color="#ff946b"/><text>已核对合作信息，与沟通结果一致</text></label></checkbox-group><button aria-disabled="{{actionPending}}" hover-class="none" class="am-action am-action-primary" data-am-disabled="{{actionPending}}" bindtap="{{(actionPending) ? '' : 'confirmReviewed'}}">确认合作信息</button><text class="secondary-copy">确认信息不会直接扣款</text></block>
  </block>
</scroll-view></view></view>
