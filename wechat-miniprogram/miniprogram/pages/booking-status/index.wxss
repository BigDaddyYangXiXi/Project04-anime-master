@import "../../styles/money.wxss";
page { background: var(--am-color-canvas); }
.status-shell { padding: var(--am-space-6) var(--am-space-4) calc(var(--am-nav-bottom-content) + var(--am-status-action-height) + var(--am-space-6) + env(safe-area-inset-bottom)); color: var(--am-color-text); }
.status-head text { display: block; }
.status-label { color: var(--am-color-brand); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); margin-bottom: var(--am-space-3); }
.status-title { font-size: var(--am-status-title-size); line-height: var(--am-status-title-line); font-weight: var(--am-weight-semibold); }
.status-lead { margin-top: var(--am-booking-person-gap); font-size: var(--am-type-label); line-height: var(--am-line-section-title); color: var(--am-color-text-secondary); }
.status-track { display: flex; margin: var(--am-space-6) var(--am-space-none); }
.track-step { flex: 1; min-width: 0; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.track-line { height: var(--am-status-track-height); background: var(--am-color-border); margin-right: var(--am-space-1); margin-bottom: var(--am-space-2); }
.track-step.active { color: var(--am-color-text); font-weight: var(--am-weight-medium); }
.track-step.active .track-line,.track-step.done .track-line { background: var(--am-color-brand); }
.status-card { border: var(--am-work-rule); border-radius: var(--am-radius-control); padding: var(--am-space-4) var(--am-space-3); background: var(--am-color-surface); }
.next-card { margin-bottom: var(--am-space-6); }
.status-head+.next-card { margin-top: var(--am-space-6); }
.fact-title { display: block; font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); font-weight: var(--am-weight-medium); }
.secondary-copy { display: block; color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }
.next-card .secondary-copy,.service-copy .secondary-copy { margin-top: var(--am-work-space-six); }
.section-heading { display: block; font-size: var(--am-type-section-title); line-height: var(--am-line-section-title); font-weight: var(--am-weight-semibold); margin-bottom: var(--am-space-4); }
.status-person { display: flex; align-items: center; gap: var(--am-booking-person-gap); margin-bottom: var(--am-space-4); }
.status-avatar { width: var(--am-avatar-detail-author); height: var(--am-avatar-detail-author); border-radius: var(--am-radius-avatar); display: flex; align-items: center; justify-content: center; background: var(--am-color-control-surface); flex-shrink: 0; }
.person-copy { flex: 1; min-width: 0; font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); font-weight: var(--am-weight-semibold); }
button.status-link { width: auto; min-width: 0; margin: var(--am-space-none); padding: var(--am-space-none); min-height: var(--am-touch-min); display: flex; align-items: center; justify-content: flex-end; color: var(--am-color-brand); background: var(--am-color-transparent); font-size: var(--am-booking-type-secondary); font-weight: var(--am-weight-regular); border: 0; }
.status-link::after,.disclosure-toggle::after { border: 0; }
.status-service { display: flex; align-items: center; gap: var(--am-space-3); }
.service-copy { flex: 1; min-width: 0; }
.service-price { text-align: right; }
.status-facts { border-top: var(--am-work-rule); margin-top: var(--am-space-4); padding-top: var(--am-space-1); }
.status-fact { display: flex; align-items: flex-start; gap: var(--am-space-3); margin-top: var(--am-space-3); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.status-fact>text:first-child { width: var(--am-status-fact-label); flex-shrink: 0; color: var(--am-color-text-secondary); }
.status-fact>text:last-child { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.status-disclosure { margin-top: var(--am-space-6); border-top: var(--am-work-rule); }
button.disclosure-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: var(--am-space-4) var(--am-space-none); margin: var(--am-space-none); background: var(--am-color-transparent); color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-medium); }
.disclosure-content { font-size: var(--am-type-label); line-height: var(--am-line-section-title); padding-bottom: var(--am-space-4); }
.reference-image { width: 100%; margin-top: var(--am-space-3); }
.status-code { display: flex; align-items: center; gap: var(--am-space-3); border-top: var(--am-work-rule); padding-top: var(--am-space-4); margin-top: var(--am-space-6); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.status-code>view { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.status-action { position: fixed; bottom: calc(var(--am-nav-bottom-content) + env(safe-area-inset-bottom)); left: 0; right: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); padding: var(--am-booking-person-gap) var(--am-space-4); background: var(--am-color-canvas); border-top: var(--am-work-rule); }
.status-action .am-action { flex: 1; min-width: 0; margin: var(--am-space-none); }
.action-price { flex: 1; }
.status-mask { position: fixed; inset: 0; z-index: 100; background: var(--am-booking-scrim); display: flex; align-items: flex-end; }
.status-sheet { width: 100%; background: var(--am-color-canvas); border-radius: var(--am-status-sheet-corners); padding: var(--am-space-4) var(--am-space-4) calc(var(--am-space-4) + env(safe-area-inset-bottom)); }
.sheet-heading { display: flex; align-items: center; justify-content: space-between; font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.sheet-content { max-height: var(--am-status-sheet-max); }
.sheet-content .am-action { margin-top: var(--am-space-6); margin-bottom: var(--am-space-3); }
.sheet-copy { display: block; font-size: var(--am-type-label); line-height: var(--am-line-section-title); margin-bottom: var(--am-space-4); }
.sheet-total { display: flex; align-items: center; justify-content: space-between; padding-top: var(--am-space-4); margin-top: var(--am-space-4); border-top: var(--am-work-rule); font-size: var(--am-type-label); }
.agreement-check { display: flex; align-items: center; margin-top: var(--am-space-6); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.sheet-issues { color: var(--am-color-warning); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); margin-top: var(--am-space-4); }
.sheet-issues text { display: block; }

.status-action button.am-action { border-radius: var(--am-radius-pill); }

.sheet-content button.am-action { width: 100%; min-width: 100%; max-width: 100%; border-radius: var(--am-radius-pill); }

.status-label { display: flex; align-items: center; gap: var(--am-space-2); }
.status-icon { width: var(--am-line-caption); height: var(--am-line-caption); }

@import "../../styles/sheet-keyboard.wxss";
