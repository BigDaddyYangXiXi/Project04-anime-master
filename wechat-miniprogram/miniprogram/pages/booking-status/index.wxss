.status-shell { padding: 20rpx 32rpx 156rpx; }
.page-intro { padding: 20rpx 8rpx 32rpx; }
.page-intro text { display: block; }
.status-dot { display: inline-flex !important; width: fit-content; align-items: center; gap: 10rpx; padding: 10rpx 18rpx; border-radius: 999rpx; color: #ad6a08; background: #fff4d9; font-size: 20rpx; font-weight: 700; line-height: 28rpx; }
.status-dot::before { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; content: ""; }
.status-dot.ready { color: #208a66; background: #e6f6ef; }
.intro-title { margin: 12rpx 0; color: #221e1c; font-size: 52rpx; font-weight: 800; line-height: 64rpx; letter-spacing: -1rpx; }
.intro-identity { color: #403936; font-size: 24rpx; font-weight: 700; line-height: 38rpx; }
.intro-where-when { display: grid; grid-template-columns: 78rpx minmax(0, 1fr); gap: 14rpx; margin-top: 6rpx; color: #6f625d; font-size: 23rpx; line-height: 36rpx; }
.intro-where-when > text { color: #c6536b; font-weight: 700; }
.intro-where-when view text { display: block; }
.content-card { margin-bottom: 24rpx; padding: 36rpx 32rpx 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; }
.section-title, .journey-meta { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-title { margin-bottom: 24rpx; }
.section-title text:first-child { color: #221e1c; font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.section-title text:last-child, .journey-meta text:last-child { color: #8a7d77; font-size: 20rpx; line-height: 28rpx; }
.journey-meta text:first-child { color: #c6536b; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.journey-title { display: block; margin-top: 16rpx; color: #171717; font-size: 36rpx; font-weight: 800; line-height: 50rpx; }
.journey-lead { display: block; margin-top: 8rpx; color: #6f625d; font-size: 25rpx; line-height: 42rpx; }
.journey-list { margin-top: 30rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: #fffaf8; }
.journey-node { display: grid; min-width: 0; grid-template-columns: 38rpx minmax(0, 1fr); gap: 16rpx; min-height: 64rpx; }
.journey-rail { display: flex; align-items: center; flex-direction: column; }
.journey-number { z-index: 1; display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border: 2rpx solid #ddd2ce; border-radius: 50%; color: #8a7d77; background: #fff; font-size: 19rpx; font-weight: 700; line-height: 28rpx; }
.journey-line { width: 2rpx; min-height: 28rpx; flex: 1; background: #eadfdb; }
.journey-node.done .journey-line { background: #f0787e; }
.journey-node.done .journey-number { border-color: #f0787e; background: #f0787e; }
.journey-node.active .journey-number { border-color: #f0787e; color: #c6536b; box-shadow: 0 0 0 7rpx #fff0f1; }
.journey-copy { display: flex; min-width: 0; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding: 2rpx 0 22rpx; }
.journey-copy > text:first-child { color: #8a7d77; font-size: 23rpx; line-height: 34rpx; }
.journey-node.active .journey-copy > text:first-child { color: #c6536b; font-weight: 700; }
.journey-node.done .journey-copy > text:first-child { color: #5f5550; }
.journey-copy > text:last-child:not(:first-child) { padding: 3rpx 12rpx; border-radius: 999rpx; color: #c6536b; background: #fff0f1; font-size: 18rpx; font-weight: 700; line-height: 28rpx; }
.mini-check { width: 14rpx; height: 8rpx; border-bottom: 3rpx solid #fff; border-left: 3rpx solid #fff; transform: translateY(-2rpx) rotate(-45deg); }
.stage-body { margin-top: 34rpx; padding-top: 30rpx; border-top: 1rpx solid #eee3df; }
.stage-focus { display: grid; grid-template-columns: 42rpx minmax(0, 1fr); gap: 18rpx; padding: 20rpx 0; }
.stage-focus + .stage-focus { border-top: 1rpx solid #f1e8e5; }
.focus-number { display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 14rpx; color: #fff; background: #f0787e; font-size: 21rpx; font-weight: 800; line-height: 30rpx; }
.stage-focus text, .privacy-panel text, .communication-banner text, .responsibility-grid text, .group-heading text, .fact-item text, .service-card text, .statement-card text, .reference-card text, .confirm-item text, .waiting-panel text, .payment-panel text, .production-hero text, .production-progress text { display: block; }
.stage-focus text:first-child { color: #25211f; font-size: 27rpx; font-weight: 700; line-height: 40rpx; }
.stage-focus text:nth-child(2) { margin-top: 4rpx; color: #6f625d; font-size: 23rpx; line-height: 38rpx; }
.response-chip { display: inline-flex !important; width: fit-content; margin-top: 12rpx !important; padding: 7rpx 14rpx; border-radius: 999rpx; color: #9a6509 !important; background: #fff4d9; font-size: 20rpx !important; font-weight: 600; line-height: 30rpx !important; }
.privacy-panel, .communication-banner, .production-hero { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx; border-radius: 24rpx; background: #fff7f3; }
.privacy-panel { margin-top: 20rpx; }
.privacy-icon { position: relative; width: 34rpx; height: 40rpx; flex: 0 0 34rpx; margin-top: 2rpx; }
.lock-loop { position: absolute; top: 0; left: 7rpx; width: 20rpx; height: 20rpx; border: 3rpx solid #c6536b; border-bottom: 0; border-radius: 12rpx 12rpx 0 0; }
.lock-body { position: absolute; right: 2rpx; bottom: 0; left: 2rpx; height: 24rpx; border-radius: 8rpx; background: #f0787e; }
.privacy-panel text:first-child, .communication-banner text:first-child, .production-hero text:first-child { color: #803c49; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.privacy-panel text:last-child, .communication-banner text:last-child, .production-hero text:last-child { margin-top: 2rpx; color: #765f59; font-size: 22rpx; line-height: 36rpx; }
.next-panel { display: grid; grid-template-columns: 104rpx minmax(0, 1fr); gap: 16rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #eee3df; }
.next-panel text:first-child { color: #c6536b; font-size: 22rpx; font-weight: 700; line-height: 36rpx; }
.next-panel text:last-child { color: #5f5550; font-size: 23rpx; line-height: 38rpx; }
.step-2 { border-color: #d6eadf; }
.step-2 .journey-meta text:first-child { color: #208a66; }
.communication-banner { background: #edf8f3; }
.pulse-dot { width: 18rpx; height: 18rpx; flex: 0 0 18rpx; margin-top: 8rpx; border: 6rpx solid #d6f1e5; border-radius: 50%; background: #44a581; }
.communication-banner text:first-child { color: #236f57; }
.communication-banner text:last-child { color: #547067; }
.responsibility-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.responsibility-grid view { padding: 22rpx; border: 1rpx solid #eadfdb; border-radius: 22rpx; background: #fffdfc; }
.responsibility-grid text:first-child { color: #25211f; font-size: 23rpx; font-weight: 700; line-height: 34rpx; }
.responsibility-grid text:last-child { margin-top: 6rpx; color: #6f625d; font-size: 21rpx; line-height: 34rpx; }
.agreement-body { display: flex; flex-direction: column; gap: 20rpx; }
.agreement-group { padding: 26rpx; border: 1rpx solid #eee3df; border-radius: 28rpx; background: #fffaf8; }
.group-heading { display: grid; grid-template-columns: 44rpx minmax(0, 1fr); gap: 16rpx; align-items: start; }
.group-index { display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 14rpx; color: #fff; background: #f0787e; font-size: 21rpx; font-weight: 800; line-height: 30rpx; }
.group-heading text:first-child { color: #25211f; font-size: 26rpx; font-weight: 800; line-height: 38rpx; }
.group-heading text:last-child { margin-top: 2rpx; color: #7a6d67; font-size: 20rpx; line-height: 32rpx; }
.fact-stack, .confirm-stack { margin-top: 20rpx; border-radius: 20rpx; background: #fff; overflow: hidden; }
.fact-item { padding: 18rpx 20rpx; }
.fact-item + .fact-item, .confirm-item + .confirm-item { border-top: 1rpx solid #f0e6e2; }
.fact-item text:first-child { color: #8a7d77; font-size: 19rpx; line-height: 28rpx; }
.fact-item text:last-child { margin-top: 4rpx; color: #302a27; font-size: 23rpx; font-weight: 600; line-height: 36rpx; word-break: break-all; }
.schedule-fact > text:nth-child(2) { margin-top: 4rpx; color: #302a27; font-size: 23rpx; font-weight: 600; line-height: 36rpx; }
.schedule-fact > view { margin-top: 8rpx; }
.schedule-fact > view text { display: block; color: #6f625d; font-size: 21rpx; font-weight: 400; line-height: 34rpx; }
.service-card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 20rpx; padding: 20rpx; border-radius: 20rpx; background: #fff; }
.service-card view text:first-child { color: #302a27; font-size: 24rpx; font-weight: 700; line-height: 36rpx; }
.service-card view text:last-child { margin-top: 2rpx; color: #208a66; font-size: 19rpx; line-height: 30rpx; }
.service-card > text { color: #c6536b; font-size: 26rpx; font-weight: 800; line-height: 38rpx; }
.statement-card, .reference-card { margin-top: 14rpx; padding: 20rpx; border-radius: 20rpx; background: #fff; }
.statement-card text:first-child, .reference-card text:first-child { color: #8a7d77; font-size: 19rpx; line-height: 28rpx; }
.statement-card text:last-child, .reference-card text:last-child { margin-top: 6rpx; color: #514843; font-size: 22rpx; line-height: 36rpx; }
.reference-card { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.reference-card image { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 18rpx; }
.confirm-item { display: grid; grid-template-columns: 30rpx minmax(0, 1fr); gap: 14rpx; padding: 18rpx 20rpx; }
.confirm-tick { width: 20rpx; height: 11rpx; margin-top: 8rpx; border-bottom: 4rpx solid #44a581; border-left: 4rpx solid #44a581; transform: rotate(-45deg); }
.confirm-item text:first-child { color: #302a27; font-size: 23rpx; font-weight: 700; line-height: 34rpx; }
.confirm-item text:last-child { margin-top: 2rpx; color: #6f625d; font-size: 20rpx; line-height: 32rpx; }
.confirm-item .confirm-schedule-line { margin-top: 4rpx; color: #6f625d; font-size: 20rpx; font-weight: 400; line-height: 32rpx; }
.required-summary, .waiting-panel { padding: 22rpx; border-radius: 22rpx; color: #7a5148; background: #fff3ef; font-size: 21rpx; line-height: 34rpx; }
.required-summary > text { display: block; margin-top: 6rpx; }
.required-heading { display: flex; align-items: center; gap: 10rpx; color: #b5434e; font-weight: 700; }
.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d83b46; }
.waiting-panel text:first-child { color: #803c49; font-size: 23rpx; font-weight: 700; line-height: 34rpx; }
.waiting-panel text:last-child { margin-top: 4rpx; }
.payment-panel { padding: 26rpx; border: 2rpx solid #f2c8c4; border-radius: 28rpx; background: #fff8f5; }
.payment-panel > view { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.payment-panel > view text:first-child { color: #302a27; font-size: 24rpx; font-weight: 800; line-height: 36rpx; }
.payment-panel > view text:last-child { margin-top: 3rpx; color: #7a6d67; font-size: 20rpx; line-height: 32rpx; }
.payment-panel > text { margin-top: 18rpx; color: #c6536b; font-size: 42rpx; font-weight: 800; line-height: 52rpx; }
.production-hero { background: #edf8f3; }
.production-icon { display: flex; width: 46rpx; height: 46rpx; flex: 0 0 46rpx; align-items: center; justify-content: center; border-radius: 50%; background: #44a581; }
.production-check { width: 19rpx; height: 11rpx; border-bottom: 4rpx solid #fff; border-left: 4rpx solid #fff; transform: translateY(-2rpx) rotate(-45deg); }
.production-hero text:first-child { color: #236f57; }
.production-hero text:last-child { color: #547067; }
.production-progress { margin-top: 24rpx; padding: 24rpx; border-radius: 22rpx; background: #fffaf8; }
.production-progress > view { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.production-progress text:first-child { color: #302a27; font-size: 23rpx; font-weight: 700; line-height: 34rpx; }
.production-progress text:last-child { color: #c6536b; font-size: 23rpx; font-weight: 800; line-height: 34rpx; }
.result-copy, .result-help { display: block; color: #4f4743; font-size: 26rpx; line-height: 42rpx; }
.result-help { margin-top: 16rpx; color: #6f625d; font-size: 24rpx; line-height: 40rpx; }
.failed-card { border-color: #efd2d2; background: #fffdfc; }
.primary-block { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 24rpx; padding: 20rpx 32rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; font-size: 28rpx; font-weight: 700; line-height: 40rpx; text-align: center; }
.primary-block.blocked, .primary-block[disabled] { color: #a99c96; background: #eee8e5; opacity: 1; box-shadow: none; }
.text-action { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 8rpx; padding: 20rpx 24rpx; border: 0; color: #6f625d; background: transparent; box-shadow: none; font-size: 26rpx; font-weight: 500; line-height: 40rpx; }
.form-stack { display: flex; flex-direction: column; gap: 24rpx; }
.field-label { font-size: 22rpx; font-weight: 600; line-height: 34rpx; }
.supplement-input { width: 100%; min-height: 180rpx; padding: 20rpx 22rpx; border: 1rpx solid #d9d0d9; border-radius: 22rpx; background: #fcfbfc; font-size: 24rpx; line-height: 38rpx; }
.form-stack .primary-block { margin-top: 0; }
.required-note { display: flex; align-items: flex-start; gap: 10rpx; color: #b5434e; font-size: 22rpx; line-height: 34rpx; }
.empty-retry { display: flex; width: auto; min-height: 80rpx; margin: 24rpx auto 0; padding: 18rpx 40rpx; align-items: center; justify-content: center; border: 2rpx solid #f3b3ad; border-radius: 24rpx; color: #a64459; background: #fff4ef; font-size: 26rpx; font-weight: 700; }
