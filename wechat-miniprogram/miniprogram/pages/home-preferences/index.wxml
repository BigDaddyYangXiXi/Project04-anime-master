<app-top-nav title="广场偏好" show-back="{{true}}"/>
<view class="home-preferences">
 <text class="preferences-title">先看你喜欢的职业</text>
 <text class="preferences-copy">第一项将作为广场首页默认职业。</text>
 <view class="preferences-list">
  <view wx:for="{{items}}" wx:key="name" class="preferences-row {{index === 0 ? 'preferences-first' : ''}}">
   <image class="preferences-icon" src="{{item.asset}}" mode="aspectFit"/>
   <view class="preferences-name"><text>{{item.name}}</text><text wx:if="{{index === 0}}" class="preferences-default">首页默认</text><button wx:else hover-class="none" class="preferences-set" data-index="{{index}}" bindtap="makeFirst">设为默认</button></view>
   <button hover-class="none" class="preferences-move" aria-label="上移{{item.name}}" aria-disabled="{{index === 0}}" data-am-disabled="{{index === 0}}" data-index="{{index}}" data-delta="-1" bindtap="{{(index === 0) ? '' : 'move'}}">↑</button>
   <button hover-class="none" class="preferences-move" aria-label="下移{{item.name}}" aria-disabled="{{index === items.length - 1}}" data-am-disabled="{{index === items.length - 1}}" data-index="{{index}}" data-delta="1" bindtap="{{(index === items.length - 1) ? '' : 'move'}}">↓</button>
  </view>
 </view>
 <text wx:if="{{error}}" class="preferences-error">{{error}}</text>
</view>
<view class="preferences-footer"><button hover-class="none" class="am-action am-action-primary am-action-block" bindtap="save">保存顺序</button></view>
