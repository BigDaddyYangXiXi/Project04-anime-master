page { background: var(--am-color-canvas); }
.auth-shell { max-width: var(--am-auth-max-width); margin: var(--am-space-none) auto; padding: var(--am-space-4) var(--am-space-6) calc(var(--am-space-6) + env(safe-area-inset-bottom)); }
.brand-scene { display: flex; flex-direction: column; align-items: center; padding: var(--am-space-4) var(--am-space-none) var(--am-space-6); }
.brand-visual { display: block; width: var(--am-auth-logo-width); height: var(--am-auth-logo-height); }
.brand-caption { margin-top: var(--am-space-4); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.auth-content { border-top: var(--am-border-control); padding-top: var(--am-space-6); }
.auth-title { display: block; color: var(--am-color-text); font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-page-title); }
.auth-subtitle { display: block; margin-top: var(--am-space-2); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.register-fields { margin-top: var(--am-space-6); }
.field-label { display: flex; justify-content: space-between; margin-bottom: var(--am-space-2); color: var(--am-color-text); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.field-count { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.nickname-input { width: 100%; }
.username-label { margin-top: var(--am-space-4); }
.nickname-placeholder { color: var(--am-color-text-secondary); }
.nickname-input:focus { border-color: var(--am-color-brand); }
.nickname-input.invalid { border-color: var(--am-color-danger); }
.notice-line { display: flex; align-items: flex-start; margin-top: var(--am-space-2); }
page button.notice-row, page button.notice-link, page button.switch-button, page button.retry-button { display: flex; width: auto; min-height: var(--am-touch-min); margin: var(--am-space-none); padding: var(--am-space-1) var(--am-space-none); align-items: center; background: var(--am-color-transparent); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); text-align: left; }
page button.notice-row { gap: var(--am-space-2); color: var(--am-color-text-secondary); }
page button.notice-link, page button.switch-button, page button.retry-button { color: var(--am-color-brand); }
.check-box { display: flex; width: var(--am-auth-checkbox); height: var(--am-auth-checkbox); flex: 0 0 var(--am-auth-checkbox); align-items: center; justify-content: center; border: var(--am-border-control); border-radius: var(--am-radius-tag); background: var(--am-color-control-surface); }
.notice-row.checked .check-box { border-color: var(--am-color-brand); background: var(--am-color-brand); }
.notice-row.checked .check-box view { width: var(--am-space-2); height: var(--am-space-1); border-bottom: var(--am-auth-check-stroke); border-left: var(--am-auth-check-stroke); transform: rotate(-45deg); }
.auth-actions { margin-top: var(--am-space-6); }
page button.primary-button { display: flex; width: 100%; align-items: center; justify-content: center; }
page button.identity-button { display: flex; width: 100%; min-height: var(--am-touch-min); align-items: center; justify-content: center; margin-top: var(--am-space-2); color: var(--am-color-text-secondary); background: var(--am-color-transparent); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); }
.auth-footer { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--am-space-2); margin-top: var(--am-space-4); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.identity-button:active, .switch-button:active, .notice-row:active, .notice-link:active { opacity: var(--am-opacity-pressed); }
.primary-button[data-am-disabled="true"], .identity-button[data-am-disabled="true"], .switch-button[data-am-disabled="true"] { opacity: var(--am-opacity-disabled); }
page button.notice-row[data-am-disabled="true"]:not([type]), page button.identity-button[data-am-disabled="true"]:not([type]) { background: var(--am-color-transparent); color: var(--am-color-text-secondary); }
page button.notice-link[data-am-disabled="true"]:not([type]), page button.switch-button[data-am-disabled="true"]:not([type]), page button.retry-button[data-am-disabled="true"]:not([type]) { background: var(--am-color-transparent); color: var(--am-color-brand); }
.error-panel { margin-top: var(--am-space-3); padding: var(--am-space-3); border-radius: var(--am-radius-control); background: var(--am-color-control-surface); }
.error-message, .field-error { display: block; color: var(--am-color-danger); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.field-error { margin-top: var(--am-space-2); }
.status-block { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.auth-opening { padding-top: var(--am-auth-opening-top); }
.auth-opening .brand-scene { padding-bottom: var(--am-space-8); }
.auth-opening .auth-content { border-top: var(--am-border-none); }
.auth-opening .auth-title { font-size: var(--am-type-section-title); line-height: var(--am-line-section-title); }
.loading-mark { display: flex; gap: var(--am-space-2); margin-bottom: var(--am-space-4); }
.loading-mark view { width: var(--am-space-2); height: var(--am-space-2); border-radius: var(--am-radius-pill); background: var(--am-color-brand); animation: auth-pulse 900ms ease-in-out infinite; }
.loading-mark view:nth-child(2) { animation-delay: 150ms; }
.loading-mark view:nth-child(3) { animation-delay: 300ms; }
.success-mark { display: none; }
@keyframes auth-pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .loading-mark view { animation: none; } }

.notice-line .notice-row { width: var(--am-touch-min); flex: 0 0 var(--am-touch-min); justify-content: center; }
.notice-links { flex: 1; min-width: 0; padding-top: var(--am-space-3); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.notice-links .notice-link { color: var(--am-color-brand); }
