.auth-shell {
  min-height: 100vh;
  padding: 64rpx 48rpx calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #fff9ed;
}

.auth-content { width: 100%; max-width: 640rpx; margin: 0 auto; }
.app-mark { display: block; width: 112rpx; height: 112rpx; margin-bottom: 48rpx; border: 4rpx solid transparent; border-radius: 36rpx; background: linear-gradient(#fff, #fff) padding-box, linear-gradient(135deg, #fbc5c4, #fce4ab, #c2e8d6, #c0caf8, #fbbfd2) border-box; }
.auth-form, .status-block { width: 100%; }
.status-block { display: flex; min-height: 360rpx; flex-direction: column; align-items: center; justify-content: center; }
.auth-title { display: block; color: #4b3048; font-size: 48rpx; font-weight: 800; line-height: 64rpx; }
.auth-subtitle { display: block; min-height: 40rpx; margin-top: 8rpx; overflow: hidden; color: #616161; font-size: 26rpx; line-height: 40rpx; text-overflow: ellipsis; white-space: nowrap; }
.register-fields { margin-top: 40rpx; }
.nickname-input { width: 100%; height: 96rpx; padding: 0 28rpx; border: 2rpx solid #bdbdbd; border-radius: 16rpx; background: #fff; color: #4b3048; font-size: 28rpx; }
.nickname-input:focus { border-color: #ff9b4a; }
.nickname-input.invalid { border-color: #d83b46; background: #fff; }
.notice-row { display: flex; width: 100%; min-height: 88rpx; align-items: center; gap: 16rpx; padding: 12rpx 0; color: #616161; background: transparent; text-align: left; }
.notice-row text { flex: 1; font-size: 24rpx; line-height: 36rpx; }
.check-box { display: flex; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; border: 2rpx solid #bdbdbd; border-radius: 8rpx; background: #fff; }
.notice-row.checked .check-box { border-color: #ff9b4a; background: #ff9b4a; }
.notice-row.checked .check-box view { width: 16rpx; height: 8rpx; border-bottom: 4rpx solid #4b3048; border-left: 4rpx solid #4b3048; transform: rotate(-45deg) translate(1rpx, -1rpx); }
.auth-actions { display: flex; flex-direction: column; gap: 24rpx; margin-top: 48rpx; }
.primary-button, .phone-button, .switch-button { display: flex; width: 100%; align-items: center; justify-content: center; font-weight: 700; }
.primary-button, .phone-button { min-height: 88rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 40rpx; }
.primary-button { color: #4b3048; background: linear-gradient(135deg, #ff9b4a, #ffd85a); }
.primary-button:active { opacity: .84; transform: translateY(1rpx); }
.primary-button.incomplete, .phone-button.incomplete { opacity: .72; }
.primary-button[disabled], .phone-button[disabled] { opacity: .52; }
.switch-button { min-height: 88rpx; margin-top: 20rpx; color: #b64f1f; background: transparent; font-size: 26rpx; line-height: 40rpx; }
.switch-button:active, .notice-row:active { opacity: .62; }
.privacy-note { display: block; color: #616161; font-size: 22rpx; line-height: 34rpx; text-align: center; }
.field-error { display: block; margin-top: 8rpx; color: #d83b46; font-size: 24rpx; line-height: 36rpx; }
.error-message { display: block; margin-top: 24rpx; color: #d83b46; font-size: 26rpx; line-height: 40rpx; text-align: center; }
.loading-mark { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-bottom: 24rpx; }
.loading-mark view { width: 10rpx; height: 10rpx; border-radius: 50%; background: #ff9b4a; animation: auth-pulse 900ms ease-in-out infinite; }
.loading-mark view:nth-child(2) { animation-delay: 150ms; }
.loading-mark view:nth-child(3) { animation-delay: 300ms; }
.success-mark { display: flex; width: 80rpx; height: 80rpx; align-items: center; justify-content: center; margin-bottom: 24rpx; border: 4rpx solid #65d5bd; border-radius: 50%; background: #fff; }
.success-mark view { width: 30rpx; height: 16rpx; border-bottom: 6rpx solid #4b3048; border-left: 6rpx solid #4b3048; transform: rotate(-45deg) translate(3rpx, -3rpx); }
@keyframes auth-pulse { 0%, 100% { opacity: .32; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-6rpx); } }
@media (prefers-reduced-motion: reduce) { .loading-mark view { animation: none; } }
@media (min-width: 600px) { .auth-shell { padding-right: 64rpx; padding-left: 64rpx; } }
