<app-top-nav class="app-navigation" title="交付验收" show-back="{{true}}"/>
<block wx:if="{{loading && !order}}"></block>
<view class="am-editor-form fulfillment-shell" wx:elif="{{order}}">
  <view class="page-intro">
    <text class="intro-title">{{order.stage === 'COMPLETED' ? '本订单已完成' : '检查本次完成结果'}}</text>
    <text class="intro-copy">{{order.stage === 'COMPLETED' ? '查看已验收的交付内容与合作记录。' : '先核对交付或现场完成情况，再选择申请修改或确认验收。'}}</text>
  </view>
  <order-subscription id="order-subscription" wx:if="{{order.cloudOrder && order.stage !== 'COMPLETED' && order.stage !== 'DECLINED'}}" order-id="{{order.id}}"/>

  <view wx:if="{{!validStage}}" class="empty-state action-state">
    <text class="empty-title">当前没有待验收结果</text>
    <text class="empty-copy">服务方提交现场完成确认或交付文件后，本订单会进入这里。</text>
    <button hover-class="none" class="am-action am-action-primary" bindtap="goOrders">返回订单列表</button>
  </view>

  <block wx:else>
    <view class="content-card facts-card">
      <view class="section-title order-fact-heading"><text class="order-fact-heading-line">已经确认的合作信息</text><text class="order-fact-heading-line">{{order.id}}</text></view>
      <text class="am-identity-full counterpart-line">{{providerIdentity.nickname}}</text>
      <view class="order-fact-stack">
        <view class="order-fact-item"><view class="order-fact-copy"><text>地点与时间</text><text>{{order.city}} · {{schedule.mode}}</text><view class="order-fact-schedule"><text wx:for="{{schedule.lines}}" wx:key="label">{{item.label}} · {{item.text}}</text></view></view></view>
        <view class="order-fact-item"><view class="order-fact-copy"><text>服务内容</text><text>{{order.service}}</text></view></view>
        <view class="order-fact-item"><view class="order-fact-copy"><text>交付与验收</text><text>{{onsite ? '现场服务完成后由需求方确认验收' : '服务方提交文件后由需求方验收'}}</text></view></view>
        <view class="order-fact-item"><view class="order-fact-copy"><text>合作金额</text><text class="am-money am-money-inline">合计 ￥{{order.finalPrice}}</text></view></view>
      </view>
    </view>

    <brand-success-card
      wx:if="{{order.stage === 'COMPLETED'}}"
      eyebrow="验收完成"
      title="这次合作顺利收官"
      copy="验收结果已经写入本订单，现在可以评价服务方。"
      action-text="评价本次服务"
      bind:action="goReview"
    />

    <view wx:if="{{onsite}}" class="demand-card">
      <text class="demand-kicker">服务方提交的完成说明</text>
      <text class="demand-title">现场服务完成确认</text>
      <text class="demand-copy">{{order.deliveryNote || '服务方已确认现场工作完成，请核对约定内容后确认验收。'}}</text>
    </view>

    <view wx:else class="content-card delivery-card">
      <view class="section-title"><text>交付物</text><text>{{order.deliveryFiles.length}} 个文件</text></view>
      <view class="delivery-grid">
        <button aria-disabled="{{actionPending}}" hover-class="none" wx:for="{{order.deliveryFiles}}" wx:key="fileId" class="delivery-file" data-index="{{index}}" data-am-disabled="{{actionPending}}" bindtap="{{(actionPending) ? '' : 'openDeliveryFile'}}">
          <text class="file-mark">文件</text><text>{{item.name}}</text>
        </button>
        <text wx:if="{{!order.deliveryFiles.length}}" class="empty-files">暂无文件</text>
      </view>
      <text class="delivery-note">{{order.deliveryNote}}</text>
    </view>

    <view wx:if="{{order.stage === 'DELIVERY_PENDING'}}" class="content-card form-stack">
      <text class="field-label">{{onsite ? '现场问题说明（有问题时必填）' : '修改意见（申请修改时必填）'}}</text>
      <textarea class="am-textarea" value="{{revision}}" bindinput="updateRevision"></textarea>
      <text class="helper-copy">只有申请修改／反馈问题时需要填写；确认验收不会提交此草稿。</text>
      <view wx:if="{{acceptIssues.length}}" class="required-summary"><view class="required-heading"><view class="required-dot"></view><text>确认验收前还需完成</text></view><text wx:for="{{acceptIssues}}" wx:key="*this">{{item}}</text></view>
      <view class="two-actions">
        <button aria-disabled="{{!canRevise || actionPending}}" hover-class="none" class="secondary-button am-action am-action-secondary" data-am-disabled="{{!canRevise || actionPending}}" bindtap="{{(!canRevise || actionPending) ? '' : 'revise'}}">{{onsite ? '反馈问题' : '申请修改'}}</button>
        <button hover-class="none" class="primary-button {{!canAccept ? 'blocked' : ''}} am-action am-action-primary" data-am-disabled="{{actionPending}}" aria-disabled="{{(actionPending) || (!canAccept)}}" bindtap="{{(actionPending) ? '' : 'accept'}}">{{actionPending ? '正在同步' : onsite ? '确认服务完成' : '确认验收完成'}}</button>
      </view>
    </view>

  </block>
</view>

<view wx:else class="empty-page"><text class="empty-page-title">{{loadError || '没有找到订单'}}</text><button hover-class="none" wx:if="{{loadError}}" bindtap="retryLoad">重新加载</button></view>
<main-bottom-nav/>
