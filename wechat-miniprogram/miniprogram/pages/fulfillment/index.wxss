@import "../../styles/order-facts.wxss";
.fulfillment-shell { padding: var(--am-detail-nav-page-padding); }
.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6); }
.page-intro text { display: block; }
.intro-title { margin: 0 0 12rpx; font-size: var(--am-status-title-size); font-weight: var(--am-weight-semibold); line-height: var(--am-status-title-line); letter-spacing: normal; }
.intro-copy { color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.content-card, .action-state { margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: var(--am-space-3); }
.section-title text:first-child { font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.section-title text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.counterpart-line { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.demand-card { margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: 1rpx solid var(--am-color-border); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.demand-card text { display: block; }
.demand-kicker { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); letter-spacing: 2rpx; }
.demand-title { margin: 12rpx 0 14rpx; font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.demand-copy, .delivery-note { color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.delivery-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin-bottom: 20rpx; }
.delivery-file { width: 100%; min-width: 0; min-height: 184rpx; margin: var(--am-space-none); display: flex; flex-direction: column; justify-content: space-between; padding: 12rpx; border: 1rpx solid var(--am-color-border); border-bottom: 4rpx solid var(--am-color-border); border-radius: 16rpx; background: var(--am-color-canvas); color: var(--am-color-text-secondary); line-height: normal; text-align: left; overflow: hidden; }
.delivery-file::after { border: 0; }
.delivery-file text:last-child { overflow: hidden; font-size: var(--am-type-caption); line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.file-mark { flex: 1; display: grid; place-items: center; border-radius: 10rpx; background: var(--am-color-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); }
.empty-files { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.form-stack { display: flex; flex-direction: column; gap: 20rpx; }
.field-label { font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.form-stack textarea { width: 100%; min-height: 180rpx;       }
.helper-copy { color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.required-summary { display: flex; padding: 20rpx 22rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid var(--am-color-border); border-radius: 22rpx; color: var(--am-color-danger); background: var(--am-color-danger-surface); font-size: var(--am-type-micro); line-height: 34rpx; }.required-heading { display: flex; align-items: center; gap: 10rpx; color: var(--am-color-danger); font-weight: var(--am-weight-semibold); }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: var(--am-color-danger); box-shadow: var(--am-shadow-none); }
.two-actions { display: grid; grid-template-columns: 1fr 1.5fr; gap: 18rpx; }

.two-actions button { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
.primary-block { display: block; width: 100%; margin-top: var(--am-space-3); }
brand-success-card { display: block; margin-bottom: var(--am-space-3); }
.action-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: var(--am-space-2); text-align: center; }
.empty-title { font-size: 30rpx; font-weight: var(--am-weight-semibold); line-height: 42rpx; }.empty-copy { max-width: 520rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-line-label); }.action-state button { min-width: 320rpx; margin-top: var(--am-space-2); }

@import "../../styles/money.wxss";

@import "../../styles/editor-form.wxss";
