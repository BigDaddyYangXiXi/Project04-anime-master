@import "../../styles/order-facts.wxss";
.fulfillment-shell { padding: 20rpx 32rpx 80rpx; }
.page-intro { padding: 20rpx 8rpx 32rpx; }
.page-intro text { display: block; }
.intro-title { margin: 0 0 12rpx; font-size: 52rpx; font-weight: 800; line-height: 64rpx; letter-spacing: -1rpx; }
.intro-copy { color: #6f625d; font-size: 26rpx; line-height: 40rpx; }
.content-card, .action-state { margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 24rpx; }
.section-title text:first-child { font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.section-title text:last-child { color: #6f625d; font-size: 22rpx; line-height: 34rpx; }
.counterpart-line { display: block; color: #6f625d; font-size: 22rpx; font-weight: 700; line-height: 34rpx; }
.demand-card { margin-bottom: 24rpx; padding: 34rpx; border: 1rpx solid #f1cdd0; border-radius: 38rpx; background: linear-gradient(145deg,#fff1ed,#f3fbf7); box-shadow: 0 16rpx 48rpx rgba(176,91,108,.08); }
.demand-card text { display: block; }
.demand-kicker { color: #c6536b; font-size: 24rpx; font-weight: 800; line-height: 36rpx; letter-spacing: 2rpx; }
.demand-title { margin: 12rpx 0 14rpx; font-size: 34rpx; font-weight: 800; line-height: 46rpx; }
.demand-copy, .delivery-note { color: #6f625d; font-size: 26rpx; line-height: 40rpx; }
.delivery-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; margin-bottom: 20rpx; }
.delivery-file { width: 100%; min-width: 0; min-height: 184rpx; margin: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 12rpx; border: 1rpx solid #e2d5d1; border-bottom: 4rpx solid #ff6f71; border-radius: 16rpx; background: #fff8f3; color: #8f3f4f; line-height: normal; text-align: left; overflow: hidden; }
.delivery-file::after { border: 0; }
.delivery-file text:last-child { overflow: hidden; font-size: 20rpx; line-height: 30rpx; text-overflow: ellipsis; white-space: nowrap; }
.file-mark { flex: 1; display: grid; place-items: center; border-radius: 10rpx; background: linear-gradient(145deg,#ffe1d9,#ffd9dc); font-size: 20rpx; font-weight: 800; }
.empty-files { color: #6f625d; font-size: 24rpx; }
.form-stack { display: flex; flex-direction: column; gap: 20rpx; }
.field-label { font-size: 22rpx; font-weight: 600; line-height: 34rpx; }
.form-stack textarea { width: 100%; min-height: 180rpx; padding: 20rpx 22rpx; border: 1rpx solid #d9d0d9; border-radius: 22rpx; background: #fcfbfc; font-size: 24rpx; line-height: 38rpx; }
.helper-copy { color: #6f625d; font-size: 22rpx; line-height: 34rpx; }
.required-summary { display: flex; padding: 20rpx 22rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid #efb6b8; border-radius: 22rpx; color: #9b3542; background: #fff0f1; font-size: 22rpx; line-height: 34rpx; }.required-heading { display: flex; align-items: center; gap: 10rpx; color: #7b2633; font-weight: 800; }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: #d83b46; box-shadow: 0 0 0 6rpx rgba(255,255,255,.7); }
.two-actions { display: grid; grid-template-columns: 1fr 1.5fr; gap: 18rpx; }
.two-actions button, .primary-block, .action-state button { min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: 26rpx; font-weight: 700; line-height: 40rpx; }
.two-actions button { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
.secondary-button[disabled] { opacity: .4; }
.primary-button, .primary-block, .action-state button { color: #fff; border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; }
.primary-button.blocked { opacity: .42; box-shadow: none; }
.primary-block { display: block; width: 100%; margin-top: 24rpx; }
brand-success-card { display: block; margin-bottom: 24rpx; }
.action-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; text-align: center; }
.empty-title { font-size: 30rpx; font-weight: 800; line-height: 42rpx; }.empty-copy { max-width: 520rpx; color: #6f625d; font-size: 26rpx; line-height: 40rpx; }.action-state button { min-width: 320rpx; margin-top: 16rpx; }
