.dashboard-shell { padding: var(--am-detail-nav-page-padding); }
.dashboard-head { display: flex; min-width: 0; align-items: center; gap: var(--am-space-3); padding: var(--am-space-3) var(--am-space-none) var(--am-space-4); border-radius: 0; background: transparent; color: var(--am-color-text); }
.dashboard-copy { min-width: 0; flex: 1; }
.dashboard-head text { display: block; }
.dashboard-title { margin-top: var(--am-space-none); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); overflow-wrap: anywhere; }
.dashboard-subtitle { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.dashboard-greeting { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.avatar-large { display: flex; flex: 0 0 var(--am-touch-min); width: var(--am-touch-min); height: var(--am-touch-min); align-items: center; justify-content: center; overflow: hidden; border-radius: var(--am-radius-avatar); background: linear-gradient(145deg,#ef7d83,#ed8c68); color: var(--am-color-text); text-align: center; font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-touch-min); }
.avatar-image{display: block}
.metric-row { display: flex; gap: var(--am-space-2); margin-bottom: var(--am-space-3); }
.metric-row button { flex: 1; min-width: 0; min-height: 112rpx; padding: 20rpx 8rpx; border: 1rpx solid var(--am-color-border); border-radius: 30rpx; background: var(--am-color-surface); }
.metric-row text { display: block; }
.metric-count { color: var(--am-color-brand); font-size: 40rpx; font-weight: var(--am-weight-semibold); }
.metric-label { margin-top: 6rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.content-card { width: 100%; margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.section-title { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: var(--am-space-3); }
.section-title text:first-child, .tools-title { color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); }
.section-title text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); }
.priority-section { padding: var(--am-space-3); }
.priority-section .section-title { margin-bottom: var(--am-space-2); padding: var(--am-space-none) var(--am-space-1); }
.priority-list { overflow: hidden; border: 1rpx solid var(--am-color-border); border-radius: 24rpx; background: var(--am-color-surface); }
.attention-card, .priority-more { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 112rpx; margin: var(--am-space-none); padding: 18rpx 20rpx; align-items: center; gap: var(--am-space-2); border-bottom: 1rpx solid var(--am-color-border); background: var(--am-color-surface); text-align: left; }
.attention-card:last-child, .priority-more:last-child { border-bottom: 0; }
.attention-card:active, .priority-more:active { background: var(--am-color-control-surface); }
.attention-main { min-width: 0; flex: 1; }
.attention-primary, .attention-secondary { display: flex; min-width: 0; align-items: center; }
.attention-primary { gap: 12rpx; }
.attention-secondary { gap: var(--am-space-2); margin-top: var(--am-space-1); }
.status-dot { flex: 0 0 auto; padding: 2rpx 10rpx; border-radius: 999rpx; background: var(--am-color-control-surface); color: var(--am-color-text-secondary); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 28rpx; }
.attention-title { min-width: 0; overflow: hidden; flex: 1; color: var(--am-color-text); font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); text-overflow: ellipsis; white-space: nowrap; }
.attention-meta { min-width: 0; overflow: hidden; flex: 1; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
.attention-id { flex: 0 0 auto; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.attention-chevron { flex: 0 0 auto; width: 14rpx; height: 14rpx; margin-right: 4rpx; border-top: 2rpx solid var(--am-color-border); border-right: 2rpx solid var(--am-color-border); transform: rotate(45deg); }
.priority-more { min-height: 88rpx; justify-content: space-between; color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 32rpx; }
.empty-state { padding: 72rpx 20rpx; text-align: center; }
.empty-state text { display: block; color: var(--am-color-text); font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); }
.empty-state text:last-child { margin-top: 12rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); font-weight: var(--am-weight-regular); line-height: 1.6; }
.timeline view { display: grid; grid-template-columns: 100rpx 1fr; padding: 18rpx 0; border-top: 1rpx solid var(--am-color-border); font-size: var(--am-type-caption); }
.timeline view:first-child { border-top: 0; }
.timeline text:first-child { color: var(--am-color-brand); font-weight: var(--am-weight-semibold); }
.timeline text:last-child { color: var(--am-color-text); }
.tools-title { display: block; margin-bottom: var(--am-space-3); }
.two-actions { display: flex; gap: 18rpx; margin-top: 18rpx; }
.two-actions button { flex: 1; min-width: 0; max-width: 100%; }
.primary-button { flex: 1.5 !important;    }

@import "../../styles/provider-workbench.wxss";
