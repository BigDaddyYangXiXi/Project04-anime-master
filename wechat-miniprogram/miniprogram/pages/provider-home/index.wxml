<app-top-nav class="app-navigation" title="服务方工作台" workspace="provider" show-back="{{false}}"/>
<view wx:if="{{profile}}" class="dashboard-shell">
  <view class="dashboard-head">
    <view class="dashboard-copy">
      <text class="dashboard-title">{{profile.nickname}}，今天先处理待办</text>
      <text class="dashboard-subtitle">主身份：{{career}} · 主页公开展示中</text>
    </view>
    <image wx:if="{{profile.avatar}}" class="avatar-large avatar-image" src="{{profile.avatar}}" mode="aspectFill"/><view wx:else class="avatar-large">{{profileInitial}}</view>
  </view>

  <view class="metric-row">
    <button wx:for="{{metrics}}" wx:key="flow" data-flow="{{item.flow}}" bindtap="openFlow">
      <text class="metric-count">{{item.count}}</text>
      <text class="metric-label">{{item.label}}</text>
    </button>
  </view>

  <view class="content-card priority-section">
    <view class="section-title"><text>优先处理</text><text>{{priorityTotal}} 条</text></view>
    <block wx:if="{{priorityOrders.length}}">
      <view class="priority-list">
        <button wx:for="{{priorityOrders}}" wx:key="id" class="attention-card" data-id="{{item.id}}" bindtap="openPriority" aria-label="打开{{item.buyer}}的预约详情">
          <view class="attention-main">
            <view class="attention-primary">
              <text class="status-dot">{{item.statusLabel}}</text>
              <text class="attention-title">{{item.buyer}} · {{item.service}}</text>
            </view>
            <view class="attention-secondary">
              <text class="attention-meta">{{item.city}} · {{item.time}}</text>
              <text class="attention-id">{{item.id}}</text>
            </view>
          </view>
          <view class="attention-chevron" aria-hidden="true"></view>
        </button>
        <button wx:if="{{remainingPriority > 0}}" class="priority-more" bindtap="openOrders">
          <text>查看其余 {{remainingPriority}} 条待办</text>
          <view class="attention-chevron" aria-hidden="true"></view>
        </button>
      </view>
    </block>
    <view wx:else class="empty-state"><text>当前没有紧急待办</text><text>新预约、待签 NDA 和修改任务会显示在这里。</text></view>
  </view>

  <view class="content-card">
    <view class="section-title"><text>橱窗概览</text><text>{{career}}</text></view>
    <view class="timeline"><view wx:for="{{overview}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}</text></view></view>
  </view>

  <view class="content-card tools-card">
    <text class="tools-title">管理工具</text>
    <view class="two-actions"><button class="secondary-button" bindtap="openOrders">全部订单</button><button class="primary-button" bindtap="openProfile">编辑橱窗</button></view>
    <view class="two-actions"><button class="secondary-button" bindtap="openCalendar">公开档期</button><button class="secondary-button" bindtap="openReviews">评价管理</button></view>
  </view>
</view>
