.brief-shell { padding: var(--am-detail-nav-page-padding); }
.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6); }
.page-intro text { display: block; }
.intro-title { margin: 0 0 12rpx; font-size: var(--am-status-title-size); font-weight: var(--am-weight-semibold); line-height: var(--am-status-title-line); letter-spacing: normal; }
.intro-copy { color: var(--am-color-text-secondary); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.source-note { display: flex; align-items: flex-start; gap: 18rpx; margin-bottom: 20rpx; padding: 22rpx 24rpx; border: 1rpx solid var(--am-color-border); border-radius: 28rpx; background: var(--am-color-control-surface); }
.source-note.has-source { border-color: var(--am-color-border); background: var(--am-color-success-surface); }
.source-icon { display: flex; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--am-color-text); background: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); }
.has-source .source-icon { background: var(--am-color-success); }
.source-check { width: 11rpx; height: 19rpx; border-right: 4rpx solid var(--am-color-border); border-bottom: 4rpx solid var(--am-color-border); transform: rotate(45deg) translate(-1rpx, -1rpx); }
.source-note text { display: block; }
.source-note text:first-child { font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); }
.source-note text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.content-card { padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface);  margin-bottom: var(--am-detail-section-gap);}
.form-stack { display: flex; flex-direction: column; gap: var(--am-space-3); }
.form-section { display: flex; flex-direction: column; gap: 14rpx; }
.description-section { padding-top: var(--am-space-3); border-top: 1rpx solid var(--am-color-border); }
.target-section { padding-top: var(--am-space-3); border-top: 1rpx solid var(--am-color-border); }
.target-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.target-heading > view { min-width: 0; }
.target-heading > view text { display: block; }
.target-heading > text { flex: 0 0 auto; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.target-editor-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }
.target-editor-item { position: relative; overflow: hidden; height: 180rpx; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; background: var(--am-color-control-surface); }
.target-editor-item image { width: 100%; height: 100%; }
.target-editor-item .field-hint { display: block; padding: var(--am-space-8) var(--am-space-2) var(--am-space-none); }
.remove-target { position: absolute; top: 8rpx; right: 8rpx; display: flex; width: 76rpx; height: 52rpx; align-items: center; justify-content: center; border: 1rpx solid var(--am-color-border); border-radius: 18rpx; color: var(--am-color-text); background: rgba(91,52,48,.78); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 32rpx; }
.target-empty { padding: 22rpx; border: 1rpx dashed var(--am-color-border); border-radius: 22rpx; background: var(--am-color-control-surface); }
.target-empty text { display: block; }
.target-empty text:first-child { color: var(--am-color-text); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.target-empty text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.upload-target { width: 100%; min-height: 76rpx; padding: var(--am-space-2) var(--am-space-3); border: 1rpx solid var(--am-color-border); border-radius: 22rpx; color: var(--am-color-brand); background: var(--am-color-control-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); box-shadow: none; }
.section-kicker { color: var(--am-color-brand); font-size: var(--am-type-label); font-weight: var(--am-weight-semibold); line-height: 38rpx; }
.field-label { margin-top: 6rpx; color: var(--am-color-text); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.field-hint { color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.form-stack input, .form-stack textarea { width: 100%;       box-sizing: border-box; }
.form-stack input { height: 88rpx; min-height: 88rpx; }
.form-stack textarea { min-height: 240rpx; }
.primary-block { display: block; width: 100%;           }
.required-note { display: flex; align-items: flex-start; gap: 10rpx; color: var(--am-color-danger); font-size: var(--am-type-micro); line-height: 34rpx; }
.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; margin-top: 11rpx; border-radius: 50%; background: var(--am-color-danger); }

@import "../../styles/editor-form.wxss";
