-items: center; justify-content: center; border: 1rpx solid var(--am-color-border); border-radius: 10rpx; }.filter-options button.active .check { border-color: var(--am-color-border); color: var(--am-color-text); background: var(--am-color-control-surface); }.modal-actions { display: flex; gap: 12rpx; }.modal-actions button { min-height: var(--am-touch-min); padding: 20rpx 24rpx; border-radius: 28rpx; font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-semibold); }.modal-actions .secondary-button { flex: 1; }.modal-actions .primary-button { flex: 1.5;     }

