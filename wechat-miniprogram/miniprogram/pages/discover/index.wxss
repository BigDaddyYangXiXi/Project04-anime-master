.modal-layer { position: fixed; z-index: 99; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-start; padding-top: var(--am-space-none); }.scrim { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: rgba(31,25,31,.42); }.modal-panel { position: relative; z-index: 1; display: flex; width: 100%; max-height: calc(100vh - 160rpx); flex-direction: column; gap: var(--am-space-3); padding: var(--am-space-4); overflow-y: auto; border-radius: 0 0 36rpx 36rpx; background: var(--am-color-surface); box-shadow: 0 24rpx 80rpx rgba(48,35,47,.2); }.modal-title { font-size: 36rpx; line-height: 52rpx; font-weight: var(--am-weight-semibold); }.modal-search { display: flex; width: 100%; height: 72rpx; min-height: 72rpx; max-height: 72rpx; align-items: center; gap: var(--am-space-1); padding: 4rpx 18rpx; border: 1rpx solid var(--am-color-border); border-radius: 24rpx; background: var(--am-color-surface); }.modal-search input { min-width: 0; height: 36rpx; flex: 1; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }.search-placeholder { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); }.recent-head { display: flex; min-height: var(--am-touch-min); align-items: center; justify-content: space-between; }.recent-head > text { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }.recent-head button { min-height: var(--am-touch-min); padding: 0 20rpx; color: var(--am-color-brand); background: var(--am-color-transparent); font-size: var(--am-type-micro); font-weight: var(--am-weight-regular); }.recent-list { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 0 12rpx; }.recent-item { position: relative; display: flex; width: auto; min-width: 0; min-height: var(--am-touch-min); fl