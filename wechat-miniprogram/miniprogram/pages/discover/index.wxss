@import "../provider-home/index.wxss";

.market-page { min-height: 100vh; padding: 24rpx 32rpx 180rpx; color: #5f4a45; background: #fff8f3; }
.hero-panel { padding: 32rpx; border: 1rpx solid #f2cfd3; border-radius: 32rpx; background: radial-gradient(circle at 88% 18%, rgba(255,255,255,.92) 0 10%, transparent 11%), linear-gradient(135deg,#fff4b8 0%,#ffdcd1 43%,#e5f4f4 72%,#dff7f1 100%); box-shadow: 0 20rpx 48rpx rgba(255,111,113,.1); }
.hero-panel text { display: block; }.hero-title { margin: 0 0 8rpx; color: #5f4a45; font-size: 48rpx; line-height: 64rpx; font-weight: 800; }.hero-copy { color: #7d6b65; font-size: 24rpx; line-height: 32rpx; }
.where-when-row { display: flex; gap: 16rpx; margin-top: 24rpx; }.where-when-field { flex: 1; min-width: 0; }.where-when-field:last-child { flex: 1.25; }.where-when-field > view { display: flex; min-height: 96rpx; flex-direction: column; justify-content: center; padding: 8rpx 16rpx; border: 1rpx solid #c9c4c4; border-radius: 16rpx; background: rgba(255,255,255,.92); }.where-when-field text:first-child { color: #7d6b65; font-size: 22rpx; line-height: 32rpx; }.where-when-field text:last-child { overflow: hidden; color: #5f4a45; font-size: 26rpx; line-height: 40rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.location-message { margin-top: 10rpx; color: #7d6b65; font-size: 22rpx; line-height: 32rpx; }
.career-section { overflow: visible; padding: 24rpx 0 16rpx; }.career-row { display: flex; overflow: visible; gap: 16rpx; }.career-chip { display: flex; height: 132rpx; min-width: 0; flex: 1; flex-direction: column; justify-content: space-between; align-items: center; overflow: visible; gap: 4rpx; padding: 0; border: 0; border-radius: 0; color: #6f5968; background: transparent; }.career-icon-shell { position: relative; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; border-radius: 28rpx; }.career-icon-shell image { position: relative; z-index: 1; width: 88rpx; height: 88rpx; border-radius: 26rpx; box-shadow: 0 6rpx 16rpx rgba(208,100,112,.12); }.career-label { display: flex; min-width: 84rpx; height: 36rpx; align-items: center; justify-content: center; gap: 2rpx; padding: 0 14rpx; border-radius: 999rpx; color: #6f5968; background: rgba(255,255,255,.86); box-shadow: inset 0 2rpx 0 rgba(255,255,255,.8), 0 2rpx 0 rgba(166,92,111,.09); }.career-label::before,.career-label::after { width: 6rpx; height: 6rpx; flex: 0 0 6rpx; border-radius: 50%; background: currentColor; content: ""; opacity: .38; }.career-letter { display: inline-block; min-width: 24rpx; color: inherit; font-family: "YouYuan","STYuanti-SC","PingFang SC","Microsoft YaHei",sans-serif; font-size: 26rpx; line-height: 32rpx; font-weight: 800; text-align: center; text-shadow: 0 2rpx 0 rgba(255,255,255,.72); }.career-letter.letter-1 { transform: translateY(-1rpx) rotate(-3deg); }.career-letter.letter-2 { transform: translateY(1rpx) rotate(3deg); }.career-chip.active { color: #b84f69; }.career-chip.active .career-icon-shell::before { position: absolute; z-index: 0; inset: -6rpx; border: 4rpx solid transparent; border-radius: 34rpx; background: linear-gradient(transparent,transparent) padding-box,linear-gradient(135deg,#fbc5c4,#fce4ab 18%,#e0eeb4 34%,#c2e8d6 50%,#c0caf8 68%,#dcc1ed 84%,#fbbfd2) border-box; box-shadow: 0 0 0 4rpx rgba(255,248,239,.98), 0 6rpx 14rpx rgba(214,89,111,.16); content: ""; }.career-chip.active .career-label { color: #fff; background: linear-gradient(90deg,#f38a8e,#e96e82); }.career-chip.active .career-letter { text-shadow: 0 2rpx 0 rgba(164,54,83,.24),0 2rpx 6rpx rgba(164,54,83,.18); }
.retrieval-sticky { position: sticky; z-index: 18; top: 0; margin-bottom: 16rpx; background: rgba(255,249,246,.97); }.career-search { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 72rpx; margin: 0; align-items: center; gap: 8rpx; padding: 4rpx 18rpx; border: 1rpx solid #f2cfd3; border-radius: 24rpx 24rpx 0 0; background: #fff; text-align: left; }.career-search > text:nth-child(2) { min-width: 0; flex: 1; overflow: hidden; color: #7d6b65; font-size: 24rpx; line-height: 36rpx; text-overflow: ellipsis; white-space: nowrap; }
.discovery-toolbar { display: flex; margin-top: -1rpx; }.discovery-toolbar button { position: relative; display: flex; height: 72rpx; min-height: 72rpx; max-height: 72rpx; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; border: 1rpx solid #f2cfd3; border-radius: 0; color: #7d6b65; background: #fff; font-size: 24rpx; line-height: 36rpx; }.discovery-toolbar button:first-child { flex: 1.2; border-radius: 0 0 0 24rpx; }.discovery-toolbar button:last-child { border-radius: 0 0 24rpx 0; }.discovery-toolbar button + button { margin-left: -1rpx; }.discovery-toolbar button.active { color: #5f4a45; background: #fff0f1; font-weight: 700; }.discovery-toolbar button.active::after { position: absolute; bottom: 0; left: 50%; width: 48rpx; height: 4rpx; border-radius: 4rpx; background: #ff6f71; content: ""; transform: translateX(-50%); }
.work-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; align-items: start; }.tone-coral { background: linear-gradient(150deg,#c96760,#ed8c68 50%,#ffd18c); }.tone-grape { background: linear-gradient(150deg,#758aa7,#83aeb8 52%,#e6b9b2); }.tone-rose { background: linear-gradient(150deg,#c7637e,#ed8e9d 55%,#ffd1bf); }.tone-blue { background: linear-gradient(150deg,#d7f1f7,#8ccbd9 52%,#829dbc); }.avatar { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #c4c4c7; font-weight: 700; }.avatar.small { width: 48rpx; height: 48rpx; flex-basis: 48rpx; font-size: 22rpx; }
.provider-list { display: flex; flex-direction: column; gap: 24rpx; }.provider-card { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 572rpx; margin: 0; padding: 32rpx; border: 1rpx solid #e9e5e5; border-radius: 28rpx; background: #fff; text-align: left; box-shadow: 0 16rpx 44rpx rgba(82,53,55,.07); }.provider-head { display: flex; align-items: center; gap: 16rpx; }.provider-head > text { font-size: 28rpx; line-height: 44rpx; font-weight: 600; }.provider-data { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 8rpx; color: #7d6b65; font-size: 24rpx; line-height: 36rpx; }.provider-tag { padding: 2rpx 14rpx; border-radius: 8rpx; color: #4f4b50; background: #efedef; }.provider-price { margin-left: auto; color: #c6536b; font-size: 28rpx; line-height: 40rpx; font-weight: 500; }.mini-works { display: flex; gap: 12rpx; margin-top: 16rpx; }.mini-work { height: 144rpx; flex: 1; border-radius: 16rpx; }.provider-rating { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #efded9; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; text-align: center; }.empty-state text:first-child { font-size: 32rpx; line-height: 48rpx; font-weight: 700; }.empty-state text:last-child { color: #7d6b65; font-size: 26rpx; line-height: 40rpx; }
.modal-layer { position: fixed; z-index: 99; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-start; padding-top: 0; }.scrim { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: rgba(31,25,31,.42); }.modal-panel { position: relative; z-index: 1; display: flex; width: 100%; max-height: calc(100vh - 160rpx); flex-direction: column; gap: 24rpx; padding: 32rpx; overflow-y: auto; border-radius: 0 0 36rpx 36rpx; background: #fff; box-shadow: 0 24rpx 80rpx rgba(48,35,47,.2); }.modal-title { font-size: 36rpx; line-height: 52rpx; font-weight: 800; }.modal-search { display: flex; width: 100%; height: 72rpx; min-height: 72rpx; max-height: 72rpx; align-items: center; gap: 8rpx; padding: 4rpx 18rpx; border: 1rpx solid #f2cfd3; border-radius: 24rpx; background: #fff; }.modal-search input { min-width: 0; height: 36rpx; flex: 1; color: #7d6b65; font-size: 24rpx; line-height: 36rpx; font-weight: 400; }.search-placeholder { color: #7d6b65; font-size: 24rpx; font-weight: 400; }.recent-head { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; }.recent-head > text { color: #7d6b65; font-size: 24rpx; line-height: 36rpx; font-weight: 400; }.recent-head button { min-height: 88rpx; padding: 0 20rpx; color: #c6536b; background: transparent; font-size: 22rpx; font-weight: 400; }.recent-list { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 0 12rpx; }.recent-item { position: relative; display: flex; width: auto; min-width: 0; min-height: 88rpx; flex: 0 0 auto; align-items: stretch; }.recent-item::before { position: absolute; top: 16rpx; right: 0; bottom: 16rpx; left: 0; border: 1rpx solid #eadeda; border-radius: 28rpx; background: #fff8f3; content: ""; }.recent-item button { position: relative; z-index: 1; display: flex; width: auto; min-width: 0; height: 88rpx; min-height: 88rpx; max-height: 88rpx; flex: 0 0 auto; align-items: center; justify-content: center; padding: 0 20rpx; color: #7d6b65; background: transparent; font-size: 22rpx; line-height: 32rpx; font-weight: 400; }.recent-item button:first-child { max-width: 240rpx; overflow: hidden; padding-right: 16rpx; text-overflow: ellipsis; white-space: nowrap; }.recent-item button:last-child { width: 88rpx; padding: 0; color: #9b857b; font-size: 24rpx; font-weight: 400; }.recent-item button:last-child::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 1rpx; background: #eadeda; content: ""; }.filter-group > text { display: block; margin-bottom: 8rpx; color: #655b57; font-size: 24rpx; line-height: 36rpx; font-weight: 700; }.filter-options { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx 0; }.filter-options button { display: flex; width: 49%; min-height: 88rpx; align-items: center; gap: 14rpx; padding: 0 16rpx; border: 1rpx solid #eadeda; border-radius: 16rpx; background: #fff8f3; text-align: left; }.filter-options button.active { border-color: #efb6b8; color: #c6536b; background: #fff0f1; }.check { display: flex; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; align-items: center; justify-content: center; border: 1rpx solid #aaa1ab; border-radius: 10rpx; }.filter-options button.active .check { border-color: #ff7d82; color: #fff; background: #ff7d82; }.modal-actions { display: flex; gap: 12rpx; }.modal-actions button { min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 28rpx; font-size: 24rpx; line-height: 36rpx; font-weight: 700; }.modal-actions .secondary-button { flex: 1; }.modal-actions .primary-button { flex: 1.5; color: #fff; border: 2rpx solid rgba(255,255,255,.92); background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; }

.search-icon { position: relative; width: 40rpx; min-width: 40rpx; max-width: 40rpx; height: 36rpx; min-height: 36rpx; max-height: 36rpx; flex: 0 0 40rpx; font-size: 0; }
.search-icon::before { position: absolute; top: 1rpx; left: 0; width: 30rpx; height: 30rpx; border: 4rpx solid #ff6f71; border-radius: 50%; box-sizing: border-box; content: ""; }
.search-icon::after { position: absolute; top: 26rpx; left: 26rpx; width: 12rpx; height: 4rpx; border-radius: 4rpx; background: #ff6f71; content: ""; transform: rotate(45deg); transform-origin: left center; }
.check-mark { width: 18rpx; height: 10rpx; border-bottom: 4rpx solid #fff; border-left: 4rpx solid #fff; transform: translateY(-2rpx) rotate(-45deg); }
