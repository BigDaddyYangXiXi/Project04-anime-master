<import src="../../templates/provider-workbench.wxml"/>
<app-top-nav bind:layout="onNavigationLayout" class="app-navigation" title="{{role === 'provider' ? '服务方工作台' : '万匠屋'}}" workspace="{{role}}" show-back="{{false}}"/>
<block wx:if="{{role === 'buyer'}}">
<view class="market-page">
  <view class="location-priority">      <picker class="where-when-field" mode="region" value="{{regionValue}}" bindchange="updateCity" aria-label="选择服务城市"><view class="discovery-picker"><image class="browse-context-icon" src="/assets/actions/browse-location.svg"/><text>{{locationLabel || city || '选择城市'}}</text><image class="browse-chevron" src="/assets/actions/browse-chevron.svg"/></view></picker>      <picker class="where-when-field" mode="date" value="{{date}}" bindchange="updateDate" aria-label="选择服务日期"><view class="discovery-picker"><image class="browse-context-icon" src="/assets/actions/browse-date.svg"/><text>{{date || '服务日期'}}</text><image class="browse-chevron" src="/assets/actions/browse-chevron.svg"/></view></picker></view>

  <scroll-view class="career-section" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="career-row" aria-label="职业筛选"><view wx:for="{{careerTabs}}" wx:key="name" class="career-frame {{career === item.name ? 'active' : ''}}"><button hover-class="none" class="career-chip category-{{index}} {{career === item.name ? 'active' : ''}}" data-career="{{item.name}}" bindtap="chooseCareer"><view class="career-copy"><text>{{item.name}}</text><text>{{career === item.name ? '正在浏览' : '发现作品与服务'}} ›</text></view><image class="career-mascot" src="{{item.asset}}" mode="aspectFit"/></button></view></view></scroll-view>
  <view class="career-divider"></view>
  <button hover-class="none" class="career-search browse-control" bindtap="openSearch"><image class="browse-search-icon" src="/assets/actions/browse-search.svg" aria-hidden="true"/><text class="browse-control-label">{{searchQuery || '搜索' + career + '作品、风格或创作者'}}</text></button>
  <view class="results-folder">
  <view class="retrieval-sticky" style="top: {{navigationHeight}}px;">
    <view class="discovery-toolbar"><button hover-class="none" class="{{mode === 'works' ? 'active' : ''}}" data-mode="works" bindtap="chooseMode">作品</button><button hover-class="none" class="{{mode === 'people' ? 'active' : ''}}" data-mode="people" bindtap="chooseMode">创作者</button></view>
    <view class="where-when-row">


      <button hover-class="none" class="filter-trigger browse-control {{styleActive ? 'active' : ''}}" data-kind="style" bindtap="openFilters"><text class="browse-control-label">风格</text><image class="browse-chevron" src="/assets/actions/browse-chevron.svg"/></button><button hover-class="none" class="filter-trigger browse-control {{priceActive ? 'active' : ''}}" data-kind="price" bindtap="openFilters"><text class="browse-control-label">价格</text><image class="browse-chevron" src="/assets/actions/browse-chevron.svg"/></button>
    </view>
    <text wx:if="{{locationMessage}}" class="location-message">{{locationMessage}}</text>
  </view>
  <view class="folder-body">
  <text wx:if="{{catalogCacheError}}">刷新失败，请稍后重试</text>
  <block wx:if="{{catalogLoading}}"></block>
  <view wx:elif="{{catalogError}}" class="empty-state"><text>公开目录暂不可用</text><text>{{catalogError}}</text></view>

  <view wx:elif="{{mode === 'works' && visibleWorks.length}}" class="work-grid"><work-card class="catalog-work" wx:for="{{visibleWorks}}" wx:key="listKey" work="{{item}}" source="B01"/></view>

  <view wx:elif="{{mode === 'people' && visibleProviders.length}}" class="provider-list"><button hover-class="none" wx:for="{{visibleProviders}}" wx:key="id" class="provider-card" data-id="{{item.id}}" bindtap="showProvider"><view class="provider-head"><image wx:if="{{item.avatar}}" class="avatar" src="{{item.avatar}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initial}}</view><view class="creator-identity"><text>{{item.name}}</text><text>{{item.career}} · {{item.city}}</text></view><text class="am-money am-money-list provider-price">{{item.priceText}}</text></view><view class="provider-data"><text>{{item.ratingText}} · {{item.orders}} 次合作</text><text wx:for="{{item.topTags}}" wx:for-item="tag" wx:key="*this" class="provider-tag">{{tag}}</text></view><view class="mini-works"><view wx:for="{{item.miniWorks}}" wx:for-item="work" wx:key="id" class="mini-work tone-{{work.tone}}"><image wx:if="{{work.coverImage}}" src="{{work.coverImage}}" mode="aspectFill" lazy-load="{{true}}"/></view></view></button></view>

  <view wx:else class="brand-message"><image src="/assets/brand/expression-curious.png" mode="aspectFit"/><view><text>没有匹配的作品</text><text>试试调整职业、关键词或筛选条件。</text><button hover-class="none" class="am-action am-action-secondary" bindtap="openSearch">调整搜索</button></view></view>
  <include src="../../templates/discovery-pagination.wxml"/>
  <view wx:if="{{!catalogLoading && !catalogError && visibleWorks.length && mode === 'works'}}" class="brand-message"><image src="/assets/brand/expression-hello.png" mode="aspectFit"/><view><text>好手艺，遇见好主意。</text><text>从作品开始，找到合拍的老师。</text></view></view>
  </view>
  </view>
</view>

<view wx:if="{{searchOpen}}" class="modal-layer" style="top: {{navigationHeight}}px;"><view class="scrim" bindtap="closeSearch"></view><view class="modal-panel" catchtap="noop"><text class="modal-title">搜索{{career}}</text><view class="modal-search"><image class="browse-search-icon" src="/assets/actions/browse-search.svg" aria-hidden="true"/><input value="{{searchDraft}}" placeholder="作品、风格或服务者" placeholder-class="search-placeholder" bindinput="updateSearchDraft" confirm-type="search" bindconfirm="submitSearch" /></view><view class="recent-head"><text>最近搜索</text><button aria-disabled="{{!recent.length}}" hover-class="none" data-am-disabled="{{!recent.length}}" bindtap="{{(!recent.length) ? '' : 'clearRecent'}}">全部清空</button></view><view class="recent-list"><view wx:for="{{recent}}" wx:key="*this" class="recent-item"><button hover-class="none" data-value="{{item}}" bindtap="submitSearch">{{item}}</button><button hover-class="none" aria-label="删除最近搜索 {{item}}" data-value="{{item}}" bindtap="removeRecent">×</button></view></view><view class="modal-actions"><button hover-class="none" class="secondary-button am-action am-action-secondary" bindtap="closeSearch">取消</button><button hover-class="none" class="primary-button am-action am-action-primary" bindtap="submitSearch">查看结果</button></view></view></view>

<view wx:if="{{filterOpen}}" class="modal-layer" style="top: {{navigationHeight}}px;"><view class="scrim" bindtap="closeFilters"></view><view class="modal-panel" catchtap="noop"><text class="modal-title">{{career}} · {{filterKind === 'price' ? '价格' : '风格'}}</text><view wx:for="{{availableFilterGroups}}" wx:key="group" class="filter-group"><text>{{item.group}}</text><view class="filter-options"><button hover-class="none" wx:for="{{item.values}}" wx:for-item="option" wx:key="value" class="{{option.selected ? 'active' : ''}}" data-value="{{option.value}}" bindtap="toggleFilter"><view class="check" aria-hidden="true"><view wx:if="{{option.selected}}" class="check-mark"></view></view>{{option.value}}</button></view></view><view class="modal-actions"><button hover-class="none" class="secondary-button am-action am-action-secondary" bindtap="resetFilters">重置{{filterKind === 'price' ? '价格' : '风格'}}</button><button hover-class="none" class="primary-button am-action am-action-primary" bindtap="applyFilters">应用筛选</button></view></view></view>
</block>

<view wx:else class="dashboard-shell"><template is="provider-workbench" data="{{profile, profileInitial, providerCareer, providerVisibilityText, storefrontPublished, dashboardLoading, dashboardError, dashboardCached, priorityOrders, remainingPriority, metrics}}"/></view>

<first-use-consent bindcomplete="completeFirstUse"/>
