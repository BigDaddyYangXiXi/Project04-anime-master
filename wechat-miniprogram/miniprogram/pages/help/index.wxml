<app-top-nav workspace="{{navWorkspace}}" title="{{title}}" show-back="{{true}}"/>
<view class="mi-page mi-stack">
  <block wx:if="{{contact}}"><view class="mi-card mi-pad"><text class="mi-title">联系开发者</text><text class="mi-copy">{{phone}}</text><text class="mi-muted">请说明账号昵称、遇到的问题及关联订单编号。不要提供密码、验证码或完整银行卡信息。</text><button hover-class="none" class="am-action am-action-primary" bindtap="call">拨打电话</button><button hover-class="none" class="am-action am-action-secondary" bindtap="copy">复制号码</button></view><view class="mi-card mi-pad"><text class="mi-title">账号与个人信息</text><text class="mi-copy">手机号更正、个人信息查询、更正、删除及注销可通过此渠道联系核验。申请不等于处理完成，处理结果以核验后通知为准。</text></view></block>
  <block wx:elif="{{article}}"><text class="mi-title">{{article.title}}</text><text class="mi-copy">{{article.intro}}</text><view wx:for="{{article.steps}}" wx:key="index" class="mi-card mi-pad"><text class="mi-title">{{index + 1}}. {{item[0]}}</text><text class="mi-copy">{{item[1]}}</text></view><view class="mi-card mi-pad"><text class="mi-title">{{article.extra[0]}}</text><text class="mi-copy">{{article.extra[1]}}</text></view><button hover-class="none" class="am-action am-action-primary" bindtap="openRelated">查看相关功能</button><button hover-class="none" class="am-action am-action-secondary" bindtap="feedback">仍有问题，提交反馈</button></block>
  <block wx:else><text class="mi-muted">按当前身份优先展示常见问题。付款、退款与交付请先核对原订单。</text><view class="mi-card"><button hover-class="none" wx:for="{{articles}}" wx:key="key" class="mi-row" data-key="{{item.key}}" bindtap="openArticle"><text class="mi-row-copy">{{item.title}}</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view><view class="mi-card"><button hover-class="none" class="mi-row" bindtap="feedback"><text class="mi-row-copy">问题反馈</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" bindtap="history"><text class="mi-row-copy">我的反馈</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button><button hover-class="none" class="mi-row" bindtap="contact"><text class="mi-row-copy">联系与账号申诉</text><image class="mi-chevron" src="/assets/me/chevron.svg"/></button></view></block>
</view>
