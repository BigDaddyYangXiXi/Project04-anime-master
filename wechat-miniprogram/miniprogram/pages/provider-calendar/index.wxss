@import "../../styles/availability-calendar.wxss";
.calendar-shell { padding:var(--am-space-4) var(--am-space-4) calc(var(--am-status-action-height) + var(--am-space-6) + env(safe-area-inset-bottom)); }
.accepting-row { display:flex; align-items:center; gap:var(--am-space-3); padding-bottom:var(--am-space-6); border-bottom:var(--am-border-control); }
.accepting-row > view { flex:1; min-width:0; }
.accepting-row text { display:block; font-size:var(--am-type-body); line-height:var(--am-line-body); }
.accepting-row text + text, .calendar-help { display:block; margin-top:var(--am-space-2); font-size:var(--am-type-caption); line-height:var(--am-line-caption); color:var(--am-color-text-secondary); }
.month-heading { display:flex; align-items:center; justify-content:space-between; margin-top:var(--am-space-4); }
.month-heading > text { font-size:var(--am-type-section-title); line-height:var(--am-line-section-title); font-weight:var(--am-weight-semibold); }
.month-heading button { width:auto; }
.calendar-card { margin-top:var(--am-space-4); }
.calendar-error { color:var(--am-color-danger); font-size:var(--am-type-caption); line-height:var(--am-line-caption); }
.calendar-footer { position:fixed; bottom:0; left:0; right:0; display:flex; gap:var(--am-space-2); padding:var(--am-space-3) var(--am-space-4) calc(var(--am-space-3) + env(safe-area-inset-bottom)); background:var(--am-color-canvas); border-top:var(--am-border-control); }
.calendar-footer button { flex:1; min-width:0; }

@import "../../styles/storefront-editor.wxss";
