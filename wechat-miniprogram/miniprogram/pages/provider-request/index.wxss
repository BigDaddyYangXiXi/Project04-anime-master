@import "../../styles/order-facts.wxss";
.request-shell { padding: var(--am-detail-nav-page-padding); }
.page-intro { padding: var(--am-space-none) var(--am-space-none) var(--am-space-6); }
.page-intro text { display: block; }
.status-dot { display: inline-flex !important; width: fit-content; align-items: center; gap: 10rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: var(--am-color-warning-surface); color: var(--am-color-warning); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); }
.status-dot::before { width: 12rpx; height: 12rpx; border-radius: 50%; background: currentColor; content: ""; }
.status-dot.ready { color: var(--am-color-success); background: var(--am-color-success-surface); }
.page-title { margin-top: 14rpx; font-size: var(--am-status-title-size); font-weight: var(--am-weight-semibold); line-height: var(--am-status-title-line); }
.page-copy { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.6; }
.content-card, .progress-card, .demand-card { width: 100%; margin-bottom: var(--am-detail-section-gap); padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }
.evaluation-intro, .contact-intro { padding-bottom: var(--am-space-3); }
.request-summary { padding: var(--am-detail-card-padding); }
.summary-meta, .decision-heading, .contact-heading, .quote-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.summary-meta text:first-child { color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.summary-meta text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 30rpx; }
.summary-title { display: block; margin-top: 12rpx; color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.summary-facts { display: flex; flex-wrap: wrap; gap: var(--am-space-1) var(--am-space-2); margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 38rpx; }
.summary-facts text + text::before { margin-right: 16rpx; color: var(--am-color-text-secondary); content: "·"; }
.summary-identity { display: flex; align-items: baseline; gap: 14rpx; margin-top: 10rpx; }
.summary-identity text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.summary-identity text:last-child { color: var(--am-color-text); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); }
.summary-schedule { display: grid; grid-template-columns: 76rpx minmax(0,1fr); gap: var(--am-space-2); margin-top: var(--am-space-3); padding: var(--am-space-3); border-radius: var(--am-radius-control); background: var(--am-color-control-surface); }
.summary-schedule > text { color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: var(--am-line-caption); }
.summary-schedule view text { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.demand-focus { margin-top: var(--am-space-4); padding: var(--am-detail-card-padding); border-radius: var(--am-radius-control); background: var(--am-color-surface); }
.demand-focus text { display: block; }
.demand-focus text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 32rpx; }
.demand-focus text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text); font-size: 25rpx; line-height: 42rpx; }
.reference-strip { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: var(--am-space-3); padding-top: var(--am-space-3); border-top: 1rpx solid var(--am-color-border); }
.reference-strip > view { min-width: 0; flex: 1; }
.reference-strip text { display: block; }
.reference-strip text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 30rpx; }
.reference-strip text:last-child { margin-top: 4rpx; overflow: hidden; color: var(--am-color-text); font-size: var(--am-type-caption); line-height: var(--am-line-caption); text-overflow: ellipsis; white-space: nowrap; }
.reference-strip image { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 16rpx; }
.decision-heading > view text, .contact-heading > view text { display: block; }
.decision-heading > view text:first-child, .contact-heading > view text:first-child { color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-body); }
.decision-heading > view text:last-child, .contact-heading > view text:last-child { margin-top: 2rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.decision-heading > text, .contact-heading > text { flex: 0 0 auto; padding: 5rpx 12rpx; border-radius: 999rpx; color: var(--am-color-brand); background: var(--am-color-control-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 28rpx; }
.reason-field textarea { height: 152rpx; }
.decision-card .request-actions { margin-bottom: var(--am-space-none); }
.contact-card { padding-bottom: 28rpx; }
.contact-heading > text { color: var(--am-color-success); background: var(--am-color-success-surface); }
.contact-method { display: grid; min-height: 112rpx; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--am-space-2); margin-top: var(--am-space-3); padding: 20rpx 0 0; border-top: 1rpx solid var(--am-color-border); }
.contact-method > view:first-child { min-width: 0; }
.contact-method > view:first-child text { display: block; }
.contact-method > view:first-child text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 30rpx; }
.contact-method > view:first-child text:last-child { margin-top: 2rpx; overflow: hidden; color: var(--am-color-text); font-size: 30rpx; font-weight: var(--am-weight-semibold); line-height: var(--am-line-body); text-overflow: ellipsis; white-space: nowrap; }
.contact-tools { display: flex; gap: var(--am-space-1); }
.contact-note { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 18rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 34rpx; }
.note-dot { width: 10rpx; height: 10rpx; flex: 0 0 10rpx; margin-top: 12rpx; border-radius: 50%; background: var(--am-color-success); }
.completion-card { padding: 36rpx 32rpx 32rpx; }
.completion-meta { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.completion-meta text:first-child { color: var(--am-color-brand); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.completion-meta text:last-child { color: var(--am-color-warning); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 30rpx; }
.completion-meta text:last-child.ready { color: var(--am-color-success); }
.completion-title { display: block; margin-top: 14rpx; color: var(--am-color-text); font-size: 36rpx; font-weight: var(--am-weight-semibold); line-height: 50rpx; letter-spacing: -1rpx; }
.completion-lead { display: block; margin-top: 6rpx; color: var(--am-color-text-secondary); font-size: 25rpx; line-height: 42rpx; }
.quote-panel { padding: 20rpx; border-radius: 18rpx; background: var(--am-color-control-surface); }
.quote-heading text:first-child { color: var(--am-color-text); font-size: 25rpx; font-weight: var(--am-weight-semibold); line-height: 38rpx; }
.quote-heading text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 32rpx; }
.quote-panel input { margin-top: 12rpx;  }
.demand-card text { display: block; }
.demand-card text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); letter-spacing: 2rpx; }
.demand-card text:nth-child(2) { margin-top: 12rpx; font-size: 34rpx; font-weight: var(--am-weight-semibold); }
.demand-card text:last-child { margin-top: 12rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.7; }
.section-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: var(--am-space-3); }
.section-title > text:first-child, .section-title > view text:first-child { color: var(--am-color-text); font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: 48rpx; }
.section-title > text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.section-title > view { min-width: 0; flex: 1; }
.section-title > view text { display: block; }
.section-title > view text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.body-copy { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-body); line-height: var(--am-line-body); }
.reference-image { display: block; width: 100%; height: 300rpx; margin-top: 18rpx; border-radius: 24rpx; }
.request-actions { display: flex; flex-direction: column; gap: var(--am-space-2); margin-bottom: var(--am-space-3); }
.primary-block, .secondary-block, .danger-block, .upload-button { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; align-items: center; justify-content: center; padding: 22rpx 24rpx; border-radius: 24rpx; font-size: var(--am-type-body); font-weight: var(--am-weight-medium); line-height: var(--am-line-label); text-align: center; }
.communication-failed { margin-top: -10rpx; }
.required-summary { display: flex; padding: 18rpx 20rpx; flex-direction: column; gap: 6rpx; border: 1rpx solid var(--am-color-border); border-radius: 18rpx; color: var(--am-color-danger); background: var(--am-color-danger-surface); font-size: var(--am-type-micro); line-height: 34rpx; }.required-heading { display: flex; align-items: center; gap: 10rpx; color: var(--am-color-danger); font-weight: var(--am-weight-semibold); }.required-dot { width: 12rpx; height: 12rpx; flex: 0 0 12rpx; border-radius: 50%; background: var(--am-color-danger); box-shadow: var(--am-shadow-none); }
.form-stack { display: flex; flex-direction: column; gap: 26rpx; }
.form-stack label { display: flex; flex-direction: column; gap: 12rpx; color: var(--am-color-text); font-size: var(--am-type-caption); font-weight: var(--am-weight-medium); line-height: var(--am-line-caption); }
.form-stack input, .form-stack textarea { width: 100%; min-height: 88rpx;        }
.form-stack textarea { height: 180rpx;  }
.form-stack input[disabled] { color: var(--am-color-text-secondary); background: var(--am-color-control-surface); }
.field-help { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); line-height: var(--am-line-caption); }
.contact-action { display: flex; width: 88rpx; min-width: 88rpx; max-width: 88rpx; min-height: 88rpx; align-items: center; justify-content: center; padding: var(--am-space-none) var(--am-space-1); border: 1rpx solid var(--am-color-border); border-radius: 16rpx; background: var(--am-color-control-surface); color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-medium); line-height: var(--am-line-caption); }
.contact-action-pressed { background: var(--am-color-control-surface); transform: translateY(1rpx); }
.contact-action[data-am-disabled="true"] { color: var(--am-color-brand); background: var(--am-color-control-surface); opacity: .62; }
.quote-action { font-size: var(--am-type-body); font-weight: var(--am-weight-medium); line-height: var(--am-line-label); }
page button.quote-action[data-am-disabled="true"] { opacity: .62; }
.completion-list { overflow: hidden; margin-top: 30rpx; border: 1rpx solid var(--am-color-border); border-radius: 28rpx; background: var(--am-color-surface); }
.confirm-line { display: flex; width: 100%; min-width: 100%; max-width: 100%; min-height: 124rpx; align-items: center; gap: 18rpx; padding: 22rpx; border: 0; border-radius: 0; background: var(--am-color-surface); text-align: left; }
.confirm-line.active { background: var(--am-color-surface); }
.completion-list > .confirm-line + .confirm-line,
.completion-list > .nda-choice,
.completion-list > .amount-choice { border-top: 1rpx solid var(--am-color-border); }
.confirmation-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; justify-content: center; text-align: left; }
.confirmation-index { display: flex; width: 34rpx; flex: 0 0 34rpx; align-self: flex-start; justify-content: center; padding-top: 4rpx; color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); }
.confirmation-state { display: flex; min-width: 104rpx; min-height: 48rpx; flex: 0 0 auto; align-items: center; justify-content: center; gap: var(--am-space-1); padding: 8rpx 12rpx; border: 1rpx solid var(--am-color-border); border-radius: 999rpx; color: var(--am-color-text-secondary); background: var(--am-color-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 28rpx; }
.confirmation-state.done { border-color: var(--am-color-brand); color: var(--am-color-text-secondary); background: var(--am-color-selected-surface); }
.confirm-mark { width: 14rpx; height: 8rpx; border-bottom: 3rpx solid var(--am-color-border); border-left: 3rpx solid var(--am-color-border); transform: translateY(-2rpx) rotate(-45deg); }
.confirm-line .confirmation-copy text { display: block; }
.confirm-line .confirmation-copy text:first-child { color: var(--am-color-text); font-size: 29rpx; font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.confirm-line .confirmation-copy text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); line-height: 38rpx; }
.schedule-confirm-line { min-height: 144rpx; align-items: flex-start; }
.schedule-confirm-line .confirmation-index, .schedule-confirm-line .confirmation-state { margin-top: 10rpx; }
.schedule-confirm-line .confirmation-copy .schedule-line { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-regular); line-height: 34rpx; }
.form-control-pressed { background: var(--am-color-control-surface); }
.nda-choice { padding: 22rpx; border: 0; border-radius: 0; background: var(--am-color-surface); }
.confirmation-label { display: flex; align-items: center; gap: 18rpx; margin-bottom: 18rpx; }
.confirmation-label .confirmation-copy text { display: block; }
.confirmation-label .confirmation-copy text:first-child { color: var(--am-color-text); font-size: 29rpx; font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.confirmation-label .confirmation-copy text:last-child { margin-top: 4rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 38rpx; }
.amount-choice { background: var(--am-color-surface); }
.amount-confirm { min-height: 112rpx; }
.amount-editor { padding: 0 22rpx 24rpx; }
.amount-editor .quote-action { margin-top: var(--am-space-2); }
.quote-current-note { display: block; margin-top: 14rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.quote-locked { display: block; margin-top: 14rpx; color: var(--am-color-success); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 34rpx; }
.nda-choice > .nda-segments { display: flex; gap: var(--am-space-none); overflow: hidden; border: 1rpx solid var(--am-color-border); border-radius: 16rpx; background: var(--am-color-surface); }
.nda-choice .nda-segments button { position: relative; display: flex; min-width: 0; min-height: 88rpx; flex: 1; align-items: center; justify-content: center; padding: 0 12rpx; border: 0; border-radius: 0; background: var(--am-color-surface); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); font-weight: var(--am-weight-medium); line-height: var(--am-line-caption); text-align: center; }
.nda-choice .nda-segments button + button { border-left: 1rpx solid var(--am-color-border); }
.nda-choice .nda-segments button.active { background: var(--am-color-selected-surface); color: var(--am-color-brand); }
.nda-choice .nda-segments button.active::after { position: absolute; right: 50%; bottom: 0; width: 48rpx; height: 4rpx; border: 0; border-radius: 999rpx; background: var(--am-color-selected-surface); transform: translateX(50%); content: ""; }
.nda-card > text, .result-card > text { display: block; }
.nda-card > text:first-child, .result-card > text:first-child { font-size: 30rpx; font-weight: var(--am-weight-semibold); }
.nda-card > text:nth-child(2), .result-card > text:nth-child(2) { margin: var(--am-space-2) var(--am-space-none) var(--am-space-3); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.7; }
.upload-button { border: 1rpx dashed var(--am-color-border); background: var(--am-color-surface); color: var(--am-color-brand); }
.file-list { padding: 20rpx; border-radius: 22rpx; background: var(--am-color-control-surface); }
.file-list text { display: block; padding: var(--am-space-1) var(--am-space-none); color: var(--am-color-brand); font-size: var(--am-type-micro); }
.review-line { padding: 20rpx; border-radius: 22rpx; background: var(--am-color-warning-surface); color: var(--am-color-warning); font-size: var(--am-type-micro); line-height: 1.6; }
.empty-state { padding: 120rpx 32rpx; text-align: center; font-size: 30rpx; font-weight: var(--am-weight-semibold); }
.empty-retry { display: flex; width: auto;  margin: 24rpx auto 0;  align-items: center; justify-content: center;       }

@import "../../styles/editor-form.wxss";
