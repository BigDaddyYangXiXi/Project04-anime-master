<app-top-nav title="{{title}}" workspace="{{navWorkspace}}" show-back="{{true}}"/>
<view class="assets-shell">
  <block wx:if="{{loading}}"></block>
  <view wx:elif="{{loadError}}" class="empty-state"><text>{{loadError}}</text><button hover-class="none" class="am-action am-action-secondary" bindtap="retryLoad">重新读取</button></view>
  <view wx:elif="{{items.length}}" class="asset-rows"><button hover-class="none" wx:for="{{items}}" wx:key="key" data-id="{{item.id}}" data-kind="{{item.kind}}" data-provider-id="{{item.providerId}}" bindtap="openItem"><view><text>{{item.title}}</text><text>{{item.subtitle}}</text></view><text>{{item.meta}}</text><view class="chevron"></view></button></view>
  <view wx:else class="empty-state"><view class="empty-mark" aria-hidden="true"><view class="empty-ring"></view></view><text>{{empty}}</text><text>浏览公开作品和服务者后，可在这里集中查看。</text></view>
</view>
