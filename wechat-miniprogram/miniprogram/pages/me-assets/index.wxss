.assets-shell { padding: var(--am-detail-page-padding)}.asset-rows {overflow: hidden; border: var(--am-work-rule); border-radius: var(--am-radius-control);background: var(--am-color-surface)}.asset-rows button{display: flex;width: 100%;min-height: 112rpx;align-items: center;gap: 18rpx;padding: 20rpx 24rpx;border-bottom: 1rpx solid var(--am-color-border);background: var(--am-color-surface);text-align: left}.asset-rows button:last-child{border-bottom: 0}.asset-rows button>view:first-child{min-width: 0;flex: 1}.asset-rows text{display: block}.asset-rows button>view text:first-child{font-size: var(--am-type-label);font-weight: var(--am-weight-semibold)}.asset-rows button>view text:last-child{margin-top: 5rpx;color: var(--am-color-text-secondary);font-size: var(--am-type-caption)}.asset-rows button>text{color: var(--am-color-text-secondary);font-size: var(--am-type-caption)}.chevron{width: 14rpx;height: 14rpx;border-top: 3rpx solid var(--am-color-border);border-right: 3rpx solid var(--am-color-border);transform: rotate(45deg)}.empty-state{padding: 180rpx 40rpx;text-align: center}.empty-mark{display: flex;width: 88rpx;height: 88rpx;margin: 0 auto 24rpx;align-items: center;justify-content: center;border-radius: 30rpx;background: var(--am-color-control-surface)}.empty-ring{width: 34rpx;height: 34rpx;border: 5rpx solid var(--am-color-border);border-radius: 50%}.empty-state text{display: block;font-size: var(--am-type-body);font-weight: var(--am-weight-semibold)}.empty-state text:last-child{margin-top: 12rpx;color: var(--am-color-text-secondary);font-size: var(--am-type-caption);font-weight: var(--am-weight-regular);line-height: 34rpx}
