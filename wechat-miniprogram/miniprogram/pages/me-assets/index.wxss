.assets-shell{padding:28rpx}.asset-rows{overflow:hidden;border:1rpx solid #eee3df;border-radius:34rpx;background:#fff}.asset-rows button{display:flex;width:100%;min-height:112rpx;align-items:center;gap:18rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #eee3df;background:#fff;text-align:left}.asset-rows button:last-child{border-bottom:0}.asset-rows button>view:first-child{min-width:0;flex:1}.asset-rows text{display:block}.asset-rows button>view text:first-child{font-size:26rpx;font-weight:800}.asset-rows button>view text:last-child{margin-top:5rpx;color:#766964;font-size:20rpx}.asset-rows button>text{color:#a25864;font-size:19rpx}.chevron{width:14rpx;height:14rpx;border-top:3rpx solid #b8aaa5;border-right:3rpx solid #b8aaa5;transform:rotate(45deg)}.empty-state{padding:180rpx 40rpx;text-align:center}.empty-mark{display:flex;width:88rpx;height:88rpx;margin:0 auto 24rpx;align-items:center;justify-content:center;border-radius:30rpx;background:#fff0ed}.empty-ring{width:34rpx;height:34rpx;border:5rpx solid #e87579;border-radius:50%}.empty-state text{display:block;font-size:28rpx;font-weight:800}.empty-state text:last-child{margin-top:12rpx;color:#776a65;font-size:21rpx;font-weight:400;line-height:34rpx}
