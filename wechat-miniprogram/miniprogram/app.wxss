@import "styles/design-tokens.wxss";
@import "styles/actions.wxss";
@import "styles/fields.wxss";
page { background: var(--am-color-canvas); color: var(--am-color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: var(--am-type-caption);
}

view, button, input, textarea, picker {
  box-sizing: border-box;
}

button {
  color: var(--am-color-text);
  font-weight: var(--am-weight-regular);
  min-height: 0;
  margin: var(--am-space-none);
  padding: var(--am-space-none);
  line-height: 1.4;
  border-radius: 0;
}

button::after { border: 0;
}

.page-shell {
  padding: 24rpx 32rpx 192rpx;
}

.empty-page {
  padding: 120rpx 52rpx;
  text-align: center;
}

.empty-page-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 38rpx;
  font-weight: var(--am-weight-semibold);
}

.empty-page-copy { color: var(--am-color-text-secondary);
  font-size: var(--am-type-label);
  line-height: 1.7;
}

/* 20 Full Prototype v0.6.3 visual scale: 1 CSS px = 2rpx at the 375px design viewport. */
page .status-shell,
page .orders-shell,
page .request-shell,
page .dashboard-shell {
  padding-right: var(--am-space-4);
  padding-left: var(--am-space-4);
}

page .quick-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

page .quick-actions button {
  flex: 1;
  min-width: 0;
  padding: 22rpx 8rpx; border: 1rpx solid var(--am-color-border);
  border-radius: 28rpx; background: var(--am-color-surface);
}

page .quick-actions text {
  display: block;
  font-size: var(--am-type-caption);
  font-weight: var(--am-weight-semibold);
}

page .quick-actions text:last-child {
  margin-top: 5rpx; color: var(--am-color-text-secondary);
  font-size: 16rpx;
  font-weight: var(--am-weight-regular);
}

page .task-link {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx; color: var(--am-color-text); background: var(--am-color-control-surface);
  font-size: var(--am-type-micro);
}

.v-page { padding: 28rpx 28rpx 180rpx; }
.v-intro { margin-bottom: 22rpx; padding: 34rpx; border-radius: 34rpx; color: var(--am-color-text); background: linear-gradient(135deg,#9b4c42,#e96e82 58%,#dc6e8c); }
.v-intro text { display: block; }.v-intro .kicker { color: var(--am-color-text-secondary); font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); }.v-intro .title { margin-top: 10rpx; font-size: 40rpx; font-weight: var(--am-weight-semibold); }.v-intro .copy { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 1.6; }
.v-card { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid var(--am-color-border); border-radius: var(--am-radius-card); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); }.v-card-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }.v-card-title text:first-child { font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); }.v-card-title text:last-child { color: var(--am-color-brand); font-size: var(--am-type-caption); }
.v-row { display: flex; justify-content: space-between; padding: var(--am-space-2) var(--am-space-none); border-bottom: 1rpx solid var(--am-color-border); }.v-row text:first-child { color: var(--am-color-text-secondary); }.v-row text:last-child { max-width: 64%; text-align: right; font-weight: var(--am-weight-semibold); }.v-button { width: 100%; margin-top: 20rpx; padding: 22rpx; border-radius: 22rpx; color: var(--am-color-text); background: var(--am-color-control-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); }.v-button.secondary { color: var(--am-color-brand); border: 1rpx solid var(--am-color-border); background: var(--am-color-surface); }.v-input { width: 100%; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; background: var(--am-color-surface); }.v-textarea { width: 100%; min-height: 180rpx; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; background: var(--am-color-surface); }.v-tabs { display: flex; gap: 10rpx; margin: 18rpx 0; }.v-tabs button { flex: 1; padding: 16rpx 4rpx; border-radius: 18rpx; background: var(--am-color-surface); font-size: var(--am-type-caption); }.v-tabs button.active { color: var(--am-color-brand); background: var(--am-color-control-surface); font-weight: var(--am-weight-semibold); }.v-empty { padding: 100rpx 30rpx; color: var(--am-color-text-secondary); text-align: center; }.v-empty text { display: block; margin-top: 10rpx; }

/* v0.6.3 shared bottom navigation clearance, including the device safe area. */
page .market-page,
page .orders-shell,
page .v-page {
  padding-bottom: calc(192rpx + constant(safe-area-inset-bottom)) !important;
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom)) !important;
}

@import "styles/identity.wxss";
