page {
  background: #f6f3f0;
  color: #2b2523;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
}

view, button, input, textarea, picker {
  box-sizing: border-box;
}

button {
  min-height: 0;
  margin: 0;
  padding: 0;
  line-height: 1.4;
  border-radius: 0;
}

button::after {
  border: 0;
}

/* Product-wide primary actions center their text box explicitly instead of relying on native button flow. */
page button.primary-block,
page button.primary-button,
page .sticky-action button,
page .action-state button {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Product-wide secondary action: cream surface, orange foreground, rainbow rim. */
page button.secondary-block,
page button.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 4rpx solid transparent;
  color: #b64f1f;
  background: linear-gradient(135deg, #fff9ed, #fff0d8) padding-box,
    linear-gradient(135deg, #fbc5c4 0%, #fce4ab 18%, #e0eeb4 34%, #c2e8d6 50%, #c0caf8 68%, #dcc1ed 84%, #fbbfd2 100%) border-box;
  box-shadow: 0 0 0 3rpx rgba(255, 248, 239, 0.98), 0 5rpx 12rpx rgba(218, 111, 53, 0.12);
}

/* Destructive actions keep their semantic surface while sharing the same text-alignment contract. */
page button.danger-block {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: none;
}

page button.secondary-block:active,
page button.secondary-button:active {
  background: linear-gradient(135deg, #fff2d5, #ffe4c0) padding-box,
    linear-gradient(135deg, #fbc5c4 0%, #fce4ab 18%, #e0eeb4 34%, #c2e8d6 50%, #c0caf8 68%, #dcc1ed 84%, #fbbfd2 100%) border-box;
  transform: translateY(1rpx);
}

page button.secondary-block[disabled],
page button.secondary-button[disabled] {
  color: #9b857b;
  box-shadow: none;
  opacity: 0.42;
}

.page-shell {
  padding: 24rpx 32rpx 192rpx;
}

.empty-page {
  padding: 120rpx 52rpx;
  text-align: center;
}

.empty-page-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.empty-page-copy {
  color: #6f625d;
  font-size: 26rpx;
  line-height: 1.7;
}

/* 20 Full Prototype v0.6.3 visual scale: 1 CSS px = 2rpx at the 375px design viewport. */
page .status-shell,
page .orders-shell,
page .request-shell,
page .dashboard-shell {
  padding-right: 32rpx;
  padding-left: 32rpx;
}

page .intro-card,
page .status-hero,
page .request-hero,
page .dashboard-head {
  border-radius: 40rpx;
}

page .content-card,
page .progress-card,
page .order-card,
page .identity-card,
page .request-card,
page .stats-row {
  padding: 30rpx 32rpx;
  border: 1rpx solid #eee3df;
  border-radius: 38rpx;
  box-shadow: 0 14rpx 44rpx rgba(49, 36, 56, 0.05);
}

page .orders-head text:first-child {
  font-size: 46rpx;
}

page .order-title,
page .request-card .request-title {
  font-size: 30rpx;
}

page .request-hero .request-title {
  font-size: 40rpx;
}

page .picker-value,
page .form-row input,
page .form-row textarea {
  border-radius: 22rpx;
}

page .submit-button,
page .enter-button,
page .status-shell > button,
page .action-row button {
  min-height: 88rpx;
  border-radius: 24rpx;
}

page .quick-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

page .quick-actions button {
  flex: 1;
  min-width: 0;
  padding: 22rpx 8rpx;
  border: 1rpx solid #eee3df;
  border-radius: 28rpx;
  background: #ffffff;
}

page .quick-actions text {
  display: block;
  font-size: 21rpx;
  font-weight: 800;
}

page .quick-actions text:last-child {
  margin-top: 5rpx;
  color: #6f625d;
  font-size: 16rpx;
  font-weight: 400;
}

page .task-link {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: #c6536b;
  font-size: 22rpx;
}

.v-page { padding: 28rpx 28rpx 180rpx; }
.v-intro { margin-bottom: 22rpx; padding: 34rpx; border-radius: 34rpx; color: #fff; background: linear-gradient(135deg,#9b4c42,#e96e82 58%,#dc6e8c); }
.v-intro text { display: block; }.v-intro .kicker { color: #ffe1d9; font-size: 20rpx; font-weight: 700; }.v-intro .title { margin-top: 10rpx; font-size: 40rpx; font-weight: 800; }.v-intro .copy { margin-top: 8rpx; color: rgba(255,255,255,.8); font-size: 22rpx; line-height: 1.6; }
.v-card { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #eee3df; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(48,36,54,.05); }.v-card-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }.v-card-title text:first-child { font-size: 28rpx; font-weight: 800; }.v-card-title text:last-child { color: #c6536b; font-size: 20rpx; }
.v-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #eee8ed; }.v-row text:first-child { color: #746963; }.v-row text:last-child { max-width: 64%; text-align: right; font-weight: 700; }.v-button { width: 100%; margin-top: 20rpx; padding: 22rpx; border-radius: 22rpx; color: #fff; background: #c6536b; font-size: 24rpx; font-weight: 800; }.v-button.secondary { color: #c6536b; border: 1rpx solid #efb6b8; background: #fff; }.v-input { width: 100%; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid #e4d8d4; border-radius: 20rpx; background: #fff; }.v-textarea { width: 100%; min-height: 180rpx; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid #e4d8d4; border-radius: 20rpx; background: #fff; }.v-tabs { display: flex; gap: 10rpx; margin: 18rpx 0; }.v-tabs button { flex: 1; padding: 16rpx 4rpx; border-radius: 18rpx; background: #fff; font-size: 20rpx; }.v-tabs button.active { color: #c6536b; background: #fff0f1; font-weight: 700; }.v-empty { padding: 100rpx 30rpx; color: #746963; text-align: center; }.v-empty text { display: block; margin-top: 10rpx; }

/* v0.6.3 shared bottom navigation clearance, including the device safe area. */
page .status-shell,
page .brief-shell,
page .market-page,
page .fulfillment-shell,
page .me-shell,
page .detail-shell,
page .orders-shell,
page .project-shell,
page .projects-shell,
page .calendar-shell,
page .profile-shell,
page .dashboard-shell,
page .list-shell,
page .request-shell,
page .reviews-shell,
page .schedule-shell,
page .task-shell,
page .review-shell,
page .search-page,
page .v-page {
  padding-bottom: calc(192rpx + constant(safe-area-inset-bottom)) !important;
  padding-bottom: calc(192rpx + env(safe-area-inset-bottom)) !important;
}
