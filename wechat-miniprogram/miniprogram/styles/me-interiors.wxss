.mi-page { padding: var(--am-space-4) var(--am-page-gutter) calc(var(--am-space-6) + env(safe-area-inset-bottom)); }
.mi-stack { display: flex; flex-direction: column; gap: var(--am-space-3); }
.mi-card { background: var(--am-color-surface); border-radius: var(--am-radius-card); overflow: hidden; }
.mi-pad { padding: var(--am-space-4); display: flex; flex-direction: column; gap: var(--am-space-2); }
.mi-title { display: block; font-size: var(--am-type-section-title); font-weight: var(--am-weight-semibold); line-height: var(--am-line-section-title); }
.mi-copy { display: block; font-size: var(--am-type-body); line-height: var(--am-line-body); }
.mi-muted { display: block; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.mi-accent { color: var(--am-color-brand); }
page button.mi-row { display: flex; align-items: center; gap: var(--am-space-3); width: 100%; margin: var(--am-space-none); padding: var(--am-space-3) var(--am-space-4); min-height: var(--am-touch-min); border: var(--am-border-none); border-radius: var(--am-space-none); background: var(--am-color-transparent); text-align: left; color: var(--am-color-text); font-weight: var(--am-weight-regular); font-size: var(--am-type-label); line-height: var(--am-line-label); }
.mi-row + .mi-row { border-top: var(--am-border-control); }
.mi-row-copy { flex: 1; min-width: 0; }
.mi-chevron { flex: 0 0 var(--am-browse-arrow-size); width: var(--am-browse-arrow-size); height: var(--am-browse-arrow-size); }
.mi-split { display: flex; justify-content: space-between; align-items: center; gap: var(--am-space-3); }
.mi-break { overflow-wrap: anywhere; word-break: break-all; }
.mi-error { color: var(--am-color-danger); }
.mi-form { width: 100%; box-sizing: border-box; padding: var(--am-space-3); background: var(--am-color-control-surface); color: var(--am-color-text); border-radius: var(--am-radius-control); font-size: var(--am-type-body); line-height: var(--am-line-body); }
.mi-tabs { display: flex; gap: var(--am-space-2); }
page button.mi-tab { flex: 1; min-height: var(--am-touch-min); padding: var(--am-space-2); margin: var(--am-space-none); font-size: var(--am-type-label); line-height: var(--am-line-label); background: var(--am-color-surface); color: var(--am-color-text-secondary); }
page button.mi-tab-selected { color: var(--am-color-brand); background: var(--am-color-selected-surface); }

.mi-support-image { display: block; width: 100%; height: 100%; border-radius: var(--am-radius-control); }
.mi-media-row { display: flex; align-items: center; gap: var(--am-space-3); }
.mi-media-thumb, page button.mi-media-preview { display: flex; align-items: center; justify-content: center; flex: 0 0 var(--am-media-attachment-thumb); width: var(--am-media-attachment-thumb); height: var(--am-media-attachment-thumb); padding: var(--am-space-none); margin: var(--am-space-none); border-radius: var(--am-radius-control); background: var(--am-color-control-surface); }
page button.mi-media-remove { flex: 0 0 auto; width: auto; margin: var(--am-space-none); padding: var(--am-space-2); min-width: var(--am-touch-min); }
page button.mi-media-detail { width: 100%; padding: var(--am-space-none); margin: var(--am-space-none); text-align: left; background: var(--am-color-transparent); color: var(--am-color-text); border-radius: var(--am-space-none); }
