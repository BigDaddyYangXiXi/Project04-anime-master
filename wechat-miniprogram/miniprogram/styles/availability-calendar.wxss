.calendar-card { padding: var(--am-detail-card-padding); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); overflow: hidden; }
.week-row, .calendar-grid { display: flex; width: 100%; flex-wrap: wrap; }
.week-row { margin-bottom: 12rpx; }
.week-row text { width: 14.2857%; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); text-align: center; }
.calendar-grid button { position: relative; display: flex; width: 14.2857%; min-width: 14.2857%; max-width: 14.2857%; min-height: 86rpx; flex-direction: column; align-items: center; justify-content: center; border: 4rpx solid var(--am-color-surface); border-radius: 18rpx; color: var(--am-color-text-secondary); background: var(--am-color-control-surface); box-shadow: none; }
.calendar-grid button text { display: block; font-size: var(--am-type-micro); line-height: 28rpx; }
.calendar-grid button text + text { margin-top: 2rpx; font-size: var(--am-type-micro); line-height: var(--am-line-caption); }
.calendar-grid button.open { color: var(--am-color-success); background: var(--am-color-success-surface); font-weight: var(--am-weight-semibold); }
.calendar-grid button.full, .calendar-grid button.locked { color: var(--am-color-danger); background: var(--am-color-danger-surface); font-weight: var(--am-weight-semibold); opacity: 1; }
.calendar-grid button.unknown { color: var(--am-color-text-secondary); background: var(--am-color-control-surface); }
.calendar-grid button.past { color: var(--am-color-text-secondary); background: var(--am-color-canvas); opacity: .56; }
.calendar-grid button.selected { border-color: var(--am-color-on-brand); background: var(--am-color-selected-surface); box-shadow: var(--am-shadow-selected); color: var(--am-color-brand); }
.calendar-grid button.placeholder { background: transparent; }
.calendar-legend { display: flex; flex-wrap: wrap; gap: var(--am-space-3) var(--am-space-4); margin-top: var(--am-space-4); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.calendar-legend > view { display: flex; align-items: center; gap: var(--am-space-1); }
.calendar-dot { width: 18rpx; height: 18rpx; border-radius: 6rpx; background: var(--am-color-control-surface); }
.calendar-dot.open { background: var(--am-color-success); }
.calendar-dot.full, .calendar-dot.locked { background: var(--am-color-brand); }
.calendar-dot.unknown { border: 1rpx solid var(--am-color-border); background: var(--am-color-control-surface); }
