.orders-shell { padding: 28rpx 32rpx 180rpx; }
.page-intro { padding: 18rpx 8rpx 28rpx; }
.page-intro text { display: block; }
.page-intro text:first-child { color: #c6536b; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-intro text:nth-child(2) { margin-top: 8rpx; color: #221e1c; font-size: 48rpx; font-weight: 800; line-height: 62rpx; }
.page-intro text:last-child { margin-top: 8rpx; color: #6f625d; font-size: 24rpx; line-height: 1.6; }
.order-card { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin-bottom: 24rpx; padding: 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; box-sizing: border-box; text-align: left; box-shadow: 0 14rpx 44rpx rgba(49,36,56,.05); }
.order-card text { display: block; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.card-head > text:first-child { color: #2b2523; font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.status { width: fit-content; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; line-height: 30rpx; }
.status.amber { color: #9a6509; background: #fff2d7; }
.status.berry { color: #c6536b; background: #fff0f1; }
.status.green { color: #208a66; background: #e6f6ef; }
.card-copy { margin-top: 22rpx; color: #2b2523; font-size: 25rpx; font-weight: 700; line-height: 40rpx; }
.card-action { margin-top: 14rpx; color: #6f625d; font-size: 22rpx; line-height: 34rpx; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; padding: 48rpx 32rpx; border: 1rpx solid #eee3df; border-radius: 38rpx; background: #fff; text-align: center; }
.empty-state text { display: block; }
.empty-state text:first-child { color: #2b2523; font-size: 30rpx; font-weight: 800; line-height: 42rpx; }
.empty-state text:nth-child(2) { color: #6f625d; font-size: 24rpx; line-height: 40rpx; }
.empty-state button { display: flex; min-width: 320rpx; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 12rpx; padding: 20rpx 32rpx; border: 2rpx solid rgba(255,255,255,.92); border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#f0787e,#ee8f88 52%,#e77c90); box-shadow: none; font-size: 28rpx; font-weight: 700; line-height: 40rpx; text-align: center; }
