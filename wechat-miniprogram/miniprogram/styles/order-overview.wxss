.orders-shell { padding: 28rpx 32rpx 180rpx; }
.page-intro { padding: 18rpx 8rpx 28rpx; }
.page-intro text { display: block; }
.page-intro text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); letter-spacing: 3rpx; }
.page-intro text:nth-child(2) { margin-top: var(--am-space-1); color: var(--am-color-text); font-size: var(--am-type-page-title); font-weight: var(--am-weight-semibold); line-height: 62rpx; }
.page-intro text:last-child { margin-top: var(--am-space-1); color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 1.6; }
.order-card { display: block; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin-bottom: var(--am-space-3); padding: var(--am-space-4); border: 1rpx solid var(--am-color-border); border-radius: var(--am-radius-card); background: var(--am-color-surface); box-sizing: border-box; text-align: left; box-shadow: var(--am-shadow-none); }
.order-card text { display: block; }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.card-head > text:first-child { color: var(--am-color-text); font-size: 30rpx; font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.status { width: fit-content; padding: 8rpx 14rpx; border-radius: 999rpx; font-size: var(--am-type-micro); font-weight: var(--am-weight-semibold); line-height: 30rpx; }
.status.amber { color: var(--am-color-warning); background: var(--am-color-warning-surface); }
.status.berry { color: var(--am-color-brand); background: var(--am-color-selected-surface); }
.status.green { color: var(--am-color-success); background: var(--am-color-success-surface); }
.card-copy { margin-top: 22rpx; color: var(--am-color-text); font-size: 25rpx; font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); }
.card-action { margin-top: 14rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 34rpx; }
.empty-state { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; padding: var(--am-space-6) var(--am-space-4); border: 1rpx solid var(--am-color-border); border-radius: 38rpx; background: var(--am-color-surface); text-align: center; }
.empty-state text { display: block; }
.empty-state text:first-child { color: var(--am-color-text); font-size: 30rpx; font-weight: var(--am-weight-semibold); line-height: 42rpx; }
.empty-state text:nth-child(2) { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-label); }
.empty-state button { display: flex; min-width: 320rpx; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 12rpx; padding: 20rpx 32rpx; border: 2rpx solid var(--am-color-border); border-radius: 28rpx; color: var(--am-color-on-brand); background: var(--am-color-brand); box-shadow: none; font-size: var(--am-type-body); font-weight: var(--am-weight-semibold); line-height: var(--am-line-label); text-align: center; }
