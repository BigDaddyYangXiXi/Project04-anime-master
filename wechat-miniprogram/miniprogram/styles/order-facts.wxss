.section-title.order-fact-heading, .summary-meta.order-fact-heading { flex-direction: column; align-items: stretch; gap: var(--am-space-1); }
.order-fact-heading > text { min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
.order-fact-stack { margin-top: var(--am-space-4); border-top: var(--am-work-rule); }
.order-fact-item { display: flex; padding: var(--am-space-3) var(--am-space-none); }
.order-fact-item+.order-fact-item { border-top: var(--am-work-rule); }
.order-fact-copy { width: 100%; min-width: 0; }
.order-fact-copy text { display: block; }
.order-fact-copy>text:first-child { font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); color: var(--am-color-text-secondary); font-weight: var(--am-weight-regular); }
.order-fact-copy>text:not(:first-child), .order-fact-schedule text { margin-top: var(--am-space-1); color: var(--am-color-text); font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); font-weight: var(--am-weight-regular); }
