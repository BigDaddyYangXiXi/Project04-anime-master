.list-shell { padding: var(--am-space-6) var(--am-space-4) calc(var(--am-nav-bottom-content) + var(--am-space-6) + env(safe-area-inset-bottom)); }
.flow-tabs { display: flex; gap: var(--am-space-2); margin-bottom: var(--am-space-4); }
.flow-tabs button { flex: 1; min-width: 0; min-height: var(--am-touch-min); display: flex; align-items: center; justify-content: center; padding: var(--am-space-2); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-control-surface); color: var(--am-browse-control-ink); font-size: var(--am-type-label); line-height: var(--am-booking-line-primary); font-weight: var(--am-weight-regular); }
.flow-tabs button.active { color: var(--am-color-brand); border-color: var(--am-color-brand); background: var(--am-color-selected-surface); font-weight: var(--am-weight-medium); }
.order-list { display: flex; flex-direction: column; gap: var(--am-space-3); }
button.order-row { display: block; width: 100%; min-width: 100%; max-width: 100%; padding: var(--am-space-4) var(--am-space-3); border: var(--am-work-rule); border-radius: var(--am-radius-control); background: var(--am-color-surface); text-align: left; font-weight: var(--am-weight-regular); }
.order-row text { display: block; }
.row-head { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); }
.status { font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); font-weight: var(--am-weight-medium); }
.status.amber { color: var(--am-color-warning); }
.status.berry { color: var(--am-color-brand); }
.status.green { color: var(--am-color-success); }
.row-head>text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.order-title { margin-top: var(--am-space-3); font-size: var(--am-type-section-title); line-height: var(--am-line-section-title); font-weight: var(--am-weight-semibold); }
.identity-line { margin-top: var(--am-work-space-six); color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); overflow-wrap: anywhere; }
.where-when { margin-top: var(--am-space-4); padding-top: var(--am-space-3); border-top: var(--am-work-rule); display: flex; flex-direction: column; gap: var(--am-space-1); }
.where-when text { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); }
.row-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-3); margin-top: var(--am-space-3); }
.row-foot>text:last-child { font-size: var(--am-booking-type-secondary); color: var(--am-color-text-secondary); line-height: var(--am-line-caption); }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--am-space-3); padding: var(--am-space-8) var(--am-space-4); text-align: center; }
.empty-state text:first-child { font-size: var(--am-type-section-title); line-height: var(--am-line-section-title); font-weight: var(--am-weight-semibold); }
.empty-state text:last-child { color: var(--am-color-text-secondary); font-size: var(--am-booking-type-secondary); line-height: var(--am-line-caption); }
.empty-retry { margin-top: var(--am-space-4); }
