@import "../../styles/design-tokens.wxss";
@import "../../styles/actions.wxss";
.brand-success-card { border: 1rpx solid var(--am-color-border); border-radius: 36rpx; background: var(--am-color-canvas); overflow: hidden; }
.mascot-stage { position: relative; height: 286rpx; overflow: hidden; background: #ffded0; }
.mascot-image { width: 100%; height: 100%; }
.stage-label { position: absolute; top: 22rpx; left: 24rpx; padding: var(--am-space-1) var(--am-space-2); border: 2rpx solid var(--am-color-border); border-radius: 999rpx; color: var(--am-color-text); background: var(--am-color-surface); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 30rpx; }
.success-content { padding: 30rpx 30rpx 32rpx; text-align: center; }
.success-content text { display: block; }
.success-title { color: var(--am-color-text); font-size: 34rpx; font-weight: var(--am-weight-semibold); line-height: 46rpx; }
.success-copy { margin-top: 10rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 38rpx; }
.success-score { margin-top: 18rpx; color: var(--am-color-price); font-size: 42rpx; line-height: 52rpx; letter-spacing: 5rpx; }
.success-detail { margin-top: 12rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: var(--am-line-caption); }
.success-reply { margin-top: 22rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--am-color-border); border-radius: 20rpx; background: var(--am-color-surface); text-align: left; }
.success-reply text:first-child { color: var(--am-color-brand); font-size: var(--am-type-caption); font-weight: var(--am-weight-semibold); line-height: 30rpx; }
.success-reply text:last-child { margin-top: 6rpx; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: 35rpx; }
.success-action { display: flex; width: 100%;  margin-top: var(--am-space-3); align-items: center; justify-content: center;         }
