@import "../../styles/design-tokens.wxss";
@import "../../styles/actions.wxss";
:host { display: block; }
.rating-stars { display: flex; align-items: center; gap: var(--am-space-2); }
.stars { color: var(--am-color-price); font-size: var(--am-type-body); letter-spacing: 4rpx; }
.rating-stars text:last-child { font-size: var(--am-type-micro); line-height: 32rpx; font-weight: var(--am-weight-medium); }
