@import "../../styles/media-placeholder.wxss";
@import "../../styles/design-tokens.wxss";
@import "../../styles/actions.wxss";
:host { display: block; min-width: 0; }
.work-card { display: block; width: 100%; min-width: 0; margin: var(--am-space-none); padding: var(--am-space-none); overflow: visible; border: var(--am-border-none); border-radius: var(--am-space-none); color: var(--am-color-text); background: var(--am-color-transparent); text-align: left; line-height: var(--am-line-label); box-shadow: var(--am-shadow-none); }
.work-card-pressed { opacity: .76; }
.work-visual { position: relative; overflow: hidden; border-radius:var(--am-radius-card); background: var(--am-color-control-surface); }
.work-visual image { display:block; width:100%; height:auto; }
.work-visual .am-media-unavailable { min-height:var(--am-feed-cover-height); }

.work-info { display: flex; flex-direction: column; gap: var(--am-space-1); padding: var(--am-space-2) var(--am-space-none) var(--am-space-3); }
.work-info > text { display: block; }
.work-title { overflow: hidden; color: var(--am-color-text); font-size: var(--am-feed-title-size); line-height: var(--am-line-body); font-weight: var(--am-weight-semibold); text-overflow: ellipsis; white-space: nowrap; }

.work-author { position: relative; display: flex; min-width: 0; align-items: flex-end; gap: var(--am-space-1); margin-top:var(--am-space-none); align-items:center; }
.work-author text { min-width: 0; flex: 1; overflow: hidden; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); font-weight: var(--am-weight-regular); text-overflow: ellipsis; white-space: nowrap; }
.avatar { display: flex; width: var(--am-feed-avatar-size); height: var(--am-feed-avatar-size); flex: 0 0 var(--am-feed-avatar-size); align-items: center; justify-content: center; border: var(--am-border-control); border-radius: var(--am-radius-avatar); color: var(--am-color-text); background: var(--am-color-control-surface); font-size: var(--am-type-label); }
.work-meta { display: flex; min-width: 0; align-items: baseline; justify-content: space-between; gap: var(--am-space-1); }


.work-price { display: block; color: var(--am-color-price); font-size: var(--am-type-section-title); line-height: var(--am-line-section-title); font-weight: var(--am-weight-semibold); }

.work-stat { flex: 0 0 auto; color: var(--am-color-text-secondary); font-size: var(--am-type-micro); line-height: var(--am-line-caption); }

@import "../../styles/money.wxss";
