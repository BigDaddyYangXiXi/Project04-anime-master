<navigator
  class="work-card"
  url="/pages/work-detail/index?id={{workIdParam}}{{workOwnerQuery}}&source={{source}}{{workspace === 'provider' ? '&workspace=provider' : ''}}{{preview ? '&preview=' + preview : ''}}"
  open-type="navigate"
  hover-class="work-card-pressed"
  aria-label="查看作品：{{work.title}}"
>
  <view class="work-visual">
    <image wx:if="{{coverImage}}" src="{{coverImage}}" mode="widthFix" lazy-load="{{true}}"/>
    <view wx:else class="am-media-unavailable">图片暂不可用</view>
  </view>
  <view class="work-info">
    <text class="work-title">{{work.title}}</text>
    <view class="work-author"><image wx:if="{{work.provider.avatar || work.provider.avatarUrl}}" class="avatar" src="{{work.provider.avatar || work.provider.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}"/><view wx:else class="avatar">{{work.provider.initial}}</view><text>{{work.provider.name}}</text></view>
    <view class="work-meta"><text class="work-price am-money am-money-list">{{work.priceText}}</text><text wx:if="{{referenceText}}" class="work-stat">{{referenceText}}</text></view>
  </view>
</navigator>
