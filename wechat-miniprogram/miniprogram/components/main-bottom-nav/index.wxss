@import "../../styles/design-tokens.wxss";
@import "../../styles/actions.wxss";
:host { display: block; }
.main-bottom-nav { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; height: calc(156rpx + constant(safe-area-inset-bottom)); height: calc(156rpx + env(safe-area-inset-bottom)); padding: 10rpx 16rpx calc(14rpx + constant(safe-area-inset-bottom)); padding: 10rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--am-color-border); background: var(--am-color-surface); box-shadow: var(--am-shadow-none); box-sizing: border-box; pointer-events: auto; }
.nav-item { display: flex; width: 25%; min-width: 0; min-height: 88rpx; margin: var(--am-space-none); flex: 1 1 25%; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; padding: var(--am-space-none); border: 0; border-radius: 24rpx; color: var(--am-color-text-secondary); background: transparent; font-size: var(--am-type-micro); line-height: 32rpx; font-weight: var(--am-weight-medium); }
.nav-item::after { border: 0; }
.nav-art { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--am-color-transparent); transition: transform .16s ease, background-color .16s ease, box-shadow .16s ease; }
.nav-art image { display: block; width: var(--am-nav-icon-size); height: var(--am-nav-icon-size); }
.nav-item.active { color: var(--am-color-brand); font-weight: var(--am-weight-semibold); }
.nav-item.active .nav-art { background: var(--am-color-transparent); box-shadow: var(--am-shadow-none); }
.nav-item-pressed { opacity: .72; }
