@import "../../styles/design-tokens.wxss";
@import "../../styles/actions.wxss";
:host { display: block; }
.availability-strip { padding: 20rpx 0; border-top: 1rpx solid var(--am-color-border); border-bottom: 1rpx solid var(--am-color-border); }
.availability-strip.with-top-gap { margin-top: 20rpx; }
.availability-days { display: grid; grid-template-columns: repeat(8,minmax(0,1fr)); gap: 6rpx; }
.availability-day { display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 6rpx; padding: 12rpx 1rpx; border-radius: 16rpx; background: var(--am-color-control-surface); }
.availability-day text:first-child { color: var(--am-color-text-secondary); font-size: var(--am-type-caption); line-height: 24rpx; }
.availability-day text:nth-child(2) { font-size: var(--am-type-caption); line-height: 24rpx; font-weight: var(--am-weight-semibold); }
.availability-icon { display: inline-block; width: 20rpx; height: 20rpx; flex: 0 0 20rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.availability-icon.open-all, .open-all .availability-icon { color: var(--am-color-text-secondary); }
.availability-icon.full, .full .availability-icon { color: var(--am-color-text-secondary); background: currentColor; }
.availability-icon.unknown, .unknown .availability-icon { color: var(--am-color-text-secondary); border-style: dashed; }
.availability-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 10rpx 20rpx; margin-top: var(--am-space-2); color: var(--am-color-text-secondary); }
.availability-legend > view { display: flex; align-items: center; gap: var(--am-space-1); }
.availability-legend text { font-size: var(--am-type-caption); line-height: 32rpx; }
.availability-legend .availability-icon { width: 16rpx; height: 16rpx; flex-basis: 16rpx; border-width: 2rpx; }
